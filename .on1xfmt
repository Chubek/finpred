# GNU C-inspired: two-space indentation, separate brace lines, and
# a preferred 80-column width. Separate top-level blocks with a blank line.
# The formatter does not support GNU's extra indent for nested braces.
# Use bin/format-on1x.py for leading record commas and nested call wrapping.
width = 80
tabstop = 2
algorithm = fits
brace_style = allman
top_level_block_newlines = 2
