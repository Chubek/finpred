# Independent compiled consumer: neither the CLI nor the pricing store is linked.
import plugins.dragnet.guest_nights as Guest;
import core.format as F;
import forecast_baselines.evaluation as Evaluation;
import forecast_baselines.holdout as Holdout;
import forecast_baselines.model as Model;
import forecast_baselines.score as Score;
import sdk.callable as SDK;
import std.io.TextIO as IO;
import std.os.CommandLine as Env;
fn env(key: string) -> string
{
  return Env.basis_command_line_get_env(key);
}

fn code() -> string
{
  return Model.digest(env("CODE_BYTES"));
}

fn lookup(key: string) -> SDK.Descriptor
{
  return Model.descriptor(key, code());
}

fn field(index: i64, key: string) -> sexpr
{
  let n = F.num(index);
  return sx_string(env("ENTRY_${n}_$key"));
}

fn holdout_entry(index: i64) -> Holdout.Entry
{
  let roots = record < Evaluation.Roots >
  {
    training_snapshot: field(index,
      "TRAIN_PARENT"), actuals_snapshot: field(index,
      "ACTUAL_PARENT"), request: field(index,
      "REQUEST_PARENT"), forecast: field(index,
      "FORECAST_PARENT")
  };
  let frozen = record < Evaluation.Frozen >
  {
    training_snapshot: field(index,
      "TRAIN_RAW"), actuals_snapshot: field(index,
      "ACTUAL_RAW"), request: field(index,
      "REQUEST"), forecast: field(index,
      "FROZEN_FORECAST")
  };
  let archive = record < Evaluation.Archive >
  {
    id: field(index,
      "EVALUATION_ID"), manifest: field(index,
      "MANIFEST"), score: field(index,
      "SCORE")
  };
  return record < Holdout.Entry >
  {
    training_cutoff: field(index,
      "TRAIN_CUTOFF"), roots: roots, frozen: frozen, archive: archive
  };
}

fn main() -> i64
{
  let task = env("CASE");
  if task == "digest"
  {
    println(Model.digest(env("BYTES")));
    return 0;
  }
  if task == "holdout"
  {
    let host = record < Evaluation.Linked >
    {
      model_code: sx_string(code()), scoring_code: sx_string(Model.digest(env("SCORING_CODE_BYTES")))
    };
    let plan = record < Holdout.Plan >
    {
      model: sx_string(env("MODEL")), model_code: sx_string(env("MODEL_CODE")), scoring_code: sx_string(env("SCORING_CODE")), validation_through: sx_string(env("VALIDATION_THROUGH")), selection_frozen_at: sx_string(env("SELECTION_FROZEN_AT")), first_target: sx_string(env("FIRST_TARGET")), last_target: sx_string(env("LAST_TARGET")), scoring_cutoff: sx_string(env("SCORE_CUTOFF"))
    };
    let report = Holdout.aggregate(host, plan, holdout_entry);
    if report["status"] != 0
    {
      if sx_kind(report["id"]) != 0 || sx_kind(report["bytes"]) != 0
      {
        return 69;
      }
      return 70 + report["status"];
    }
    println(sx_text(report["id"]));
    IO.basis_text_io_print(sx_text(report["bytes"]));
    return 0;
  }
  let model = env("MODEL");
  let training_cutoff = env("TRAIN_CUTOFF");
  let raw = env("TRAIN_RAW");
  let parent = env("TRAIN_PARENT");
  if task == "forecast"
  {
    let training = Guest.project(raw, parent, training_cutoff);
    if training["status"] != 0
    {
      return 12;
    }
    let descriptor = SDK.resolve(model, "analysis", lookup);
    if ! descriptor["enabled"]
    {
      return 11;
    }
    let inputs = sx_cons(SDK.value_entry(training["state"],
      sx_text(training["bytes"])),
      sx_cons(SDK.value_entry(1,
      env("REQUEST")),
      sx_nil()));
    let request = record < SDK.Request >
    {
      inputs: inputs, cutoff: sx_string(training_cutoff), work: 1
    };
    let result = SDK.invoke(descriptor["pin"],
      "analysis",
      request,
      lookup,
      Model.call);
    if result["status"] != 0
    {
      return 13;
    }
    IO.basis_text_io_print(sx_text(result["bytes"]));
    return 0;
  }
  if task == "evaluate" || task == "replay"
  {
    let host = record < Evaluation.Linked >
    {
      model_code: sx_string(code()), scoring_code: sx_string(Model.digest(env("SCORING_CODE_BYTES")))
    };
    let selection = record < Evaluation.Selection >
    {
      model: sx_string(model), model_code: sx_string(env("MODEL_CODE")), scoring_code: sx_string(env("SCORING_CODE")), training_cutoff: sx_string(training_cutoff), scoring_cutoff: sx_string(env("SCORE_CUTOFF"))
    };
    let roots = record < Evaluation.Roots >
    {
      training_snapshot: sx_string(parent), actuals_snapshot: sx_string(env("ACTUAL_PARENT")), request: sx_string(env("REQUEST_PARENT")), forecast: sx_string(env("FORECAST_PARENT"))
    };
    let frozen = record < Evaluation.Frozen >
    {
      training_snapshot: sx_string(raw), actuals_snapshot: sx_string(env("ACTUAL_RAW")), request: sx_string(env("REQUEST")), forecast: sx_string(env("FROZEN_FORECAST"))
    };
    let saved = record < Evaluation.Archive >
    {
      id: sx_string(env("EVALUATION_ID")), manifest: sx_string(env("MANIFEST")), score: sx_string(env("SCORE"))
    };
    var run = Evaluation.failure(1);
    if task == "evaluate"
    {
      run = Evaluation.evaluate(host, selection, roots, frozen);
    }
    else
    {
      run = Evaluation.replay(host, selection, roots, frozen, saved);
    }
    if run["status"] != 0
    {
      if sx_kind(run["id"]) != 0 || sx_kind(run["manifest"]) != 0 || sx_kind(run["score"]) != 0
      {
        return 49;
      }
      return 50 + run["status"];
    }
    println(sx_text(run["id"]));
    IO.basis_text_io_print(sx_text(run["manifest"]));
    IO.basis_text_io_print(sx_text(run["score"]));
    return 0;
  }
  if task != "score"
  {
    return 10;
  }
  let result = Score.evaluate(model,
    raw,
    parent,
    env("REQUEST"),
    env("FROZEN_FORECAST"),
    env("ACTUAL_RAW"),
    env("ACTUAL_PARENT"),
    training_cutoff,
    env("SCORE_CUTOFF"),
    code());
  if result["status"] != 0
  {
    return 30 + result["status"];
  }
  IO.basis_text_io_print(sx_text(result["bytes"]));
  return 0;
}
