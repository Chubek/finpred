import plugins.yieldcraft.entry as Yieldcraft;
import core.contracts as C;
import core.serialize as JSON;
import std.os.CommandLine as Env;
import std.io.TextIO as IO;
# Test host: provenance is taken from the frozen fixture by the harness.
# Only the host serializes the returned On1x recommendation.
fn main() -> i64
{
  let scenario = IO.basis_text_io_input_all(Env.basis_command_line_get_env("YC_SCENARIO"));
  let result = Yieldcraft.recommend(
    Env.basis_command_line_get_env("YC_MODE"),
    scenario,
    IO.basis_text_io_input_all(Env.basis_command_line_get_env("YC_OFFERS")),
    IO.basis_text_io_input_all(Env.basis_command_line_get_env("YC_VALUATION"))
  );
  IO.basis_text_io_print(JSON.recommendation(
    C.scenario_csv(scenario),
    result,
    Env.basis_command_line_get_env("YC_RUN_ID"),
    Env.basis_command_line_get_env("YC_SD"),
    Env.basis_command_line_get_env("YC_OD"),
    Env.basis_command_line_get_env("YC_VD"),
    Env.basis_command_line_get_env("YC_TD"),
    "yieldcraft.percentile@1"
  ));
  return 0;
}
