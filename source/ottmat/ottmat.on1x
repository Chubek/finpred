# Deliberately narrow v1 Ottmat frontend: a line-oriented typed declaration.
# It is NOT a general-purpose scripting interpreter.
import core.csv as CSV;
import automat.graph as Graph;
fn checked_strategy(source: string) -> bool
{
  if CSV.rows(source) != 8 { return false; }
  if CSV.line(source,0) != "ottmat 1" { return false; }
  for id in 0 .. 7
  {
    let n = Graph.node(id);
    let declaration = text_concat(sx_text(n["family"]),text_concat(" ",sx_text(n["produces"])));
    if CSV.line(source,id+1) != declaration { return false; }
  }
  return Graph.validate("recommendation");
}
