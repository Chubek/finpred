# Operator workflow for frozen guest-night forecasts. Each returned ID is the
# hash of a commit record in the forecast store, after its parents exist.
import cli.forecast_catalog as Catalog;
import cli.forecast_audit as Audit;
import cli.forecast_identity as Identity;
import core.csv as CSV;
import forecast_baselines.evaluation as Eval;
import forecast_baselines.holdout as Hold;
import forecast_baselines.model as Model;
import sdk.callable as SDK;
import store.artifacts as Store;
import std.io.TextIO as IO;
import std.environ as Env;
record Issuance
{
  manifest: sexpr, model: sexpr, cutoff: sexpr, request: sexpr, forecast: sexpr, training: Catalog.Release, target: i64
}

record Scoring
{
  manifest: sexpr, model: sexpr, cutoff: sexpr, entry: Hold.Entry
}

record Report
{
  manifest: sexpr, bytes: sexpr
}

fn linked() -> Eval.Linked
{
  let code = sx_string(Model.digest(Identity.source_subject()));
  return record < Eval.Linked >
  {
    model_code: code, scoring_code: code
  };
}

fn calculate_issue(home: string,
  catalog: string,
  model: string,
  cutoff: string,
  request: string) -> Issuance
{
  let settings = Model.spec(request, cutoff);
  let target = settings["month"];
  if target < 0 || ! Model.known(model)
  {
    tool_fail("forecast: invalid model, request or training cutoff");
  }
  # Windows of the two immutable model versions. Keep the historical model
  # source subject unchanged when adding the operator's selection policy.
  var first = target - 12;
  var last = first;
  if model == Model.moving_average()
  {
    first = target - 4;
    last = target - 2;
  }
  let training = Catalog.select(home, catalog, cutoff, first, last);
  let projection = training["projection"];
  let descriptor = Model.descriptor(model, sx_text(linked()["model_code"]));
  let inputs = sx_cons(SDK.value_entry(projection["state"],
    sx_text(projection["bytes"])),
    sx_cons(SDK.value_entry(1,
    request),
    sx_nil()));
  let call = record < SDK.Request >
  {
    inputs: inputs, cutoff: sx_string(cutoff), work: 1
  };
  let result = Model.call(descriptor["pin"], call);
  if result["status"] != 0 || ! SDK.valid_output(descriptor["output"],
    result["state"],
    result["bytes"])
  {
    tool_fail("forecast: model rejected request");
  }
  let snapshot = sx_text(training["id"]);
  let request_id = Store.digest(request);
  let forecast_id = Store.digest(sx_text(result["bytes"]));
  let manifest = "forecast-issue@1,$catalog,$model,$cutoff,$request_id,$snapshot,$forecast_id\n";
  return record < Issuance >
  {
    manifest: sx_string(manifest), model: sx_string(model), cutoff: sx_string(cutoff), request: sx_string(request), forecast: result["bytes"], training: training, target: target
  };
}

fn publish_issue(home: string, issuance: Issuance) -> string
{
  Store.put(home, sx_text(issuance["request"]));
  Store.put(home, sx_text(issuance["forecast"]));
  return Store.put(home, sx_text(issuance["manifest"]));
}

fn checked_record(bytes: string, kind: string, columns: i64) -> string
{
  if text_len(bytes) > 1024 || CSV.rows(bytes) != 1
  {
    tool_fail("forecast: malformed archive record");
  }
  let row = CSV.line(bytes, 0);
  if CSV.columns(row) != columns || CSV.field(row, 0) != kind
  {
    tool_fail("forecast: unexpected archive record type");
  }
  return row;
}

fn replay_issue(home: string, id: string) -> Issuance
{
  let bytes = Store.fetch(home, id);
  let row = checked_record(bytes, "forecast-issue@1", 7);
  let request = Store.fetch(home, CSV.field(row, 4));
  let archived = Store.fetch(home, CSV.field(row, 6));
  let result = calculate_issue(home,
    CSV.field(row,
    1),
    CSV.field(row,
    2),
    CSV.field(row,
    3),
    request);
  if sx_text(result["manifest"]) != bytes || sx_text(result["forecast"]) != archived
  {
    tool_fail("forecast: issuance replay divergence");
  }
  return result;
}

fn calculate_score(home: string,
  issued_id: string,
  catalog: string,
  cutoff: string) -> Scoring
{
  let issuance = replay_issue(home, issued_id);
  let target = issuance["target"];
  let actual = Catalog.select(home, catalog, cutoff, target, target);
  let training = issuance["training"];
  let frozen = record < Eval.Frozen >
  {
    training_snapshot: training["raw"], actuals_snapshot: actual["raw"], request: issuance["request"], forecast: issuance["forecast"]
  };
  let training_id = sx_text(training["id"]);
  let actual_id = sx_text(actual["id"]);
  let roots = record < Eval.Roots >
  {
    training_snapshot: sx_string("blake3:$training_id"), actuals_snapshot: sx_string("blake3:$actual_id"), request: sx_string(Model.digest(sx_text(frozen["request"]))), forecast: sx_string(Model.digest(sx_text(frozen["forecast"])))
  };
  let host = linked();
  let selection = record < Eval.Selection >
  {
    model: issuance["model"], model_code: host["model_code"], scoring_code: host["scoring_code"], training_cutoff: issuance["cutoff"], scoring_cutoff: sx_string(cutoff)
  };
  let result = Eval.evaluate(host, selection, roots, frozen);
  if result["status"] != 0
  {
    tool_fail("forecast: evaluation rejected the evidence or chronology");
  }
  let archive = record < Eval.Archive >
  {
    id: result["id"], manifest: result["manifest"], score: result["score"]
  };
  let entry = record < Hold.Entry >
  {
    training_cutoff: issuance["cutoff"], roots: roots, frozen: frozen, archive: archive
  };
  let evaluation = text_slice(sx_text(archive["id"]), 7, 71);
  let score = Store.digest(sx_text(archive["score"]));
  let manifest = "forecast-score@1,$issued_id,$catalog,$cutoff,$evaluation,$score\n";
  return record < Scoring >
  {
    manifest: sx_string(manifest), model: issuance["model"], cutoff: sx_string(cutoff), entry: entry
  };
}

fn publish_score(home: string, scoring: Scoring) -> string
{
  let archive = scoring["entry"]["archive"];
  Store.put(home, sx_text(archive["score"]));
  Store.put(home, sx_text(archive["manifest"]));
  return Store.put(home, sx_text(scoring["manifest"]));
}

fn replay_score(home: string, id: string) -> Scoring
{
  let bytes = Store.fetch(home, id);
  let row = checked_record(bytes, "forecast-score@1", 6);
  let archived_evaluation = Store.fetch(home, CSV.field(row, 4));
  let archived_score = Store.fetch(home, CSV.field(row, 5));
  let result = calculate_score(home,
    CSV.field(row,
    1),
    CSV.field(row,
    2),
    CSV.field(row,
    3));
  let archive = result["entry"]["archive"];
  if sx_text(result["manifest"]) != bytes || sx_text(archive["manifest"]) != archived_evaluation || sx_text(archive["score"]) != archived_score
  {
    tool_fail("forecast: evaluation replay divergence");
  }
  return result;
}

fn calculate_holdout(home: string, plan_bytes: string) -> Report
{
  if text_len(plan_bytes) > 2048
  {
    tool_fail("forecast: holdout plan exceeds size profile");
  }
  let rows = CSV.rows(plan_bytes);
  if rows < 2 || rows > 25
  {
    tool_fail("forecast: invalid holdout plan length");
  }
  let header = CSV.line(plan_bytes, 0);
  if CSV.columns(header) != 6
  {
    tool_fail("forecast: invalid holdout plan header");
  }
  let host = linked();
  let model = CSV.field(header, 0);
  let cutoff = CSV.field(header, 5);
  let plan = record < Hold.Plan >
  {
    model: sx_string(model), model_code: host["model_code"], scoring_code: host["scoring_code"], validation_through: sx_string(CSV.field(header,
      1)), selection_frozen_at: sx_string(CSV.field(header,
      2)), first_target: sx_string(CSV.field(header,
      3)), last_target: sx_string(CSV.field(header,
      4)), scoring_cutoff: sx_string(cutoff)
  };
  let first = Model.month(CSV.field(header, 3));
  let last = Model.month(CSV.field(header, 4));
  if first < 0 || last < first || rows != last - first + 2
  {
    tool_fail("forecast: incomplete holdout window");
  }
  let entry_at = fn(offset: i64) -> Hold.Entry
  {
    let run = replay_score(home, CSV.line(plan_bytes, offset + 1));
    if sx_text(run["model"]) != model || sx_text(run["cutoff"]) != cutoff
    {
      tool_fail("forecast: holdout evaluation model or cutoff mismatch");
    }
    return run["entry"];
  };
  let result = Hold.aggregate(host, plan, entry_at);
  if result["status"] != 0
  {
    tool_fail("forecast: holdout rejected the plan or evaluations");
  }
  let plan_id = Store.digest(plan_bytes);
  let report_id = text_slice(sx_text(result["id"]), 7, 71);
  return record < Report >
  {
    manifest: sx_string("forecast-holdout@1,$plan_id,$report_id\n"), bytes: result["bytes"]
  };
}

fn replay(home: string, id: string) -> string
{
  let manifest = Store.fetch(home, id);
  if text_len(manifest) > 1024
  {
    tool_fail("forecast: malformed archive record");
  }
  let kind = CSV.field(CSV.line(manifest, 0), 0);
  if kind == "forecast-issue@1"
  {
    return sx_text(replay_issue(home, id)["forecast"]);
  }
  if kind == "forecast-score@1"
  {
    return sx_text(replay_score(home, id)["entry"]["archive"]["score"]);
  }
  let row = checked_record(manifest, "forecast-holdout@1", 3);
  let archived = Store.fetch(home, CSV.field(row, 2));
  let report = calculate_holdout(home, Store.fetch(home, CSV.field(row, 1)));
  if sx_text(report["manifest"]) != manifest || sx_text(report["bytes"]) != archived
  {
    tool_fail("forecast: holdout replay divergence");
  }
  return archived;
}

fn env(key: string) -> string
{
  let(found, value) = Env.getenv(key);
  if ! found
  {
    return "";
  }
  return value;
}

fn forecast_home() -> string
{
  let configured = env("FINPRED_FORECAST_HOME");
  if configured == ""
  {
    return ".finpred-forecast";
  }
  return configured;
}

fn entry(mode: string) -> i64
{
  let home = forecast_home();
  let input = env("FINPRED_FORECAST_INPUT");
  let catalog = env("FINPRED_FORECAST_CATALOG");
  let cutoff = env("FINPRED_FORECAST_CUTOFF");
  if mode == "forecast-import"
  {
    println(Catalog.import_snapshot(home, input));
    return 0;
  }
  if mode == "forecast-catalog"
  {
    println(Catalog.save(home, input));
    return 0;
  }
  if mode == "forecast-issue"
  {
    println(publish_issue(home,
      calculate_issue(home,
      catalog,
      env("FINPRED_FORECAST_MODEL"),
      cutoff,
      Catalog.input(input,
      128))));
    return 0;
  }
  if mode == "forecast-score"
  {
    println(publish_score(home,
      calculate_score(home,
      input,
      catalog,
      cutoff)));
    return 0;
  }
  if mode == "forecast-holdout"
  {
    let plan = Catalog.input(input, 2048);
    let report = calculate_holdout(home, plan);
    Store.put(home, plan);
    Store.put(home, sx_text(report["bytes"]));
    println(Store.put(home, sx_text(report["manifest"])));
    return 0;
  }
  if mode == "forecast-audit"
  {
    let index = Catalog.input(input, Audit.max_bytes());
    let verify_id = fn(id: string) -> string
    {
      return replay(home, id);
    };
    IO.basis_text_io_print(Audit.verify(index, verify_id));
    return 0;
  }
  if mode == "forecast-replay"
  {
    IO.basis_text_io_print(replay(home, input));
    return 0;
  }
  tool_fail("forecast: unsupported command");
  return 1;
}
