# I/O adapter for the pure own-demand strategy. The legacy market-positioning
# run formats and pricing.recommendation@1 remain byte-for-byte separate.
import core.contracts as C;
import core.csv as CSV;
import core.format as F;
import cli.run_formats as Formats;
import store.artifacts as Store;
import std.io.TextIO as IO;
import std.os.OS_FileSys as FS;
import yieldcraft.contribution as Policy;
import yieldcraft.declaration as Declaration;
import poindexter.sheet as Sheet;

fn version() -> string { return "finpred-run@3"; }

fn demand_source(path:string) -> string
{
  if path == "" || !FS.basis_fs_exists(path)
  { tool_fail("yieldcraft: insufficient_demand_evidence; supply a demand snapshot with --demand or FINPRED_DEMAND"); }
  let size = FS.basis_fs_file_size(path);
  if size < 1 || size > Policy.bytes_limit() || FS.basis_fs_is_dir(path)
  { tool_fail("yieldcraft demand: input outside bounded text profile"); }
  let raw = IO.basis_text_io_input_all(path);
  if text_len(raw) != size { tool_fail("yieldcraft demand: incomplete text input"); }
  return raw;
}

fn lineage(sd:string, dd:string, vd:string, pd:string) -> string
{
  let strategy = Policy.version();
  let graph = Declaration.graph_version();
  return "finpred-run-lineage@3\nstrategy=$strategy\ngraph=$graph\nmode=recommendation\nraw_scenario=$sd\nraw_demand=$dd\nraw_valuation=$vd\nraw_strategy=$pd\n";
}

fn manifest(sd:string, dd:string, vd:string, pd:string, rd:string, td:string) -> string
{
  return text_concat(version(),Formats.canonical_field_suffix(sd,dd,vd,pd,rd,td));
}

fn recommendation(s:C.Scenario, r:Policy.Decision, id:string,
  sd:string, dd:string, vd:string, pd:string) -> string
{
  let strategy = Policy.version();
  let at = sx_text(s["decision_at"]);
  let currency = sx_text(s["currency"]);
  let price = F.num(r["price"]);
  let cost = F.num(r["cost"]);
  let demand = F.num(r["demand"]);
  let score = F.num(r["score"]);
  let scale = F.num(Policy.scale());
  let method = sx_text(r["method"]);
  let evidence = sx_text(r["source"]);
  let b = buffer_new();
  buffer_append(b,"{\"mulib\":\"1.0\",\"kind\":\"pricing.contribution-recommendation\",\"schema_version\":\"1.0\",\"id\":\"recommendation:$id\",");
  buffer_append(b,"\"metadata\":{\"provenance\":{\"source_artifacts\":[\"blake3:$sd\",\"blake3:$dd\",\"blake3:$vd\"],\"strategy\":\"$strategy\",\"strategy_digest\":\"blake3:$pd\",\"demand_evidence\":\"blake3:$evidence\"},");
  buffer_append(b,"\"times\":{\"observed_at\":\"$at\",\"ingested_at\":\"$at\"},\"units\":{\"currency\":\"$currency\",\"price_basis\":\"room_night\"},\"quality\":{\"status\":\"validated\",\"evidence\":\"$method\"}},");
  buffer_append(b,"\"data\":{\"price_minor\":$price,\"marginal_cost_minor\":$cost,\"expected_room_nights_milli\":$demand,\"expected_contribution_minor_milli\":$score,\"scale\":$scale,\"reason\":\"max_expected_contribution\",\"published\":false,\"mode\":\"recommendation\"}}\n");
  return buffer_text(b);
}

fn evidence(r:Policy.Decision) -> string
{
  let source = sx_text(r["source"]);
  let method = sx_text(r["method"]);
  let observed = sx_text(r["observed"]);
  let ingested = sx_text(r["ingested"]);
  let floor = F.num(r["floor"]);
  let cap = F.num(r["cap"]);
  let cost = F.num(r["cost"]);
  let scale = F.num(Policy.scale());
  let candidates = sx_text(r["candidates"]);
  return "demand_evidence_blake3=$source\ndemand_method=$method\ndemand_observed_at=$observed\ndemand_ingested_at=$ingested\nfeasible_floor_minor=$floor\nfeasible_cap_minor=$cap\nmarginal_cost_minor=$cost\nscale=$scale\ncandidate_fields=price_minor,expected_room_nights_milli,expected_contribution_minor_milli,status\n$candidates";
}

fn explanation(s:C.Scenario, r:Policy.Decision, id:string,
  sd:string, dd:string, vd:string, pd:string) -> string
{
  let strategy = Policy.version();
  let graph = Declaration.graph_version();
  let at = sx_text(s["decision_at"]);
  let sid = F.num(s["id"]);
  let price = F.num(r["price"]);
  let score = F.num(r["score"]);
  let detail = evidence(r);
  let head = "FinPRED contribution decision trace v1\nstrategy=$strategy\ngraph=$graph\nmode=recommendation\npublished=false\nscenario_id=$sid\ndecision_at=$at\nsource_scenario_blake3=$sd\nsource_demand_blake3=$dd\nsource_valuation_blake3=$vd\nstrategy_blake3=$pd\n";
  let tail = "recommended_nightly_minor=$price\nexpected_contribution_minor_milli=$score\nreason=max_expected_contribution\nlineage_blake3=$id\n";
  return text_concat(head,text_concat(detail,tail));
}

fn summary(s:C.Scenario, r:Policy.Decision, id:string, rd:string, td:string)
{
  let price = F.num(r["price"]);
  let currency = sx_text(s["currency"]);
  let strategy = Policy.version();
  IO.basis_text_io_print("run_id=$id\nstrategy=$strategy\nrecommendation_minor=$price\ncurrency=$currency\nreason=max_expected_contribution\nrecommendation_digest=$rd\ntrace_digest=$td\npublished=false\n");
}

fn publish(home:string, scenario_raw:string, demand_raw:string, valuation_raw:string,
  policy_raw:string) -> i64
{
  if !Declaration.admits(policy_raw)
  { tool_fail("automat/ottomat: invalid graph or incompatible strategy"); }
  let s = C.scenario_csv(scenario_raw);
  let v = C.valuation_csv(valuation_raw,s);
  let sd = Store.digest(scenario_raw);
  let r = Policy.decide(s,v,sd,demand_raw);
  let dd = Store.digest(demand_raw);
  let vd = Store.digest(valuation_raw);
  let pd = Store.digest(policy_raw);
  let recipe = lineage(sd,dd,vd,pd);
  let id = Store.digest(recipe);
  let rec = recommendation(s,r,id,sd,dd,vd,pd);
  let trace = explanation(s,r,id,sd,dd,vd,pd);
  let rd = Store.digest(rec);
  let td = Store.digest(trace);
  # No rejected or insufficient evidence creates or updates a run directory.
  Store.ensure(home);
  if Store.put(home,scenario_raw) != sd || Store.put(home,demand_raw) != dd
    || Store.put(home,valuation_raw) != vd || Store.put(home,policy_raw) != pd
    || Store.put(home,recipe) != id || Store.put(home,rec) != rd || Store.put(home,trace) != td
  { tool_fail("yieldcraft contribution: artifact persistence divergence"); }
  Store.put_run(home,id,manifest(sd,dd,vd,pd,rd,td));
  summary(s,r,id,rd,td);
  return 0;
}

fn matches(raw:string) -> bool
{
  let prefix = text_concat(version(),",");
  return text_len(raw) >= text_len(prefix) && text_slice(raw,0,text_len(prefix)) == prefix;
}

fn replay(home:string, id:string, mode:string, raw:string) -> i64
{
  if mode != "replay" && mode != "explain" && mode != "evidence" && mode != "poindexter"
  { tool_fail("capability denied: execution mode and unknown modes unavailable"); }
  if CSV.rows(raw) != 1 || !matches(raw) { tool_fail("replay: malformed contribution manifest"); }
  let row = CSV.line(raw,0);
  CSV.require_width(row,7);
  let sd = CSV.field(row,1);
  let dd = CSV.field(row,2);
  let vd = CSV.field(row,3);
  let pd = CSV.field(row,4);
  let rd = CSV.field(row,5);
  let td = CSV.field(row,6);
  if !Store.valid_hash(sd) || !Store.valid_hash(dd) || !Store.valid_hash(vd)
    || !Store.valid_hash(pd) || !Store.valid_hash(rd) || !Store.valid_hash(td)
    || raw != manifest(sd,dd,vd,pd,rd,td)
  { tool_fail("replay: malformed contribution manifest"); }
  let recipe = lineage(sd,dd,vd,pd);
  if Store.digest(recipe) != id || Store.fetch(home,id) != recipe
  { tool_fail("replay: contribution lineage divergence"); }
  if !Declaration.admits(Store.fetch(home,pd))
  { tool_fail("replay: invalid contribution strategy declaration"); }
  let s = C.scenario_csv(Store.fetch(home,sd));
  let v = C.valuation_csv(Store.fetch(home,vd),s);
  let r = Policy.decide(s,v,sd,Store.fetch(home,dd));
  let rec = recommendation(s,r,id,sd,dd,vd,pd);
  let trace = explanation(s,r,id,sd,dd,vd,pd);
  if Store.fetch(home,rd) != rec || Store.fetch(home,td) != trace
  { tool_fail("replay: contribution output divergence"); }
  if mode == "poindexter"
  {
    let (ok,csv) = Sheet.render_contribution(id,rd,vd,dd,sx_text(s["currency"]),"room_night",
      v["current_cents"],r["price"],r["cost"],r["demand"],r["score"],Policy.scale());
    if !ok { tool_fail(csv); }
    IO.basis_text_io_print(csv);
    return 0;
  }
  println("replay_ok=true");
  summary(s,r,id,rd,td);
  if mode == "explain" { IO.basis_text_io_print("trace_begin\n$trace"); println("trace_end"); }
  if mode == "evidence"
  {
    let detail = evidence(r);
    IO.basis_text_io_print("evidence_begin\nevidence_version=yieldcraft.demand-evidence@1\nsource_run_id=$id\nsource_demand_blake3=$dd\n$detail");
    println("evidence_end");
  }
  return 0;
}
