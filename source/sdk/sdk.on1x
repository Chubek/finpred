# Closed-by-default On1x extension descriptor policy (MVP).
# No arbitrary native DLLs, Lua, filesystem, network, brokerage or publishing.
record Descriptor
{
  name: sexpr,
  sdk_version: i64,
  kind: sexpr,
  contract: sexpr,
  effect: sexpr
}
fn yieldcraft_descriptor() -> Descriptor
{
  return record<Descriptor>{name:sx_string("yieldcraft.percentile"),sdk_version:1,
    kind:sx_string("Strategy"),contract:sx_string("pricing.recommendation@1"),effect:sx_string("pure")};
}
fn text_is(atom: sexpr, value: string) -> bool
{
  if sx_kind(atom) != 2 { return false; }
  return sx_text(atom) == value;
}
fn admit(plugin: Descriptor, mode: string) -> bool
{
  if plugin["sdk_version"] != 1 { return false; }
  if !text_is(plugin["name"],"yieldcraft.percentile") { return false; }
  if !text_is(plugin["kind"],"Strategy") || !text_is(plugin["contract"],"pricing.recommendation@1") { return false; }
  if !text_is(plugin["effect"],"pure") { return false; }
  return mode == "recommendation" || mode == "analysis" || mode == "simulation";
}
