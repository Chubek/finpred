# Internal On1x callable protocol, not the C ABI. The host supplies its linked
# resolver and invoker; this module owns no registrations and grants no effects.
import core.date as Date;
import core.format as F;
record Pin
{ package_name   : sexpr
, package_version: sexpr
, handler_name   : sexpr
, handler_version: sexpr
, abi            : i64
, code_digest    : sexpr
, policy_digest  : sexpr
}

record Port
{ name     : sexpr
, kind     : sexpr
, major    : i64
, unit     : sexpr
, currency : sexpr
, states   : i64
, max_bytes: i64
}

record Descriptor
{ enabled : bool
, pin     : Pin
, role    : sexpr
, mode    : sexpr
, effect  : sexpr
, inputs  : sexpr
, output  : Port
, max_work: i64
}

record Request
{ inputs: sexpr
, cutoff: sexpr
, work  : i64
}

# 0 success; 1 denied/unavailable; 2 pin mismatch; 3 invalid request;
# 4 insufficient work; 5 handler failure; 6 invalid handler output.
record Outcome
{ status: i64
, state : i64
, bytes : sexpr
}

fn failure(status: i64) -> Outcome
{
  return record<Outcome>
  { status: status
  , state : 0
  , bytes : sx_nil()
  };
}

fn success(state: i64, bytes: string) -> Outcome
{
  return record<Outcome>
  { status: 0
  , state : state
  , bytes : sx_string(bytes)
  };
}

fn atom(s: sexpr, max: i64) -> bool
{
  return sx_kind(s) == 2 && text_len(sx_text(s)) > 0 && text_len(sx_text(s)) <= max;
}

fn same(a: sexpr, b: sexpr) -> bool
{
  return sx_kind(a) == 2 && sx_kind(b) == 2 && sx_text(a) == sx_text(b);
}

fn valid_digest(s: sexpr) -> bool
{
  if ! atom(s, 71) || text_len(sx_text(s)) != 71 || text_slice(
    sx_text(s),
    0,
    7
  ) != "blake3:"
  {
    return false;
  }
  for i in 7 .. 71
  {
    let c = text_byte(sx_text(s), i);
    if !(c >= 48 && c <= 57) && !(c >= 97 && c <= 102)
    {
      return false;
    }
  }
  return true;
}

fn same_pin(a: Pin, b: Pin) -> bool
{
  return same(a["package_name"], b["package_name"]) && same(
    a["package_version"],
    b["package_version"]
  ) && same(a["handler_name"], b["handler_name"]) && same(
    a["handler_version"],
    b["handler_version"]
  ) && a["abi"] == b["abi"] && same(a["code_digest"], b["code_digest"]) && same(
    a["policy_digest"],
    b["policy_digest"]
  );
}

# State mask bits (and individual value states): available=1, partial=2,
# unknown=4, stale=8, redacted=16. Input masks accept; output masks emit.
fn accepts(states: i64, state: i64) -> bool
{
  if state != 1 && state != 2 && state != 4 && state != 8 && state != 16
  {
    return false;
  }
  return states > 0 && states <= 31 && (states / state) % 2 == 1;
}

fn valid_port(p: Port) -> bool
{
  return atom(p["name"], 63) && atom(
    p["kind"],
    127
  ) && p["major"] > 0 && p["major"] <= 999 && atom(p["unit"], 63) && atom(
    p["currency"],
    31
  ) && p["states"] > 0 && p["states"] <= 31 && p["max_bytes"] > 0 && p["max_bytes"] <= 2000000;
}

fn connects(output: Port, input: Port) -> bool
{
  if ! valid_port(output) || ! valid_port(input)
  {
    return false;
  }
  if ! same(
    output["kind"],
    input["kind"]
  ) || output["major"] != input["major"] || ! same(
    output["unit"],
    input["unit"]
  ) || ! same(
    output["currency"],
    input["currency"]
  ) || output["max_bytes"] > input["max_bytes"]
  {
    return false;
  }
  var state = 1;
  while state <= 16
  {
    if accepts(output["states"], state) && ! accepts(input["states"], state)
    {
      return false;
    }
    state = state * 2;
  }
  return true;
}

# On1x records are nominal and not sexpr members. Descriptor.inputs is a
# proper list of port_entry values in declared order (at most 16).
fn port_entry(p: Port) -> sexpr
{
  return sx_cons(
    p["name"],
    sx_cons(
      p["kind"],
      sx_cons(
        sx_string(F.num(p["major"])),
        sx_cons(
          p["unit"],
          sx_cons(
            p["currency"],
            sx_cons(
              sx_string(F.num(p["states"])),
              sx_cons(sx_string(F.num(p["max_bytes"])), sx_nil())
            )
          )
        )
      )
    )
  );
}

fn nat(s: sexpr) -> i64
{
  if ! atom(s, 7)
  {
    return 0;
  }
  let text = sx_text(s);
  if text_byte(text, 0) == 48
  {
    return 0;
  }
  var value = 0;
  for i in 0 .. text_len(text)
  {
    let digit = Date.digit(text, i);
    if digit < 0
    {
      return 0;
    }
    value = value * 10 + digit;
  }
  return value;
}

fn port_at(entry: sexpr, pos: i64) -> sexpr
{
  var rest = entry;
  for i in 0 .. pos
  {
    if sx_kind(rest) != 3
    {
      return sx_nil();
    }
    rest = sx_tail(rest);
  }
  if sx_kind(rest) != 3
  {
    return sx_nil();
  }
  return sx_head(rest);
}

fn decode_port(entry: sexpr) -> Port
{
  var rest = entry;
  for i in 0 .. 7
  {
    if sx_kind(rest) == 3
    {
      rest = sx_tail(rest);
    }
    else
    {
      rest = sx_string("");
    }
  }
  var major = nat(port_at(entry, 2));
  if sx_kind(rest) != 0
  {
    major = 0;
  }
  return record<Port>
  { name     : port_at(entry, 0)
  , kind     : port_at(entry, 1)
  , major    : major
  , unit     : port_at(entry, 3)
  , currency : port_at(entry, 4)
  , states   : nat(port_at(entry, 5))
  , max_bytes: nat(port_at(entry, 6))
  };
}

fn unavailable() -> Descriptor
{
  let empty = sx_nil();
  return record<Descriptor>
  { enabled : false
  , pin     : record<Pin>
    { package_name   : empty
    , package_version: empty
    , handler_name   : empty
    , handler_version: empty
    , abi            : 0
    , code_digest    : empty
    , policy_digest  : empty
    }
  , role    : empty
  , mode    : empty
  , effect  : empty
  , inputs  : empty
  , output  : decode_port(empty)
  , max_work: 0
  };
}

fn valid_descriptor(d: Descriptor, mode: string, handler: string) -> bool
{
  if ! d["enabled"] || (mode != "analysis" && mode != "recommendation") || ! same(
    d["mode"],
    sx_string(mode)
  ) || ! same(
    d["effect"],
    sx_string("pure")
  ) || ! valid_port(d["output"]) || d["max_work"] < 1 || d["max_work"] > 1000000
  {
    return false;
  }
  let role = d["role"];
  if ! same(role, sx_string("Source")) && ! same(
    role,
    sx_string("Transformer")
  ) && ! same(role, sx_string("Algorithm")) && ! same(
    role,
    sx_string("Model")
  ) && ! same(role, sx_string("Strategy")) && ! same(role, sx_string("View"))
  {
    return false;
  }
  let p = d["pin"];
  if p["abi"] != 1 || ! atom(p["package_name"], 127) || ! atom(
    p["package_version"],
    31
  ) || ! atom(p["handler_name"], 127) || ! atom(
    p["handler_version"],
    31
  ) || ! same(
    p["handler_name"],
    sx_string(handler)
  ) || ! valid_digest(p["code_digest"]) || ! valid_digest(p["policy_digest"])
  {
    return false;
  }
  var rest = d["inputs"];
  var names = sx_nil();
  var count = 0;
  while sx_kind(rest) == 3
  {
    let port = decode_port(sx_head(rest));
    if count >= 16 || ! valid_port(port)
    {
      return false;
    }
    var seen = names;
    while sx_kind(seen) == 3
    {
      if same(sx_head(seen), port["name"])
      {
        return false;
      }
      seen = sx_tail(seen);
    }
    names = sx_cons(port["name"], names);
    count = count + 1;
    rest = sx_tail(rest);
  }
  return sx_kind(rest) == 0;
}

fn resolve(
  handler: string,
  mode: string,
  lookup: fn(string) -> Descriptor
) -> Descriptor
{
  if text_len(handler) < 1 || text_len(handler) > 127
  {
    return unavailable();
  }
  let d = lookup(handler);
  if ! valid_descriptor(d, mode, handler)
  {
    return unavailable();
  }
  return d;
}

# Request.inputs is an ordered proper list of value_entry entries. Handlers
# receive no host handles; the graph owns digest/lineage and contract validation.
fn value_entry(state: i64, bytes: string) -> sexpr
{
  return sx_cons(sx_string(F.num(state)), sx_cons(sx_string(bytes), sx_nil()));
}

fn value_state(entry: sexpr) -> i64
{
  return nat(port_at(entry, 0));
}

fn value_bytes(entry: sexpr) -> sexpr
{
  return port_at(entry, 1);
}

fn valid_value(p: Port, state: i64, bytes: sexpr) -> bool
{
  return accepts(p["states"], state) && atom(bytes, p["max_bytes"]);
}

# An explicitly unknown output can have a zero-byte canonical encoding
# (for example, no rows in NDJSON). It is not an empty success for an
# available/partial port, and request inputs still must be nonempty.
fn valid_output(p: Port, state: i64, bytes: sexpr) -> bool
{
  return valid_value(p, state, bytes) || (state == 4 && accepts(
    p["states"],
    state
  ) && sx_kind(bytes) == 2 && sx_text(bytes) == "");
}

fn valid_inputs(ports: sexpr, values: sexpr) -> bool
{
  var ps = ports;
  var vs = values;
  while sx_kind(ps) == 3 && sx_kind(vs) == 3
  {
    let v = sx_head(vs);
    if sx_kind(v) != 3
    {
      return false;
    }
    let rest = sx_tail(v);
    if sx_kind(rest) != 3 || sx_kind(sx_tail(rest)) != 0 || ! valid_value(
      decode_port(sx_head(ps)),
      value_state(v),
      value_bytes(v)
    )
    {
      return false;
    }
    ps = sx_tail(ps);
    vs = sx_tail(vs);
  }
  return sx_kind(ps) == 0 && sx_kind(vs) == 0;
}

fn invoke(
  pin: Pin,
  mode: string,
  request: Request,
  lookup: fn(string) -> Descriptor,
  call: fn(Pin, Request) -> Outcome
) -> Outcome
{
  if ! atom(pin["handler_name"], 127)
  {
    return failure(1);
  }
  let d = resolve(sx_text(pin["handler_name"]), mode, lookup);
  if ! d["enabled"]
  {
    return failure(1);
  }
  if ! same_pin(pin, d["pin"])
  {
    return failure(2);
  }
  if request["work"] < 1 || request["work"] > d["max_work"]
  {
    return failure(4);
  }
  if ! atom(
    request["cutoff"],
    20
  ) || ! Date.utc_timestamp(sx_text(request["cutoff"])) || ! valid_inputs(
    d["inputs"],
    request["inputs"]
  )
  {
    return failure(3);
  }
  let result = call(d["pin"], request);
  if result["status"] == 4
  {
    return failure(4);
  }
  if result["status"] != 0
  {
    return failure(5);
  }
  if ! valid_output(d["output"], result["state"], result["bytes"])
  {
    return failure(6);
  }
  return result;
}
