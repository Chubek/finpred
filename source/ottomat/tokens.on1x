# Byte cursors: -1 means failure and propagates through token readers.
# The calling grammar limits input to 512 bytes. No skipped whitespace.
fn at(s: string, pos: i64, byte: i64) -> i64
{
  if pos < 0 || pos >= text_len(s) { return -1; }
  if text_byte(s,pos) != byte { return -1; }
  return pos + 1;
}

fn line_end(s: string, pos: i64) -> i64
{
  if pos == text_len(s) { return pos; }
  let cr = at(s,pos,13);
  if cr >= 0 { return at(s,cr,10); }
  return at(s,pos,10);
}

fn word(s: string, pos: i64) -> (string, i64)
{
  if pos < 0 || pos >= text_len(s) { return ("",-1); }
  let first = text_byte(s,pos);
  if first < 97 || first > 122 { return ("",-1); }
  var end = pos;
  for i in pos .. text_len(s)
  {
    let c = text_byte(s,i);
    if !(c >= 97 && c <= 122) && !(c >= 48 && c <= 57) && c != 45 && c != 95 { break; }
    end = i + 1;
    if end - pos > 32 { return ("",-1); }
  }
  return (text_slice(s,pos,end),end);
}

fn number(s: string, pos: i64) -> (i64, i64)
{
  if pos < 0 || pos >= text_len(s) { return (-1,-1); }
  var value = 0;
  var end = pos;
  for i in pos .. text_len(s)
  {
    let c = text_byte(s,i);
    if c < 48 || c > 57 { break; }
    if i > pos && value == 0 { return (-1,-1); }
    # The previous iteration bounded value to 10000, so this cannot overflow.
    value = value * 10 + (c - 48);
    if value > 10000 { return (-1,-1); }
    end = i + 1;
  }
  if pos == end { return (-1,-1); }
  return (value,end);
}
