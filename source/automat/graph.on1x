# On1x typed execution plan. MVP has one bounded acyclic graph.
# Effects are checked independently of any strategy configuration setting.
record Node
{
  id: i64,
  family: sexpr,
  accepts: sexpr,
  produces: sexpr,
  effect: sexpr
}

fn make_node(id: i64, family: string, accepts: string, produces: string, effect: string) -> Node
{
  return record<Node>{id:id, family:sx_string(family), accepts:sx_string(accepts),
    produces:sx_string(produces), effect:sx_string(effect)};
}

fn node(id: i64) -> Node
{
  if id == 0 { return make_node(id,"input","none","hospitality.scenario@1","read"); }
  if id == 1 { return make_node(id,"source","hospitality.scenario@1","hospitality.offer@1","read"); }
  if id == 2 { return make_node(id,"transform","hospitality.offer@1","hospitality.offer@1","pure"); }
  if id == 3 { return make_node(id,"algorithm","hospitality.offer@1","pricing.distribution@1","pure"); }
  if id == 4 { return make_node(id,"strategy","pricing.distribution@1","pricing.recommendation@1","pure"); }
  if id == 5 { return make_node(id,"gate","pricing.recommendation@1","pricing.recommendation@1","pure"); }
  if id == 6 { return make_node(id,"output","pricing.recommendation@1","pricing.recommendation@1","record"); }
  tool_fail("automat: unknown node id");
  return make_node(id,"error","none","none","none");
}

fn validate(mode: string) -> bool
{
  if mode != "analysis" && mode != "recommendation" && mode != "simulation"
  { return false; }
  # A single monotonic topological order and exact edge schema equality.
  for id in 0 .. 6
  {
    let a = node(id);
    let b = node(id + 1);
    if sx_text(a["produces"]) != sx_text(b["accepts"]) || b["id"] <= a["id"] { return false; }
    if sx_text(a["effect"]) == "external_action" || sx_text(b["effect"]) == "external_action" { return false; }
  }
  return true;
}

fn version() -> string { return "yieldcraft.fixed-graph@1"; }
