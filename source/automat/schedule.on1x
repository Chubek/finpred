# Internal dependency planner. Rows are (ID node-parent-ID ...); roots
# are already available and omitted. This module knows nothing about port
# typing, effects, callbacks, evidence, or execution.
import std.String as Str;
import std.collections.Array as A;
import std.collections.List as L;
fn index(rows: sexpr, name: string) -> i64
{
  var items = rows;
  var i = 0;
  while sx_kind(items) == 3
  {
    if sx_text(sx_head(sx_head(items))) == name
    {
      return i;
    }
    i = i + 1;
    items = sx_tail(items);
  }
  return - 1;
}

# Populate a bounded outgoing-edge matrix once. Multiplicity matters when
# several input bindings read the same parent: all are released together.
fn bind(rows: sexpr, count: i64, outgoing: i64, pending: i64) -> bool
{
  var items = rows;
  for to in 0 .. count
  {
    let row = sx_head(items);
    if index(rows, sx_text(sx_head(row))) != to
    {
      return false;
    }
    var parents = sx_tail(row);
    var degree = 0;
    while sx_kind(parents) == 3
    {
      let parent = sx_head(parents);
      if degree >= 16 || sx_kind(parent) != 2
      {
        return false;
      }
      let from = index(rows, sx_text(parent));
      if from < 0
      {
        return false;
      }
      let edge = from * count + to;
      A.basis_array_update(
        outgoing,
        edge,
        A.basis_array_sub(outgoing, edge) + 1
      );
      degree = degree + 1;
      parents = sx_tail(parents);
    }
    if sx_kind(parents) != 0
    {
      return false;
    }
    A.basis_array_update(pending, to, degree);
    items = sx_tail(items);
  }
  return true;
}

fn drain(
  rows: sexpr,
  count: i64,
  lexical: bool,
  outgoing: i64,
  pending: i64
) -> sexpr
{
  var ordered = sx_nil();
  var done = 0;
  while done < count
  {
    var items = rows;
    var chosen = - 1;
    var id = sx_nil();
    for i in 0 .. count
    {
      let candidate = sx_head(sx_head(items));
      if A.basis_array_sub(
        pending,
        i
      ) == 0 && (chosen < 0 || (lexical && Str.compare(
        sx_text(candidate),
        sx_text(id)
      ) < 0))
      {
        chosen = i;
        id = candidate;
        if ! lexical
        {
          break;
        }
      }
      items = sx_tail(items);
    }
    if chosen < 0
    {
      return sx_nil();
    }
    # Negative marks a completed node, distinct from a ready node (zero).
    A.basis_array_update(pending, chosen, - 1);
    for to in 0 .. count
    {
      let edges = A.basis_array_sub(outgoing, chosen * count + to);
      if edges > 0
      {
        A.basis_array_update(
          pending,
          to,
          A.basis_array_sub(pending, to) - edges
        );
      }
    }
    ordered = sx_cons(id, ordered);
    done = done + 1;
  }
  return L.basis_list_rev(ordered);
}

# Returns the complete order or nil on failure; never publishes a prefix.
# A newly ready node participates in the very next tie, not a later wave.
fn order(version: string, rows: sexpr) -> sexpr
{
  let lexical = version == "automat.financial-graph@1";
  if ! lexical && version != "automat.scalar-dag@1" && version != "automat.scalar-dag@2" && version != "automat.scalar-dag@3"
  {
    return sx_nil();
  }
  var items = rows;
  var count = 0;
  while sx_kind(items) == 3
  {
    let row = sx_head(items);
    if count >= 32 || sx_kind(row) != 3 || sx_kind(sx_head(row)) != 2
    {
      return sx_nil();
    }
    count = count + 1;
    items = sx_tail(items);
  }
  if count == 0 || sx_kind(items) != 0
  {
    return sx_nil();
  }
  let outgoing = A.basis_array_array(count * count, 0);
  let pending = A.basis_array_array(count, 0);
  var result = sx_nil();
  if bind(rows, count, outgoing, pending)
  {
    result = drain(rows, count, lexical, outgoing, pending);
  }
  A.basis_array_destroy(pending);
  A.basis_array_destroy(outgoing);
  return result;
}
