import std.Int as Int;
fn num(n: i64) -> string { return Int.to_string(n); }
fn join2(a: string, b: string) -> string { return text_concat(a, b); }
fn kv(key: string, value: string) -> string
{
  return text_concat(text_concat("\"", key), text_concat("\":", value));
}
fn q(value: string) -> string
{
  # Callers only pass validated digits, fixed vocabulary or UTC ISO timestamps.
  for i in 0 .. text_len(value)
  {
    let c = text_byte(value, i);
    if c == 34 || c == 92 || c < 32 || c > 126 { tool_fail("JSON: noncanonical string"); }
  }
  return text_concat(text_concat("\"", value), "\"");
}
fn bool_text(value: bool) -> string
{
  if value { return "true"; }
  return "false";
}
