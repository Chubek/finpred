# Shared primitives for reading fixed canonical snapshot profiles, not general JSON.
import core.date as Date;
import core.format as F;
import std.String as Str;
import std.crypto.crypto as Crypto;
record Tail
{ start        : i64
, status       : sexpr
, observed     : sexpr
, received     : sexpr
, ingested     : sexpr
, source_cutoff: sexpr
}

fn after(s: string, at: i64, expected: string) -> i64
{
  let end = at + text_len(expected);
  if at < 0 || end > text_len(s) || text_slice(s, at, end) != expected
  {
    return 0 - 1;
  }
  return end;
}

fn token(s: string, at: i64, stop: i64, limit: i64) ->(i64, string)
{
  if at < 0
  {
    return (0 - 1, "");
  }
  var end = at;
  while end < text_len(s) && end - at <= limit
  {
    let c = text_byte(s, end);
    if c == stop && end > at
    {
      return (end, text_slice(s, at, end));
    }
    if c < 32 || c > 126 || c == 92 || c == 34
    {
      return (0 - 1, "");
    }
    end = end + 1;
  }
  return (0 - 1, "");
}

fn quoted(s: string, at: i64, prefix: string, limit: i64) ->(i64, string)
{
  let(end, value) = token(s, after(s, at, prefix), 34, limit);
  if end < 0
  {
    return (0 - 1, "");
  }
  return (end + 1, value);
}

fn nat(s: string, max_digits: i64) -> i64
{
  let n = text_len(s);
  if n < 1 || n > max_digits || n > 12 || (n > 1 && text_byte(s, 0) == 48)
  {
    return 0 - 1;
  }
  var value = 0;
  for i in 0 .. n
  {
    let digit = Date.digit(s, i);
    if digit < 0
    {
      return 0 - 1;
    }
    value = value * 10 + digit;
  }
  return value;
}

fn digest(s: string) -> bool
{
  if text_len(s) != 71 || after(s, 0, "blake3:") != 7
  {
    return false;
  }
  for i in 7 .. 71
  {
    let c = text_byte(s, i);
    if !(c >= 48 && c <= 57) && !(c >= 97 && c <= 102)
    {
      return false;
    }
  }
  return true;
}

fn policy(s: string) -> bool
{
  if text_len(s) == 0 || text_len(s) > 64
  {
    return false;
  }
  for i in 0 .. text_len(s)
  {
    let c = text_byte(s, i);
    if !(c >= 48 && c <= 57) && !(c >= 65 && c <= 90) && !(c >= 97 && c <= 122) && c != 45 && c != 46 && c != 95
    {
      return false;
    }
  }
  return true;
}

fn clock(s: string) -> i64
{
  if ! Date.utc_timestamp(s)
  {
    return 0 - 1;
  }
  return Date.date_days(text_slice(s, 0, 10)) * 86400 + (Date.digit(
    s,
    11
  ) * 10 + Date.digit(s, 12)) * 3600 + (Date.digit(s, 14) * 10 + Date.digit(
    s,
    15
  )) * 60 + Date.digit(s, 17) * 10 + Date.digit(s, 18);
}

fn field(out: buffer, name: string, value: string)
{
  buffer_append(out, ",");
  buffer_append(out, F.q(name));
  buffer_append(out, ":");
  buffer_append(out, F.q(value));
}

# 0 validated bounds/cutoff/parent, 1 absent or wrong parent, 2 malformed.
fn parent_status(
  snapshot: string,
  parent: string,
  cutoff: string,
  max_bytes: i64
) -> i64
{
  if text_len(snapshot) == 0 || ! digest(parent)
  {
    return 1;
  }
  if text_len(snapshot) > max_bytes || ! Date.utc_timestamp(cutoff)
  {
    return 2;
  }
  let(status, hash) = Crypto.basis_crypto_blake3(snapshot);
  if status != 0 || "blake3:$hash" != parent
  {
    return 1;
  }
  return 0;
}

# The two provider headers end just before the common status field.
fn tail(snapshot: string, offset: i64) -> Tail
{
  let(b, status) = quoted(snapshot, offset, ",\"status\":\"", 8);
  let(c, mode) = quoted(snapshot, b, ",\"mode\":\"", 16);
  let(d, observed) = quoted(snapshot, c, ",\"observed_at\":\"", 20);
  let(e, received) = quoted(snapshot, d, ",\"received_at\":\"", 20);
  let(f, ingested) = quoted(snapshot, e, ",\"ingested_at\":\"", 20);
  let(g, source_cutoff) = quoted(snapshot, f, ",\"as_of\":\"", 20);
  let(h, terms) = quoted(snapshot, g, ",\"terms_ref\":\"", 64);
  let(i, retention) = quoted(snapshot, h, ",\"retention_ref\":\"", 64);
  let(j, raw) = quoted(snapshot, i, ",\"raw_evidence\":\"", 71);
  let(k, capture) = quoted(snapshot, j, ",\"capture_evidence\":\"", 71);
  let(l, size) = token(snapshot, after(snapshot, k, ",\"raw_bytes\":"), 44, 5);
  var start = after(snapshot, l, ",\"pricing_input\":false,\"observations\":[");
  let n = nat(size, 5);
  if (status != "complete" && status != "partial") || (mode != "offline_snapshot" && mode != "loopback_fixture" && mode != "public_https") || observed != received || ! Date.utc_timestamp(received) || ! Date.utc_timestamp(ingested) || ! Date.utc_timestamp(source_cutoff) || Str.compare(
    ingested,
    received
  ) < 0 || Str.compare(
    source_cutoff,
    ingested
  ) < 0 || ! policy(terms) || ! policy(retention) || ! digest(raw) || ! digest(capture) || n < 1 || n > 65536
  {
    start = 0 - 1;
  }
  return record<Tail>
  { start        : start
  , status       : sx_string(status)
  , observed     : sx_string(observed)
  , received     : sx_string(received)
  , ingested     : sx_string(ingested)
  , source_cutoff: sx_string(source_cutoff)
  };
}

fn visible(t: Tail, cutoff: string) -> bool
{
  return t["start"] >= 0 && Str.compare(
    sx_text(t["source_cutoff"]),
    cutoff
  ) <= 0;
}

fn times(out: buffer, t: Tail, cutoff: string)
{
  field(out, "observed_at", sx_text(t["observed"]));
  field(out, "received_at", sx_text(t["received"]));
  field(out, "ingested_at", sx_text(t["ingested"]));
  field(out, "source_as_of", sx_text(t["source_cutoff"]));
  field(out, "cutoff", cutoff);
}
