# Strict, bounded, unquoted ASCII CSV profile (not general RFC 4180 CSV).
# Commas and quotes inside fields are rejected rather than silently misparsed.
import std.Int as Int;

fn rows(input: string) -> i64
{
  if text_len(input) == 0 { return 0; }
  var n = 0;
  for i in 0 .. text_len(input)
  {
    if text_byte(input, i) == 10 { n = n + 1; }
    if text_byte(input, i) == 0 || text_byte(input, i) == 34 { tool_fail("CSV: NUL or quoted fields unsupported"); }
  }
  if text_byte(input, text_len(input) - 1) != 10 { n = n + 1; }
  return n;
}

fn line(input: string, index: i64) -> string
{
  if index < 0 { tool_fail("CSV: bad line index"); }
  var start = 0;
  var current = 0;
  for i in 0 .. text_len(input)
  {
    if text_byte(input, i) == 10
    {
      if current == index
      {
        var end = i;
        if end > start && text_byte(input, end - 1) == 13 { end = end - 1; }
        return text_slice(input, start, end);
      }
      current = current + 1;
      start = i + 1;
    }
  }
  if current == index && start < text_len(input)
  {
    return text_slice(input, start, text_len(input));
  }
  tool_fail("CSV: line out of range");
  return "";
}

fn columns(row: string) -> i64
{
  var n = 1;
  for i in 0 .. text_len(row)
  {
    if text_byte(row, i) == 34 || text_byte(row, i) == 0 || text_byte(row, i) == 10
    { tool_fail("CSV: quotes, NUL, and multiline fields are unsupported"); }
    if text_byte(row, i) == 44 { n = n + 1; }
  }
  return n;
}

fn field(row: string, index: i64) -> string
{
  if index < 0 { tool_fail("CSV: negative column"); }
  var start = 0;
  var column = 0;
  for i in 0 .. text_len(row)
  {
    if text_byte(row, i) == 44
    {
      if column == index { return text_slice(row, start, i); }
      column = column + 1;
      start = i + 1;
    }
  }
  if column == index { return text_slice(row, start, text_len(row)); }
  tool_fail("CSV: column out of range");
  return "";
}

fn exact_int(s: string) -> i64
{
  if text_len(s) == 0 { tool_fail("CSV: missing integer"); }
  let(ok, value, end) = Int.scan(s, 0);
  if !ok || end != text_len(s) { tool_fail("CSV: invalid or overflowing integer"); }
  return value;
}

fn nat(s: string) -> i64
{
  let n = exact_int(s);
  if n < 0 { tool_fail("CSV: negative quantity"); }
  return n;
}

fn bit(s: string) -> bool
{
  if s == "1" { return true; }
  if s == "0" { return false; }
  tool_fail("CSV: expected flag 0 or 1");
  return false;
}

fn header(row: string, expected: string)
{
  if row != expected { tool_fail("CSV: unexpected header/schema"); }
}

fn require_width(row: string, expected: i64)
{
  if columns(row) != expected { tool_fail("CSV: unexpected column count"); }
}
