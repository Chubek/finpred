# Pure calculation over prefiltered price observations. This is a forecast of
# the observed price series, not a recommendation, demand forecast or action.
import core.csv as CSV;

extern fn finpred_on1x_price_predict(history:string, model:string, horizon:i64, season:i64) -> string;
extern fn finpred_on1x_price_history_count(history:string) -> i64;
extern fn finpred_on1x_price_measure(rows:string) -> string;

record Prediction { status:sexpr, observations:i64, point_minor:i64, dispersion_minor:i64 }

fn rejected(status:string) -> Prediction
{
  return record<Prediction>{status:sx_string(status),observations:0,point_minor:0,dispersion_minor:0};
}

fn predict(history:string, model:string, horizon:i64, season:i64) -> Prediction
{
  let wire = finpred_on1x_price_predict(history,model,horizon,season);
  if CSV.columns(wire) != 3 { return rejected(wire); }
  let spread = CSV.field(wire,2);
  var dispersion = 0-1;
  if spread != "-1" { dispersion = CSV.nat(spread); }
  return record<Prediction>{status:sx_string("ok"),observations:CSV.nat(CSV.field(wire,0)),
    point_minor:CSV.nat(CSV.field(wire,1)),dispersion_minor:dispersion};
}

fn history_count(history:string) -> i64 { return finpred_on1x_price_history_count(history); }

# Canonical private wire: absolute sum, square sum, signed sum, actual sum, RMSE.
fn measure(scored_pairs:string) -> string { return finpred_on1x_price_measure(scored_pairs); }
