#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
EXE=${FINPRED_EXE:-"$ROOT/target/dev/finpred"}
if [ ! -x "$EXE" ]; then
  echo "FinPRED On1x executable absent: build with bin/build.sh first" >&2
  exit 2
fi
MODE=${1:-run}
case "$MODE" in
  run|selftest)
    [ "$#" -le 1 ] || { echo "usage: bin/finpred [run|selftest|replay RUN_ID]" >&2; exit 2; }
    ;;
  replay)
    [ "$#" -eq 2 ] || { echo "usage: bin/finpred replay RUN_ID" >&2; exit 2; }
    FINPRED_RUN_ID=$2
    export FINPRED_RUN_ID
    ;;
  *) echo "Unknown or forbidden mode: $MODE" >&2; exit 2 ;;
esac
cd "$ROOT"
FINPRED_MODE=$MODE
export FINPRED_MODE
exec "$EXE"
