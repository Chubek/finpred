#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${FINPRED_MODE:-}" = execution ]; then
  echo "capability denied: execution is forbidden" >&2
  exit 2
fi
. "$ROOT/bin/paths.sh"
MODE=${1:-run}
usage() {
  echo "usage: bin/finpred [run [--engine legacy|scalar]|selftest|replay RUN_ID|explain RUN_ID|evidence RUN_ID|poindexter RUN_ID]" >&2
  echo "       bin/finpred price-predict MODEL HORIZON HISTORY [SEASON]" >&2
  echo "       bin/finpred price-backtest MODEL HORIZON FIRST_TARGET HISTORY [SEASON]" >&2
  echo "       bin/finpred forecast {import SNAPSHOT|catalog ID_LIST|issue CATALOG MODEL CUTOFF REQUEST|score ISSUE CATALOG CUTOFF|holdout PLAN|audit SORTED_ID_LIST|replay ID}" >&2
  echo "       bin/finpred cube {evaluate SNAPSHOTS CELLS POLICIES|replay ID}" >&2
  echo "       bin/finpred {dragnet-inspect|dragnet-offers} CAPTURE UTC_CUTOFF" >&2
  exit 2
}
case "$MODE" in
  run)
    if [ "$#" -gt 1 ]; then
      [ "$#" -eq 3 ] && [ "$2" = --engine ] && [ -n "$3" ] || usage
      FINPRED_ENGINE=$3
      export FINPRED_ENGINE
    fi
    ;;
  selftest)
    [ "$#" -eq 1 ] || usage
    ;;
  price-predict)
    case "${2:-}" in
      seasonal) [ "$#" -eq 5 ] && [ -n "$5" ] || usage ;;
      *) [ "$#" -eq 4 ] || usage ;;
    esac
    [ -n "$4" ] || usage
    FINPRED_PRICE_MODEL=$2 FINPRED_PRICE_HORIZON=$3 FINPRED_PRICE_SEASON=${5:-}
    case "$4" in
      /*) FINPRED_PRICE_HISTORY=$4 ;;
      *) FINPRED_PRICE_HISTORY=$PWD/$4 ;;
    esac
    export FINPRED_PRICE_MODEL FINPRED_PRICE_HORIZON FINPRED_PRICE_HISTORY FINPRED_PRICE_SEASON
    ;;
  price-backtest)
    case "${2:-}" in
      seasonal) [ "$#" -eq 6 ] && [ -n "$6" ] || usage ;;
      *) [ "$#" -eq 5 ] || usage ;;
    esac
    [ -n "$5" ] || usage
    FINPRED_PRICE_MODEL=$2 FINPRED_PRICE_HORIZON=$3 FINPRED_PRICE_FIRST_TARGET=$4
    FINPRED_PRICE_SEASON=${6:-}
    case "$5" in
      /*) FINPRED_PRICE_HISTORY=$5 ;;
      *) FINPRED_PRICE_HISTORY=$PWD/$5 ;;
    esac
    export FINPRED_PRICE_MODEL FINPRED_PRICE_HORIZON FINPRED_PRICE_FIRST_TARGET
    export FINPRED_PRICE_HISTORY FINPRED_PRICE_SEASON
    ;;
  replay|explain|evidence|poindexter)
    [ "$#" -eq 2 ] || usage
    FINPRED_RUN_ID=$2
    export FINPRED_RUN_ID
    ;;
  dragnet-inspect|dragnet-offers)
    [ "$#" -eq 3 ] && [ -n "$2" ] || usage
    case "$2" in
      /*) FINPRED_DRAGNET_INPUT=$2 ;;
      *) FINPRED_DRAGNET_INPUT=$PWD/$2 ;;
    esac
    FINPRED_DRAGNET_CUTOFF=$3
    export FINPRED_DRAGNET_INPUT FINPRED_DRAGNET_CUTOFF
    ;;
  cube)
    case "${2:-}" in
      evaluate)
        [ "$#" -eq 5 ] || usage
        MODE=cube-evaluate
        FINPRED_CUBE_INPUT=$3 FINPRED_CUBE_CELLS=$4 FINPRED_CUBE_POLICIES=$5
        export FINPRED_CUBE_CELLS FINPRED_CUBE_POLICIES
        ;;
      replay)
        [ "$#" -eq 3 ] || usage
        MODE=cube-replay
        FINPRED_CUBE_INPUT=$3
        ;;
      *) usage ;;
    esac
    export FINPRED_CUBE_INPUT
    ;;
  forecast)
    [ "$#" -ge 2 ] || usage
    MODE=forecast-$2
    shift 2
    case "$MODE" in
      forecast-import|forecast-catalog|forecast-holdout|forecast-audit|forecast-replay)
        [ "$#" -eq 1 ] || usage
        FINPRED_FORECAST_INPUT=$1
        ;;
      forecast-issue)
        [ "$#" -eq 4 ] || usage
        FINPRED_FORECAST_CATALOG=$1 FINPRED_FORECAST_MODEL=$2
        FINPRED_FORECAST_CUTOFF=$3 FINPRED_FORECAST_INPUT=$4
        ;;
      forecast-score)
        [ "$#" -eq 3 ] || usage
        FINPRED_FORECAST_INPUT=$1 FINPRED_FORECAST_CATALOG=$2 FINPRED_FORECAST_CUTOFF=$3
        ;;
      *) usage ;;
    esac
    export FINPRED_FORECAST_INPUT FINPRED_FORECAST_CATALOG FINPRED_FORECAST_MODEL FINPRED_FORECAST_CUTOFF
    ;;
  *) echo "Unknown or forbidden mode: $MODE" >&2; exit 2 ;;
esac
case "$MODE" in
  forecast-*) EXE="$(finpred_cli_output_dir "$ROOT")-forecast/finpred-forecast" ;;
  cube-evaluate|cube-replay)
    EXE="$(finpred_cli_output_dir "$ROOT")/finpred-cube"
    if [ ! -x "$EXE" ]; then
      echo "FinPRED competitor cube host absent: run 'make' first" >&2
      exit 2
    fi
    ;;
  dragnet-inspect|dragnet-offers)
    EXE="$(finpred_dragnet_output_dir "$ROOT")/finpred-dragnet"
    if [ ! -x "$EXE" ]; then
      echo "FinPRED Dragnet consumer absent: run 'make dragnet' first" >&2
      exit 2
    fi
    ;;
  *) EXE=$(finpred_cli_executable "$ROOT") ;;
esac
if [ ! -x "$EXE" ]; then
  echo "FinPRED On1x executable absent: build with bin/build.sh first" >&2
  exit 2
fi
cd "$ROOT"
FINPRED_MODE=$MODE
export FINPRED_MODE
exec "$EXE"
