#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/bin/build-env.sh"
. "$ROOT/bin/paths.sh"
out=$(finpred_cli_output_dir "$ROOT")/finpred-caravansary

case ${1:-} in
  build)
    if [ "$#" -ne 1 ]; then
      echo 'caravansary: build takes no arguments' >&2
      exit 2
    fi
    exec sh "$ROOT/plugins/caravansary/build.sh" --all ;;
  market-help|discover|scrape|collect|predict|backtest|history|explain)
    out="$out-market" ;;
  schedule)
    if [ "$#" -lt 4 ] || [ "$2" != --state ]; then
      echo 'Usage: bin/caravansary schedule --state DIR PROFILE --at UTC (--once UTC | --every SECONDS)' >&2
      exit 2
    fi
    state=$3
    shift 3
    out="$out-jobs"
    set -- --state "$state" schedule "$@" ;;
  daemon)
    if [ "$#" -ne 6 ] || [ "$2" != --state ] || [ "$4" != --at ] || [ "$6" != --once ]; then
      echo 'Usage: bin/caravansary daemon --state DIR --at UTC --once (supervise one due job)' >&2
      exit 2
    fi
    out="$out-jobs"
    set -- --state "$3" dispatch --at "$5" ;;
  jobs)
    out="$out-jobs"
    shift ;;
esac
if [ ! -x "$out" ]; then
  echo 'caravansary: missing executable for this command; run bin/caravansary build' >&2
  exit 2
fi
exec "$out" "$@"
