{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One indicative ECB reference pair, analysis only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "version", "unit", "pricing_input", "executable", "source_kind", "source_series",
    "provider_updated_at", "base_currency", "quote_currency", "rate", "reference_date", "parent",
    "observed_at", "received_at", "ingested_at", "source_as_of", "cutoff"
  ],
  "properties": {
    "kind": {"const": "analysis.fx-reference"},
    "version": {"const": 1},
    "unit": {"const": "quote_currency_per_base_currency"},
    "pricing_input": {"const": false},
    "executable": {"const": false},
    "source_kind": {"const": "dragnet.ecb-fx-reference@1"},
    "source_series": {"const": "eurofxref-daily"},
    "provider_updated_at": {"type": "null"},
    "base_currency": {"const": "EUR"},
    "quote_currency": {"type": "string", "pattern": "^[A-Z]{3}$", "not": {"const": "EUR"}},
    "rate": {"type": "string", "maxLength": 24, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "not": {"pattern": "^0(\\.0+)?$"}},
    "reference_date": {"type": "string", "format": "date"},
    "parent": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "received_at": {"$ref": "#/$defs/utc"},
    "ingested_at": {"$ref": "#/$defs/utc"},
    "source_as_of": {"$ref": "#/$defs/utc"},
    "cutoff": {"$ref": "#/$defs/utc"}
  },
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
