{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direction of change in a dated ECB indicative reference pair, analysis only",
  "description": "Compare end rate to start rate for the same EUR base and quote currency. The two reference dates and both as-of-visible normalized parent artifacts must be verified by replay; this schema alone cannot check lineage, date ordering, or rate direction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "version", "unit", "pricing_input", "executable", "source_kind", "source_series",
    "base_currency", "quote_currency", "cutoff", "start_date", "end_date", "start_rate",
    "end_rate", "start_parent", "end_parent", "direction"
  ],
  "properties": {
    "kind": {"const": "analysis.fx-reference-change"},
    "version": {"const": 1},
    "unit": {"const": "quote_currency_per_base_currency"},
    "pricing_input": {"const": false},
    "executable": {"const": false},
    "source_kind": {"const": "dragnet.ecb-fx-reference@1"},
    "source_series": {"const": "eurofxref-daily"},
    "base_currency": {"const": "EUR"},
    "quote_currency": {"type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$", "not": {"const": "EUR"}},
    "cutoff": {"$ref": "#/$defs/utc"},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "start_rate": {"$ref": "#/$defs/rate"},
    "end_rate": {"$ref": "#/$defs/rate"},
    "start_parent": {"$ref": "#/$defs/digest"},
    "end_parent": {"$ref": "#/$defs/digest"},
    "direction": {"enum": ["up", "flat", "down"]}
  },
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rate": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "not": {"pattern": "^0(\\.0+)?$"}
    },
    "digest": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"}
  }
}
