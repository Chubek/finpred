{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monthly Eurostat guest nights, analysis only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "version", "unit", "currency", "pricing_input", "source_kind", "source_series",
    "geography", "activity", "residence", "state", "parent", "provider_updated_at",
    "observed_at", "received_at", "ingested_at", "source_as_of", "cutoff", "observations"
  ],
  "properties": {
    "kind": {"const": "analysis.guest-nights-monthly"},
    "version": {"const": 1},
    "unit": {"const": "guest_nights"},
    "currency": {"type": "null"},
    "pricing_input": {"const": false},
    "source_kind": {"const": "dragnet.eurostat-accommodation-nights@1"},
    "source_series": {"const": "tour_occ_nim"},
    "geography": {"const": "EU27_2020"},
    "activity": {"const": "I551-I553"},
    "residence": {"const": "TOTAL"},
    "state": {"enum": ["available", "partial"]},
    "parent": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "provider_updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$"
    },
    "observed_at": {"$ref": "#/$defs/utc"},
    "received_at": {"$ref": "#/$defs/utc"},
    "ingested_at": {"$ref": "#/$defs/utc"},
    "source_as_of": {"$ref": "#/$defs/utc"},
    "cutoff": {"$ref": "#/$defs/utc"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/month"}
    }
  },
  "if": {"properties": {"state": {"const": "available"}}},
  "then": {"properties": {"observations": {
    "minItems": 3,
    "items": {"properties": {"state": {"const": "available"}}}
  }}},
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "month": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "state", "nights", "provider_flag"],
      "properties": {
        "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        "state": {"enum": ["available", "unknown"]},
        "nights": {"type": ["integer", "null"], "minimum": 0, "maximum": 999999999999},
        "provider_flag": {"type": ["string", "null"], "pattern": "^[a-z ]{1,16}$"}
      },
      "if": {"properties": {"state": {"const": "available"}}},
      "then": {"properties": {"nights": {"type": "integer"}}},
      "else": {"properties": {"nights": {"type": "null"}}}
    }
  }
}
