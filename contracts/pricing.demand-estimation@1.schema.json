{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yieldcraft first-party demand estimation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "policy", "scenario", "exposure", "demand", "property", "product", "cohort", "started_at", "ended_at", "finalized_at", "ingested_at", "decision_at", "target_exposures", "available_room_nights", "marginal_cost_minor", "arms", "pools"],
  "properties": {
    "kind": {"const": "pricing.demand-estimation"},
    "version": {"const": 1},
    "id": {"$ref": "#/$defs/digest"},
    "policy": {"const": "yieldcraft.randomized-isotonic@1"},
    "scenario": {"$ref": "#/$defs/digest"},
    "exposure": {"$ref": "#/$defs/digest"},
    "demand": {"$ref": "#/$defs/digest"},
    "property": {"$ref": "#/$defs/label"},
    "product": {"$ref": "#/$defs/label"},
    "cohort": {"$ref": "#/$defs/label"},
    "started_at": {"$ref": "#/$defs/time"},
    "ended_at": {"$ref": "#/$defs/time"},
    "finalized_at": {"$ref": "#/$defs/time"},
    "ingested_at": {"$ref": "#/$defs/time"},
    "decision_at": {"$ref": "#/$defs/time"},
    "target_exposures": {"type": "integer", "minimum": 1, "maximum": 1000},
    "available_room_nights": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "marginal_cost_minor": {"$ref": "#/$defs/minor"},
    "arms": {
      "type": "array", "minItems": 2, "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["price_minor", "assigned", "kept", "cancelled", "nonpurchase"],
        "properties": {
          "price_minor": {"$ref": "#/$defs/minor"},
          "assigned": {"type": "integer", "minimum": 20, "maximum": 1000000},
          "kept": {"$ref": "#/$defs/count"},
          "cancelled": {"$ref": "#/$defs/count"},
          "nonpurchase": {"$ref": "#/$defs/count"}
        }
      }
    },
    "pools": {
      "type": "array", "minItems": 2, "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_start", "arm_end_exclusive", "kept", "assigned", "expected_room_nights_milli"],
        "properties": {
          "arm_start": {"type": "integer", "minimum": 0, "maximum": 63},
          "arm_end_exclusive": {"type": "integer", "minimum": 1, "maximum": 64},
          "kept": {"$ref": "#/$defs/pool_count"},
          "assigned": {"type": "integer", "minimum": 20, "maximum": 64000000},
          "expected_room_nights_milli": {"$ref": "#/$defs/count"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "label": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "minor": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "pool_count": {"type": "integer", "minimum": 0, "maximum": 64000000}
  }
}
