import grid as G;
import formula as F;
import program as P;
import std.io.TextIO as IO;
import std.os.OS_FileSys as FS;
import std.os.CommandLine as Env;
import std.collections.Array as A;
import std.Int as Int;
import std.tty.tty as Tty;

fn env(k:string) -> string { return Env.basis_command_line_get_env(k); }
fn read_file(path:string,max:i64) -> string {
  if !FS.basis_fs_exists(path) || FS.basis_fs_is_dir(path) { tool_fail("worksheet: missing input file"); }
  let n=FS.basis_fs_file_size(path);
  if n<0 || n>max { tool_fail("worksheet: input exceeds byte limit"); }
  let s=IO.basis_text_io_input_all(path);
  if text_len(s)!=n { tool_fail("worksheet: incomplete file or NUL byte"); } return s;
}
fn csv(b:G.Book) -> string {
  var nr=0; var nc=0; let buf=buffer_new();
  for id in 0 .. 1024 { if A.basis_array_sub(b["lengths"],id)>0 {
    nr=Int.max(nr,id/16+1); nc=Int.max(nc,id%16+1);
  } }
  for r in 0 .. nr { for c in 0 .. nc {
    if c!=0 { buffer_byte(buf,44); }
    let text=F.display(b,r*16+c); buffer_byte(buf,34);
    for i in 0 .. text_len(text) {
      let k=G.byte(text,i); if k==34 { buffer_byte(buf,34); } buffer_byte(buf,k);
    }
    buffer_byte(buf,34);
  } buffer_byte(buf,10); }
  return buffer_text(buf);
}
fn import_sheet(b:G.Book,s:string) {
  # Only the launcher's verified, bounded, unquoted Poindexter projection.
  let header="view,source_run,source_recommendation,source_valuation,currency,price_basis,current_minor,recommended_minor,change_minor,reason,published\n";
  if text_len(s)<=text_len(header) || text_slice(s,0,text_len(header))!=header
    || G.byte(s,text_len(s)-1)!=10 { tool_fail("worksheet: invalid pricing sheet"); }
  var start=0; var row=0; var col=0;
  for i in 0 .. text_len(s) {
    let c=G.byte(s,i);
    if c==44 || c==10 {
      if row>=2 || col>=11 || i==start { tool_fail("worksheet: invalid pricing row"); }
      let v=text_slice(s,start,i);
      if row==1 && col>=6 && col<=8 {
        let(st,n)=F.literal(v); if st!=1 { tool_fail("worksheet: expected integer cents"); } G.set(b,row*16+col,v);
      } else { G.set(b,row*16+col,text_concat("'",v)); }
      start=i+1; col=col+1;
      if c==10 { if col!=11 { tool_fail("worksheet: wrong pricing row width"); } row=row+1; col=0; }
    }
  }
  if row!=2 { tool_fail("worksheet: expected two pricing rows"); }
}
fn csv_field(s:string,start:i64) -> (string,i64) {
  let buf=buffer_new(); var i=start; var closed=false;
  let quoted=G.byte(s,start)==34;
  if quoted { i=i+1; }
  while i<text_len(s) {
    let c=G.byte(s,i);
    if quoted && c==34 {
      if G.byte(s,i+1)!=34 { closed=true; i=i+1; break; }
      buffer_byte(buf,34); i=i+2; continue;
    }
    if !quoted && (c==44 || c==10 || c==13) { break; }
    if c<32 || c>126 || c==34 { tool_fail("CSV import: expected printable single-line field"); }
    buffer_byte(buf,c); i=i+1;
    if i-start>386 { tool_fail("CSV import: field too long"); }
  }
  if quoted && !closed { tool_fail("CSV import: unterminated quoted field"); }
  return (buffer_text(buf),i);
}
fn import_values(b:G.Book,s:string) {
  if text_len(s)==0 { return; }
  var i=0; var row=0; var col=0;
  while true {
    if row>=64 || col>=16 { tool_fail("CSV import: exceeds grid dimensions"); }
    let(v,p)=csv_field(s,i); let(st,n)=F.literal(v);
    if st==1 && Int.to_string(n)==v { G.set(b,row*16+col,v); }
    else { if v!="" { G.set(b,row*16+col,text_concat("'",v)); } }
    if p==text_len(s) { break; }
    let sep=G.byte(s,p);
    if sep==44 { col=col+1; i=p+1; continue; }
    if sep==13 && G.byte(s,p+1)==10 { i=p+2; }
    else { if sep!=10 { tool_fail("CSV import: invalid separator"); } i=p+1; }
    if i==text_len(s) { break; } row=row+1; col=0;
  }
}
fn dim(k:string,lo:i64,hi:i64) -> i64 {
  let(ok,n)=Int.from_string(env(k)); if !ok { return lo; } return Int.min(Int.max(n,lo),hi);
}
fn field(buf:buffer,s:string,width:i64) {
  let n=text_len(s);
  if n>width { buffer_append(buf,text_slice(s,0,width-1)); buffer_byte(buf,126); }
  else { buffer_append(buf,s); for i in n .. width { buffer_byte(buf,32); } }
}
fn terminal_title(buf:buffer,id:i64) {
  # The trusted std.tty adapter returns plain text when styling is unavailable.
  let(status,title)=Tty.basis_tty_render(1,"POINDEXTER",1,6,-1,false);
  if status!=0 && status!=1 { tool_fail(text_concat("worksheet: terminal title render failed: ",Int.to_string(status))); }
  buffer_append(buf,title); buffer_append(buf,"   Worksheet");
  if env("PX_DIRTY")=="1" { buffer_append(buf," *"); }
  buffer_append(buf,"   |   "); buffer_append(buf,G.name(id)); buffer_append(buf,"\n\n");
}
fn frame(b:G.Book,id:i64,terminal:bool) {
  let rows=dim("PX_ROWS",1,32); let cols=dim("PX_COLS",1,16);
  let r0=id/16/rows*rows; let c0=id%16/cols*cols; let buf=buffer_new();
  if terminal { terminal_title(buf,id); }
  buffer_append(buf,"     ");
  for c in c0 .. Int.min(16,c0+cols) {
    buffer_append(buf,"| "); field(buf,text_slice("ABCDEFGHIJKLMNOP",c,c+1),12);
  }
  buffer_byte(buf,10);
  for r in r0 .. Int.min(64,r0+rows) {
    field(buf,Int.to_string(r+1),5);
    for c in c0 .. Int.min(16,c0+cols) {
      let i=r*16+c;
      if i==id { buffer_append(buf,"|>"); } else { buffer_append(buf,"| "); }
      field(buf,F.display(b,i),12);
    }
    buffer_byte(buf,10);
  }
  buffer_append(buf,"\n"); buffer_append(buf,G.name(id)); buffer_append(buf,"  fx: ");
  buffer_append(buf,G.raw(b,id)); buffer_append(buf,"\nValue: "); buffer_append(buf,F.display(b,id));
  buffer_byte(buf,10); IO.basis_text_io_print(buffer_text(buf));
}
fn main() -> i64 {
  let b=G.create();
  G.load(b,read_file(env("PX_BOOK"),210000));
  let mode=env("PX_OP"); let id=G.addr(env("PX_CELL"));
  if id<0 { tool_fail("worksheet: address must be A1:P64"); }
  if mode=="frame" || mode=="terminal_frame" { frame(b,id,mode=="terminal_frame"); }
  if mode=="get" { println(F.display(b,id)); }
  if mode=="raw" { println(G.raw(b,id)); }
  if mode=="csv" { IO.basis_text_io_print(csv(b)); }
  if mode=="edit" || mode=="paste" || mode=="script" || mode=="import" || mode=="importcsv" || mode=="check" {
    if mode=="edit" { G.set(b,id,env("PX_VALUE")); }
    if mode=="paste" {
      let from_id=G.addr(env("PX_FROM")); if from_id<0 { tool_fail("worksheet: invalid clipboard"); }
      G.set(b,id,F.relocate(env("PX_VALUE"),from_id,id));
    }
    if mode=="script" { P.run(b,read_file(env("PX_DATA"),33000)); }
    if mode=="import" { import_sheet(b,read_file(env("PX_DATA"),512)); }
    if mode=="importcsv" { import_values(b,read_file(env("PX_DATA"),210000)); }
    IO.basis_text_io_print(G.encode(b));
  } else { if mode!="get" && mode!="raw" && mode!="csv" && mode!="frame" && mode!="terminal_frame" { tool_fail("worksheet: unknown operation"); } }
  G.close(b); return 0;
}
