import plugins.caravansary.planning.json as J;
import plugins.caravansary.planning.host as Host;
import plugins.caravansary.coverage.clock as Clock;
from plugins.caravansary.stdlib.booking.fixture import booking_provider;
from plugins.caravansary.stdlib.agoda.fixture import agoda_provider;
from plugins.caravansary.stdlib.provider.api import FixtureGrant, FixtureIntent, run_provider;
fn provider_error(code: string) -> sexpr
{
  return J.object(sx_cons(
    J.pair("kind", sx_string("provider-error/v1")),
    sx_cons(J.pair("code", sx_string(code)), sx_nil())
  ));
}

fn request_text(request: sexpr, key: string) -> string
{
  let value = J.get(request, key);
  if sx_kind(value) == 2
  {
    return sx_text(value);
  }
  return "";
}

fn known_fields(request: sexpr) -> bool
{
  var fields = sx_tail(request);
  while sx_kind(fields) == 3
  {
    let key = sx_text(sx_head(sx_head(fields)));
    if key != "kind" && key != "mode" && key != "provider" && key != "operation" && key != "fixture_id" && key != "source_url" && key != "observed_at" && key != "elvi_source"
    {
      return false;
    }
    fields = sx_tail(fields);
  }
  return sx_kind(fields) == 0;
}

fn run_fixture(request: sexpr, html: string, grant: FixtureGrant) -> sexpr
{
  if request_text(request, "kind") != "provider-request/v1"
  {
    return provider_error("invalid-request");
  }
  if request_text(request, "mode") != "fixture"
  {
    return provider_error("unsupported-mode");
  }
  if ! known_fields(request)
  {
    return provider_error("unsupported-request-field");
  }
  let operation = request_text(request, "operation");
  if operation != "profile" && operation != "candidates"
  {
    return provider_error("unsupported-operation");
  }
  let name = request_text(request, "provider");
  let provider = match name with
  {
    "booking" => booking_provider(operation), "agoda" => agoda_provider(operation), _ =>
    {
      return provider_error("unsupported-provider");
    }
  };
  let clock = request_text(request, "observed_at");
  match Clock.parse(clock, "observed_at") with
  {
    Ok(_) =>
    {
    }, Err(_) =>
    {
      return provider_error("invalid-observed-at");
    }
  };
  let source = request_text(request, "elvi_source");
  if sx_kind(J.get(request, "elvi_source")) != 0 && source == ""
  {
    return provider_error("invalid-elvi");
  }
  let url = request_text(request, "source_url");
  let id = request_text(request, "fixture_id");
  let intent = record<FixtureIntent>
  { fixture_id : id
  , source_url : url
  , elvi_source: source
  };
  let result = match run_provider(provider, intent, grant, html) with
  {
    Ok(facts) => facts, Err(code) =>
    {
      return provider_error(code);
    }
  };
  let provenance = J.object(sx_cons(
    J.pair("qualification", sx_string("fictional-frozen-html")),
    sx_cons(
      J.pair("fixture_id", sx_string(id)),
      sx_cons(
        J.pair("source_url", sx_string(url)),
        sx_cons(
          J.pair("observed_at", sx_string(clock)),
          sx_cons(
            J.pair("extractor", sx_string("${name}-fixture/v1")),
            sx_cons(
              J.pair(
                "content_sha256",
                sx_string(Host.caravansary_sha256(html))
              ),
              sx_nil()
            )
          )
        )
      )
    )
  ));
  return J.object(sx_cons(
    J.pair("kind", sx_string("provider-observation/v1")),
    sx_cons(
      J.pair("provider", sx_string(name)),
      sx_cons(
        J.pair("operation", sx_string(operation)),
        sx_cons(
          J.pair("provenance", provenance),
          sx_cons(J.pair("properties", result["properties"]), sx_nil())
        )
      )
    )
  ));
}
