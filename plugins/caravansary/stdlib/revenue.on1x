# Expected contribution from explicit, separate first-party inputs. No demand
# curve, bookings, variable costs or net rates are inferred from market data.
from plugins.caravansary.planning import json as Json, civil as Civil;
from . import price_values as V, price as Price;
fn abstain(fields: sexpr, reason: string) -> sexpr
{
  return Json.object(V.put_text(
    V.put_text(fields, "status", "abstained"),
    "reason",
    reason
  ));
}

fn base() -> sexpr
{
  return V.put_text(sx_nil(), "kind", "caravansary.expected-contribution@1");
}

fn round_minor(milli_minor: i64) -> i64
{
  if milli_minor < 0
  {
    return - ((- milli_minor + 500) / 1000);
  }
  return (milli_minor + 500) / 1000;
}

fn expected(inputs: sexpr) -> sexpr
{
  var fields = base();
  let qual = V.text(inputs, "qualification");
  let property = V.text(inputs, "property_id");
  let scope = Json.get(inputs, "scope");
  let(has_assessed, assessed) = V.instant(V.text(
    inputs,
    "assumptions_available_at"
  ));
  let(has_cutoff, cutoff) = V.instant(V.text(inputs, "as_of"));
  let gross = V.number(inputs, "gross_stay_minor", V.money_cap());
  let net = V.number(inputs, "net_revenue_per_consumed_stay_minor", 1000000000);
  let cost = V.number(
    inputs,
    "variable_cost_per_consumed_stay_minor",
    1000000000
  );
  let available = V.number(inputs, "available_stays", 1000000);
  let bookings_milli = V.number(
    inputs,
    "expected_consumed_stays_milli",
    1000000000
  );
  if V.text(
    inputs,
    "kind"
  ) != "caravansary.first-party-contribution-input@1" || V.text(
    inputs,
    "provenance"
  ) != "first_party" || ! Price.qualification(qual) || property == "" || ! Price.valid_scope(scope) || V.text(
    scope,
    "price_basis"
  ) != "stay_total" || ! has_assessed || ! has_cutoff || gross < 1 || net < 0 || net > gross || cost < 0 || available < 0 || bookings_milli < 0 || bookings_milli > 1000 * available
  {
    return abstain(fields, "invalid_first_party_assumptions");
  }
  fields = V.put_text(fields, "qualification", qual);
  fields = V.put_text(fields, "property_id", property);
  fields = V.put(fields, "scope", scope);
  fields = V.put_text(fields, "as_of", Civil.utc_text(cutoff));
  if assessed > cutoff
  {
    return abstain(fields, "assumptions_not_yet_available");
  }
  if Civil.date(V.text(scope, "checkin")) < V.utc_day(cutoff)
  {
    return abstain(fields, "stay_already_started");
  }
  fields = V.put_text(
    fields,
    "assumptions_available_at",
    Civil.utc_text(assessed)
  );
  fields = V.put_int(fields, "gross_stay_minor", gross);
  fields = V.put_int(fields, "available_stays", available);
  fields = V.put_int(fields, "expected_consumed_stays_milli", bookings_milli);
  fields = V.put_int(fields, "net_revenue_per_consumed_stay_minor", net);
  fields = V.put_int(fields, "variable_cost_per_consumed_stay_minor", cost);
  fields = V.put_int(
    fields,
    "expected_contribution_minor",
    round_minor((net - cost) * bookings_milli)
  );
  return Json.object(V.put_text(fields, "status", "computed"));
}

# Only join a recommendation to a separate price-specific scenario. Merely
# supplying a market position never supplies/invents first-party economics.
fn for_position(position: sexpr, inputs: sexpr) -> sexpr
{
  if V.text(position, "kind") != "caravansary.position@1" || V.text(
    position,
    "status"
  ) != "recommended"
  {
    return abstain(base(), "position_not_recommended");
  }
  if V.text(position, "recommendation_unit") != "nightly"
  {
    return abstain(base(), "unsupported_position_unit");
  }
  let scenario = expected(inputs);
  if V.text(scenario, "status") != "computed"
  {
    return scenario;
  }
  let(has_clock, at) = V.instant(V.text(position, "as_of"));
  let(_has_cutoff, cutoff) = V.instant(V.text(scenario, "as_of"));
  let amount = V.number(position, "recommended_minor", V.money_cap());
  let scope = Json.get(position, "scope");
  let checkin = Civil.date(V.text(scope, "checkin"));
  let checkout = Civil.date(V.text(scope, "checkout"));
  if ! has_clock || at != cutoff || amount != V.number(
    scenario,
    "gross_stay_minor",
    V.money_cap()
  ) || V.text(position, "subject_property_id") != V.text(
    scenario,
    "property_id"
  ) || V.text(position, "qualification") != V.text(
    scenario,
    "qualification"
  ) || checkin == 0 || checkout != checkin + 1 || Json.render(scope) != Json.render(Json.get(
    scenario,
    "scope"
  ))
  {
    return abstain(base(), "scenario_does_not_match_position");
  }
  return Json.replace(scenario, "linked_to_position", Json.boolean(true));
}
