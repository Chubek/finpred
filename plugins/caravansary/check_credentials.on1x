import plugins.caravansary.credentials as Credentials;
import plugins.caravansary.planning.json as Json;
fn resolved(result: Result < Credentials.Resolution,
  sexpr >) -> Credentials.Resolution
{
  match result with
  {
    Ok(value) =>
    {
      return value;
    }, Err(reason) =>
    {
      tool_fail(sx_text(reason));
    }
  };
  return record < Credentials.Resolution >
  {
    mode: sx_nil(), values: sx_nil(), cookies: sx_nil()
  };
}

fn denied(result: Result < Credentials.Resolution, sexpr >) -> bool
{
  return match result with
  {
    Ok(_) => false, Err(_) => true
  };
}

fn files(kind: string, path: string, source: string, body: string) -> sexpr
{
  let paths = Json.object(sx_cons(Json.pair(path, sx_string(body)), sx_nil()));
  let kinds = Json.object(sx_cons(Json.pair(kind, paths), sx_nil()));
  return Json.object(sx_cons(Json.pair(source, kinds), sx_nil()));
}

fn main() -> i64
{
  let cards = Json.parse("{\"sources\":[\"booking\",\"agoda\"],\"credentials\":{\"booking\":{\"cookies\":\"sample.json\"},\"agoda\":{\"environment\":[\"SITE\",\"TOKEN\"],\"dotenv\":\".env\"}}}");
  let supplied = Json.parse("{\"TOKEN\":\"fictional-operator-override\"}");
  let dotenv = files("dotenv",
    ".env",
    "agoda",
    "export SITE='fictional site'\r\nTOKEN=\"a\\u0062\"  # ignored\nOTHER=\${NOT_EXPANDED}\n");
  let access = resolved(Credentials.resolve(cards,
    "agoda",
    supplied,
    sx_nil(),
    dotenv));
  assert(sx_text(access["mode"]) == "environment");
  assert(Json.text(Json.get(access["values"], "SITE")) == "fictional site");
  assert(Json.text(Json.get(access["values"],
    "TOKEN")) == "fictional-operator-override");
  assert(sx_kind(Json.get(access["values"], "OTHER")) == 0);
  assert(denied(Credentials.resolve(cards,
    "agoda",
    supplied,
    sx_nil(),
    sx_nil())));
  let duplicate = files("dotenv", ".env", "agoda", "SITE=x\nSITE=y");
  assert(denied(Credentials.resolve(cards,
    "agoda",
    supplied,
    sx_nil(),
    duplicate)));
  let cookie = "{\"name\":\"__Host-fixture\",\"value\":\"fictional\",\"domain\":\"BOOKING.COM\",\"path\":\"/\",\"secure\":true,\"sameSite\":\"Lax\"}";
  let allowed = files("cookies",
    "sample.json",
    "booking",
    format("[{}]",
    cookie));
  let result = resolved(Credentials.resolve(cards,
    "booking",
    sx_nil(),
    sx_nil(),
    allowed));
  assert(sx_text(result["mode"]) == "cookies");
  let row = sx_head(Json.items(result["cookies"]));
  assert(Json.text(Json.get(row, "domain")) == "booking.com");
  let misplaced = files("cookies",
    "other.json",
    "booking",
    format("[{}]",
    cookie));
  assert(denied(Credentials.resolve(cards,
    "booking",
    sx_nil(),
    sx_nil(),
    misplaced)));
  let repeats = files("cookies",
    "sample.json",
    "booking",
    format("[{},{}]",
    cookie,
    cookie));
  assert(denied(Credentials.resolve(cards,
    "booking",
    sx_nil(),
    sx_nil(),
    repeats)));
  let bad_host = files("cookies",
    "sample.json",
    "booking",
    "[{\"name\":\"x\",\"value\":\"fixture\",\"domain\":\"evil.example\",\"path\":\"/\",\"secure\":true,\"sameSite\":\"Lax\"}]");
  assert(denied(Credentials.resolve(cards,
    "booking",
    sx_nil(),
    sx_nil(),
    bad_host)));
  let explicit = Json.parse("{\"sources\":[\"booking\"],\"credentials\":{\"booking\":{\"explicit\":[\"user\"]}}}");
  let values = Json.parse("{\"user\":\"fictional\"}");
  let direct = resolved(Credentials.resolve(explicit,
    "booking",
    sx_nil(),
    values,
    sx_nil()));
  assert(sx_text(direct["mode"]) == "explicit");
  let none = Json.parse("{\"sources\":[\"booking\"]}");
  assert(sx_text(resolved(Credentials.resolve(none,
    "booking",
    sx_nil(),
    sx_nil(),
    sx_nil()))["mode"]) == "none");
  println("caravansary On1x credential resolver: OK");
  return 0;
}
