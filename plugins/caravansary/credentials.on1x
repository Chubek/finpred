# A host-only resolver over an already validated CaravanScript configuration.
# None of these functions read files, consult the environment or make requests.
import plugins.caravansary.planning.json as Json;
import plugins.caravansary.coverage.index as Index;
import plugins.caravansary.coverage.values as Values;
import plugins.caravansary.metrics.json_wire as Wire;
import std.String as Str;
import std.sexpr.sexpr as Sx;
record Resolution
{
  mode: sexpr, values: sexpr, cookies: sexpr
}

fn invalid(message: string) -> Result < Resolution, sexpr >
{
  return result_error(sx_string(message));
}

fn clean(text: string) -> bool
{
  var i = 0;
  let size = text_len(text);
  while i < size
  {
    let(c, end) = Wire.utf8(text, i);
    if c <= 0
    {
      return false;
    }
    i = end;
  }
  return true;
}

fn alpha(c: i64) -> bool
{
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

fn digit(c: i64) -> bool
{
  return c >= 48 && c <= 57;
}

fn space(c: i64) -> bool
{
  return c == 9 || c == 32;
}

fn skip_space(text: string, start: i64) -> i64
{
  var i = start;
  while i < text_len(text) && space(text_byte(text, i))
  {
    i = i + 1;
  }
  return i;
}

fn upper_to_lower(text: string) -> string
{
  let out = buffer_new();
  for i in 0 .. text_len(text)
  {
    let c = text_byte(text, i);
    if c >= 65 && c <= 90
    {
      buffer_byte(out, c + 32);
    }
    else
    {
      buffer_byte(out, c);
    }
  }
  return buffer_text(out);
}

fn cookie_text(value: sexpr, role: string) ->(bool, string)
{
  if sx_kind(value) != 2
  {
    return (false, "");
  }
  let text = sx_text(value);
  let size = text_len(text);
  if role == "name"
  {
    if size == 0 || size > 128
    {
      return (false, "");
    }
  }
  if role == "path"
  {
    if size == 0 || size > 1024 || text_byte(text, 0) != 47
    {
      return (false, "");
    }
  }
  if role == "value" && size > 2048
  {
    return (false, "");
  }
  for i in 0 .. size
  {
    let c = text_byte(text, i);
    if role == "name"
    {
      if ! alpha(c) && ! digit(c) && ! Str.contains("!#$%&'*+-.^_`|~",
        text_slice(text,
        i,
        i + 1))
      {
        return (false, "");
      }
    }
    if role == "path" && (c < 33 || c > 126 || c == 35 || c == 59 || c == 63 || c == 92)
    {
      return (false, "");
    }
    if role == "value" && (c < 33 || c > 126 || c == 34 || c == 44 || c == 59 || c == 92)
    {
      return (false, "");
    }
  }
  return (true, text);
}

fn cookie_domain(value: sexpr, host: string, host_only: bool) -> string
{
  if sx_kind(value) != 2
  {
    return "";
  }
  let input = sx_text(value);
  let length = text_len(input);
  if length == 0 || length > 253
  {
    return "";
  }
  var domain = upper_to_lower(input);
  if ! host_only && text_byte(domain, 0) == 46
  {
    domain = text_slice(domain, 1, length);
  }
  if domain == host
  {
    return domain;
  }
  if ! host_only && host == "www.agoda.com" && domain == "agoda.com"
  {
    return domain;
  }
  return "";
}

fn cookie(value: sexpr, host: string) -> sexpr
{
  if Json.kind(value) != "object"
  {
    return sx_nil();
  }
  var fields = sx_tail(value);
  while sx_kind(fields) == 3
  {
    let key = sx_text(sx_head(sx_head(fields)));
    if key != "name" && key != "value" && key != "domain" && key != "path" && key != "secure" && key != "sameSite" && key != "hostOnly" && key != "expires"
    {
      return sx_nil();
    }
    fields = sx_tail(fields);
  }
  let(name_ok, name) = cookie_text(Json.get(value, "name"), "name");
  let(value_ok, _) = cookie_text(Json.get(value, "value"), "value");
  let(path_ok, path) = cookie_text(Json.get(value, "path"), "path");
  let secure = Json.get(value, "secure");
  let site = Values.plain(Json.get(value, "sameSite"));
  var host_only = Json.get(value, "hostOnly");
  if sx_kind(host_only) == 0
  {
    host_only = sx_symbol("true");
  }
  var expires = Json.get(value, "expires");
  if sx_kind(expires) == 0
  {
    expires = Json.null_value();
  }
  if ! name_ok || ! value_ok || ! path_ok || ! Values.is_bool(secure) || ! Values.is_bool(host_only) || (site != "Strict" && site != "Lax" && site != "None")
  {
    return sx_nil();
  }
  if ! Values.is_null(expires)
  {
    let(ok, n) = Values.as_i64(expires);
    if ! ok || n < - 253402300799 || n > 253402300799
    {
      return sx_nil();
    }
  }
  let prefix = upper_to_lower(name);
  if (site == "None" || Str.is_prefix("__secure-",
    prefix)) && ! Values.truth(secure)
  {
    return sx_nil();
  }
  if Str.is_prefix("__host-",
    prefix) && (! Values.truth(secure) || ! Values.truth(host_only) || path != "/")
  {
    return sx_nil();
  }
  let domain = cookie_domain(Json.get(value,
    "domain"),
    host,
    Values.truth(host_only));
  if domain == ""
  {
    return sx_nil();
  }
  return Json.replace(Json.replace(Json.replace(value,
    "domain",
    sx_string(domain)),
    "hostOnly",
    host_only),
    "expires",
    expires);
}

fn same_cookie(a: sexpr, b: sexpr) -> bool
{
  return Values.plain(Json.get(a,
    "name")) == Values.plain(Json.get(b,
    "name")) && Values.plain(Json.get(a,
    "domain")) == Values.plain(Json.get(b,
    "domain")) && Values.plain(Json.get(a,
    "path")) == Values.plain(Json.get(b,
    "path"));
}

fn cookies(text: string, host: string) -> Result < Resolution, sexpr >
{
  let parsed = Values.parse(text);
  var document = sx_nil();
  match parsed with
  {
    Ok(value) =>
    {
      document = value;
    }, Err(_) =>
    {
      return invalid("invalid Cookie JSON v1 document");
    }
  };
  if Json.kind(document) != "array" || Sx.sexpr_size(sx_tail(document)) > 64
  {
    return invalid("Cookie JSON v1 must be an array of at most 64 cookies");
  }
  var input = sx_tail(document);
  var rows = sx_nil();
  var position = 0;
  while sx_kind(input) == 3
  {
    position = position + 1;
    let row = cookie(sx_head(input), host);
    if sx_kind(row) == 0
    {
      return invalid(format("invalid Cookie JSON v1 entry {}", position));
    }
    var rest = rows;
    while sx_kind(rest) == 3
    {
      if same_cookie(row, sx_head(rest))
      {
        return invalid(format("duplicate Cookie JSON v1 identity at entry {}",
          position));
      }
      rest = sx_tail(rest);
    }
    rows = sx_cons(row, rows);
    input = sx_tail(input);
  }
  return result_ok(record < Resolution >
  {
    mode: sx_symbol("cookies"), values: Json.object(sx_nil()), cookies: Json.array(Sx.sexpr_reverse(rows))
  });
}

fn bad_line(number: i64) -> sexpr
{
  return sx_string(format("invalid or duplicate dotenv assignment on line {}",
    number));
}

fn dotenv_value(text: string,
  start: i64,
  number: i64) -> Result < sexpr, sexpr >
{
  let size = text_len(text);
  if start == size
  {
    return result_ok(sx_string(""));
  }
  let delimiter = text_byte(text, start);
  var end = start;
  var value = sx_nil();
  if delimiter == 39
  {
    end = start + 1;
    while end < size && text_byte(text, end) != 39
    {
      end = end + 1;
    }
    if end == size
    {
      return result_error(bad_line(number));
    }
    value = sx_string(text_slice(text, start + 1, end));
    end = end + 1;
  }
  if delimiter == 34
  {
    match Wire.quoted(text, start, true) with
    {
      Ok((raw, after)) =>
      {
        end = after;
        match Values.parse(sx_text(raw)) with
        {
          Ok(decoded) =>
          {
            value = decoded;
          }, Err(_) =>
          {
            return result_error(bad_line(number));
          }
        };
      }, Err(_) =>
      {
        return result_error(bad_line(number));
      }
    };
  }
  if delimiter == 34 || delimiter == 39
  {
    let next = skip_space(text, end);
    if next != size && text_byte(text, next) != 35
    {
      return result_error(bad_line(number));
    }
    return result_ok(value);
  }
  var comment = start;
  while comment < size
  {
    if text_byte(text,
      comment) == 35 && (comment == start || space(text_byte(text,
      comment - 1)))
    {
      break;
    }
    comment = comment + 1;
  }
  while comment > start && space(text_byte(text, comment - 1))
  {
    comment = comment - 1;
  }
  return result_ok(sx_string(text_slice(text, start, comment)));
}

fn dotenv_line(text: string, number: i64) -> Result < sexpr, sexpr >
{
  let size = text_len(text);
  var start = skip_space(text, 0);
  for i in start .. size
  {
    let c = text_byte(text, i);
    if c < 32 && c != 9
    {
      return result_error(bad_line(number));
    }
  }
  if start == size || text_byte(text, start) == 35
  {
    return result_ok(sx_nil());
  }
  if start + 6 < size && text_slice(text,
    start,
    start + 6) == "export" && space(text_byte(text,
    start + 6))
  {
    start = skip_space(text, start + 6);
  }
  if start == size || (! alpha(text_byte(text,
    start)) && text_byte(text,
    start) != 95)
  {
    return result_error(bad_line(number));
  }
  var end = start + 1;
  while end < size
  {
    let c = text_byte(text, end);
    if ! alpha(c) && ! digit(c) && c != 95
    {
      break;
    }
    end = end + 1;
  }
  let key = text_slice(text, start, end);
  let equal = skip_space(text, end);
  if equal == size || text_byte(text, equal) != 61
  {
    return result_error(bad_line(number));
  }
  let value = dotenv_value(text, skip_space(text, equal + 1), number)?;
  return result_ok(Json.pair(key, value));
}

fn dotenv(text: string) -> Result < sexpr, sexpr >
{
  if ! clean(text)
  {
    return result_error(sx_string("dotenv must be UTF-8 text"));
  }
  let size = text_len(text);
  var start = 0;
  var number = 1;
  var fields = sx_nil();
  var seen = sx_nil();
  while start < size
  {
    var end = start;
    while end < size && text_byte(text, end) != 10
    {
      end = end + 1;
    }
    var stop = end;
    if end < size && end > start && text_byte(text, end - 1) == 13
    {
      stop = stop - 1;
    }
    let assignment = dotenv_line(text_slice(text, start, stop), number)?;
    if sx_kind(assignment) != 0
    {
      let key = sx_text(sx_head(assignment));
      if sx_kind(Index.get(seen, key)) != 0
      {
        return result_error(bad_line(number));
      }
      seen = Index.put(seen, key, sx_symbol("seen"));
      fields = sx_cons(assignment, fields);
    }
    start = end + 1;
    number = number + 1;
  }
  return result_ok(Json.object(fields));
}

fn contains_source(sources: sexpr, source: string) -> bool
{
  if Json.kind(sources) != "array"
  {
    return false;
  }
  var rest = Json.items(sources);
  while sx_kind(rest) == 3
  {
    if Values.plain(sx_head(rest)) == source
    {
      return true;
    }
    rest = sx_tail(rest);
  }
  return false;
}

fn approved_text(approved: sexpr,
  source: string,
  kind: string,
  path: sexpr) -> Result < sexpr, sexpr >
{
  let value = Json.get(Json.get(Json.get(approved,
    source),
    kind),
    Values.plain(path));
  if sx_kind(value) != 2 || text_len(sx_text(value)) > 65536
  {
    return result_error(sx_string(format("{} {} requires host-approved bytes (max 64 KiB)",
      source,
      kind)));
  }
  return result_ok(value);
}

# Approved files are objects indexed by source, file kind, and exact declared
# path. No declaration is interpreted as ambient authority; `environ` and
# `explicit` are maps already filtered by the operator.
fn resolve(config: sexpr,
  source: string,
  environ: sexpr,
  explicit: sexpr,
  approved: sexpr) -> Result < Resolution, sexpr >
{
  if (source != "booking" && source != "agoda") || ! contains_source(Json.get(config,
    "sources"),
    source)
  {
    return invalid("credentials require a known selected source");
  }
  let decl = Json.get(Json.get(config, "credentials"), source);
  if sx_kind(decl) == 0
  {
    return result_ok(record < Resolution >
    {
      mode: sx_symbol("none"), values: Json.object(sx_nil()), cookies: Json.array(sx_nil())
    });
  }
  let cookie_file = Json.get(decl, "cookies");
  if sx_kind(cookie_file) != 0
  {
    let bytes = approved_text(approved, source, "cookies", cookie_file)?;
    var host = "booking.com";
    if source == "agoda"
    {
      host = "www.agoda.com";
    }
    return cookies(sx_text(bytes), host);
  }
  var mode = "environment";
  var supplied = environ;
  if sx_kind(Json.get(decl, "explicit")) != 0
  {
    mode = "explicit";
    supplied = explicit;
  }
  if sx_kind(supplied) != 0 && Json.kind(supplied) != "object"
  {
    return invalid("credential host values must be an object");
  }
  let dotenv_file = Json.get(decl, "dotenv");
  var fallback = Json.object(sx_nil());
  if sx_kind(dotenv_file) != 0
  {
    let bytes = approved_text(approved, source, "dotenv", dotenv_file)?;
    fallback = dotenv(sx_text(bytes))?;
  }
  var rest = Json.items(Json.field(decl, mode));
  var names = sx_nil();
  while sx_kind(rest) == 3
  {
    let name = Json.text(sx_head(rest));
    var value = Json.get(supplied, name);
    if sx_kind(value) == 0
    {
      value = Json.get(fallback, name);
    }
    if sx_kind(value) != 2 || sx_text(value) == "" || ! clean(sx_text(value))
    {
      return invalid(format("{} has a missing or invalid {} credential",
        source,
        mode));
    }
    names = sx_cons(Json.pair(name, value), names);
    rest = sx_tail(rest);
  }
  return result_ok(record < Resolution >
  {
    mode: sx_symbol(mode), values: Json.object(names), cookies: Json.array(sx_nil())
  });
}
