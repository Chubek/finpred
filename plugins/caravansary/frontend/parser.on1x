import frontend.schema as Schema;
import frontend.text as Text;
import frontend.tokens as Tokens;
import frontend.transform as Transform;
import frontend.market as Market;
import frontend.pure as Pure;
fn scalar(input: Tokens.Stream, at: i64, out: buffer) ->(sexpr, string)
{
  let raw = Tokens.token(input, at);
  if raw == ""
  {
    return (sx_nil(), Tokens.error(input, at, "expected a string or integer"));
  }
  if text_byte(raw, 0) == 34
  {
    let(decoded, ok) = Text.decode_string(raw);
    if ! ok
    {
      return (sx_nil(), Tokens.error(input, at, "unpaired Unicode surrogate"));
    }
    buffer_append(out, raw);
    return (sx_cons(sx_symbol("text"),
      sx_cons(sx_string(decoded),
      sx_nil())),
      "");
  }
  if ! Text.digit(text_byte(raw, 0))
  {
    return (sx_nil(), Tokens.error(input, at, "expected a string or integer"));
  }
  if text_len(raw) > 1 && text_byte(raw, 0) == 48
  {
    return (sx_nil(),
      Tokens.error(input,
      at,
      "integer cannot have leading zeros"));
  }
  if text_len(raw) > 4300
  {
    return (sx_nil(), Tokens.error(input, at, "integer is too large"));
  }
  buffer_append(out, raw);
  return (sx_cons(sx_symbol("int"), sx_cons(sx_string(raw), sx_nil())), "");
}

fn value(input: Tokens.Stream, at: i64, out: buffer) ->(sexpr, i64, string)
{
  if Tokens.token(input, at) != "["
  {
    let(item, err) = scalar(input, at, out);
    return (item, at + 1, err);
  }
  buffer_append(out, "[");
  var i = at + 1;
  var items = sx_nil();
  while Tokens.token(input, i) != "]"
  {
    let(item, err) = scalar(input, i, out);
    if err != ""
    {
      return (sx_nil(), i, err);
    }
    items = sx_cons(item, items);
    i = i + 1;
    if Tokens.token(input, i) == "]"
    {
      break;
    }
    if Tokens.token(input, i) != ","
    {
      return (sx_nil(), i, Tokens.error(input, i, "expected , or ]"));
    }
    buffer_append(out, ",");
    i = i + 1;
  }
  buffer_append(out, "]");
  return (sx_cons(sx_symbol("array"), items), i + 1, "");
}

fn statements(input: Tokens.Stream,
  start: i64,
  role: string,
  out: buffer) ->(sexpr,
  i64,
  string)
{
  var context = role;
  if role == "booking" || role == "agoda"
  {
    context = text_concat("credentials.", role);
  }
  if role == "source_decl"
  {
    context = "target source";
  }
  if role == "extractor_decl"
  {
    context = "extractor";
  }
  var i = start;
  var values = sx_nil();
  var named_count = 0;
  buffer_append(out, "{");
  while i < input["count"] && Tokens.token(input, i) != "}"
  {
    let key = Tokens.token(input, i);
    if Schema.has(values, key)
    {
      return (sx_nil(),
        i,
        Tokens.error(input,
        i,
        text_concat("duplicate field or block in ",
        context)));
    }
    var shape = Schema.field_kind(role, key);
    if shape == ""
    {
      shape = Market.field_kind(role, key);
    }
    if shape == ""
    {
      return (sx_nil(),
        i,
        Tokens.error(input,
        i,
        text_concat("unknown field or block in ",
        context)));
    }
    if Market.named(role)
    {
      if named_count == 64
      {
        return (sx_nil(),
          i,
          Tokens.error(input,
          i,
          text_concat(context,
          " exceeds 64 declarations")));
      }
      named_count = named_count + 1;
      if ! Market.identifier(key, false)
      {
        return (sx_nil(),
          i,
          Tokens.error(input,
          i,
          "expected a named block identifier of at most 64 bytes"));
      }
      if role == "modules"
      {
        let name_error = Transform.pure_name_error(input, i, key);
        if name_error != ""
        {
          return (sx_nil(), i, name_error);
        }
      }
    }
    if sx_kind(values) != 0
    {
      buffer_append(out, ",");
    }
    Text.quoted_ascii(out, key);
    buffer_append(out, ":");
    if shape == "field"
    {
      if Tokens.token(input, i + 1) != "="
      {
        return (sx_nil(), i, Tokens.error(input, i + 1, "expected ="));
      }
      let(item, after, err) = value(input, i + 2, out);
      if err != ""
      {
        return (sx_nil(), after, err);
      }
      if Tokens.token(input, after) != ";"
      {
        return (sx_nil(), after, Tokens.error(input, after, "expected ;"));
      }
      values = Schema.entry(values, key, item);
      i = after + 1;
    }
    else
    {
      if Tokens.token(input, i + 1) != "{"
      {
        return (sx_nil(), i, Tokens.error(input, i + 1, "expected {"));
      }
      if shape == "transform" || shape == "pure"
      {
        let(program,
          after,
          err) = Transform.declarations(input,
          i + 2,
          shape == "pure");
        if err != ""
        {
          return (sx_nil(), after, err);
        }
        Transform.render(out, program);
        values = Schema.entry(values, key, program);
        i = after;
      }
      else
      {
        var next_role = shape;
        if shape == "block"
        {
          next_role = key;
        }
        let(body, after, err) = statements(input, i + 2, next_role, out);
        if err != ""
        {
          return (sx_nil(), after, err);
        }
        values = Schema.entry(values, key, body);
        i = after;
      }
    }
  }
  buffer_append(out, "}");
  if role == "script"
  {
    return (values, i, "");
  }
  return (values, i + 1, "");
}

fn parse(source: buffer, mode: string) ->(string, sexpr, string)
{
  let(input, syntax_error) = Tokens.stream(source);
  if sx_kind(input["text"]) == 0
  {
    return ("", sx_nil(), syntax_error);
  }
  let out = buffer_new();
  let(config, _, lowering_error) = statements(input, 0, "script", out);
  if lowering_error != ""
  {
    return ("", sx_nil(), lowering_error);
  }
  if syntax_error != ""
  {
    return ("", sx_nil(), syntax_error);
  }
  if Market.present(config)
  {
    if mode == "legacy"
    {
      return ("", sx_nil(), "market CaravanScript requires the market host");
    }
    let config_error = Market.validate(config);
    if config_error != ""
    {
      return ("", sx_nil(), config_error);
    }
    let(linked, function_error) = Pure.link(config);
    if function_error != ""
    {
      return ("", sx_nil(), function_error);
    }
    return (buffer_text(out), linked, "");
  }
  if mode == "market"
  {
    return ("", sx_nil(), "expected market CaravanScript sections");
  }
  let config_error = Schema.validate(config);
  if config_error != ""
  {
    return ("", sx_nil(), config_error);
  }
  if mode != "legacy" && Schema.has(config, "transform")
  {
    let transform_error = Transform.check(Schema.get(config, "transform"));
    if transform_error != ""
    {
      return ("", sx_nil(), transform_error);
    }
  }
  return (buffer_text(out), sx_nil(), "");
}

# Parse, validate, and statically check a script without loading its referenced
# files or inspecting credentials. Diagnostics never include source excerpts.
fn parse_script(source: buffer) ->(string, string)
{
  let(config, _, err) = parse(source, "either");
  return (config, err);
}

# Legacy metrics hosts may defer transform type checks to their compiler.
# This entry point fails closed for market scripts.
fn parse_script_syntax(source: buffer) ->(string, string)
{
  let(config, _, err) = parse(source, "legacy");
  return (config, err);
}

fn parse_market_script(source: buffer) ->(string, string)
{
  let(config, _, err) = parse(source, "market");
  return (config, err);
}

# Explicit pure invocation; a declaration is not an automatic workflow step.
fn call_market_function(source: buffer,
  name: string,
  arguments_json: string) ->(string,
  string)
{
  let(_, linked, err) = parse(source, "market");
  if err != ""
  {
    return ("", err);
  }
  return Pure.call(linked, name, arguments_json);
}
