import std.String as String;
import std.os.OS_FileSys as FS;
import std.os.OS_Path as Path;
import std.sexpr as S;
import frontend.text as T;

# A map is a list of (name value) entries. Scalar values have tag "text"
# or "int"; arrays have tag "array" and contain scalar values.
fn lookup(fields: sexpr, name: string) -> sexpr
{
  var remaining = fields;
  while sx_kind(remaining) == 3
  {
    let pair = sx_head(remaining);
    if sx_text(sx_head(pair)) == name { return pair; }
    remaining = sx_tail(remaining);
  }
  return sx_nil();
}

fn payload(pair: sexpr) -> sexpr { return sx_head(sx_tail(pair)); }

fn get(fields: sexpr, name: string) -> sexpr
{
  let pair = lookup(fields, name);
  if sx_kind(pair) == 0 { return pair; }
  return payload(pair);
}

fn has(fields: sexpr, name: string) -> bool { return sx_kind(lookup(fields, name)) != 0; }
fn entry(fields: sexpr, key: string, value: sexpr) -> sexpr
{
  return sx_cons(sx_cons(sx_string(key), sx_cons(value, sx_nil())), fields);
}

fn tagged(value: sexpr, tag: string) -> bool
{
  return sx_kind(value) == 3 && sx_text(sx_head(value)) == tag;
}

fn atom(value: sexpr) -> string { return sx_text(payload(value)); }

fn member(list: string, name: string) -> bool
{
  return text_len(name) > 0 && !String.contains(name, " ")
    && String.contains(list, text_concat(" ", text_concat(name, " ")));
}

# Return the name of the required shape for a key, or empty for unknown.
fn field_kind(context: string, key: string) -> string
{
  if context == "script"
  {
    if member(" name competitors sources ", key) { return "field"; }
    if member(" property search refresh output credentials ", key) { return "block"; }
    if key == "transform" { return "transform"; }
  }
  if context == "credentials"
  {
    if member(" booking agoda ", key) { return "block"; }
  }
  if (context == "property" && member(" type latitude longitude timezone currency room_types ", key))
    || (context == "search" && member(" horizon_days start guest_configurations stay_lengths booker_country locale ", key))
    || (context == "refresh" && member(" tick_seconds weights max_age_seconds booking_requests_per_hour booking_concurrency agoda_requests_per_hour agoda_concurrency ", key))
    || (context == "output" && member(" observations coverage ", key))
    || (member(" booking agoda ", context) && member(" cookies environment explicit dotenv ", key))
  { return "field"; }
  return "";
}

fn missing(fields: sexpr, names: string, context: string) -> string
{
  let out = buffer_new();
  var remaining = T.split(names, 32);
  while sx_kind(remaining) == 3
  {
    let name = sx_text(sx_head(remaining));
    if !has(fields, name)
    {
      if buffer_len(out) == 0
      {
        buffer_append(out, context);
        buffer_append(out, " is missing fields: ");
      }
      else { buffer_append(out, ", "); }
      buffer_append(out, name);
    }
    remaining = sx_tail(remaining);
  }
  return buffer_text(out);
}

fn space_width(raw: string, i: i64) -> i64
{
  let c = text_byte(raw, i);
  if (c >= 9 && c <= 13) || (c >= 28 && c <= 32) { return 1; }
  if i + 2 <= text_len(raw)
  {
    let second = text_byte(raw, i + 1);
    if c == 194 && (second == 133 || second == 160) { return 2; }
  }
  if i + 3 <= text_len(raw)
  {
    let second = text_byte(raw, i + 1);
    let third = text_byte(raw, i + 2);
    if (c == 225 && second == 154 && third == 128)
      || (c == 226 && second == 128 && ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175))
      || (c == 226 && second == 129 && third == 159)
      || (c == 227 && second == 128 && third == 128) { return 3; }
  }
  return 0;
}

fn nonempty(value: sexpr) -> bool
{
  if !tagged(value, "text") { return false; }
  let raw = atom(value);
  var at = 0;
  while at < text_len(raw)
  {
    let width = space_width(raw, at);
    if width == 0 { return true; }
    at = at + width;
  }
  return false;
}

fn local_file(value: sexpr) -> bool
{
  if !nonempty(value) { return false; }
  let raw = atom(value);
  let basename = Path.basis_path_base(raw);
  if basename == "" || basename == "." || basename == ".." { return false; }
  for i in 0 .. text_len(raw)
  {
    let c = text_byte(raw, i);
    if c < 32 || c == 127 || c == 255 { return false; }
  }
  if T.alpha(text_byte(raw, 0))
  {
    var i = 1;
    while i < text_len(raw)
    {
      let c = text_byte(raw, i);
      if !T.alpha(c) && !T.digit(c) && c != 43 && c != 45 && c != 46 { break; }
      i = i + 1;
    }
    if i + 3 <= text_len(raw) && text_slice(raw, i, i + 3) == "://" { return false; }
  }
  return true;
}

fn normalize_path(raw: string) -> string
{
  let absolute = text_byte(raw, 0) == 47;
  let double = text_len(raw) > 2 && text_byte(raw, 1) == 47 && text_byte(raw, 2) != 47;
  var parts = T.split(raw, 47);
  var stack = sx_nil();
  while sx_kind(parts) == 3
  {
    let element = sx_head(parts);
    let name = sx_text(element);
    if name != "" && name != "."
    {
      if name != ".." { stack = sx_cons(element, stack); }
      else
      {
        if sx_kind(stack) == 3 && sx_text(sx_head(stack)) != ".." { stack = sx_tail(stack); }
        else { if !absolute { stack = sx_cons(element, stack); } }
      }
    }
    parts = sx_tail(parts);
  }
  let out = buffer_new();
  if absolute
  {
    buffer_append(out, "/");
    if double { buffer_append(out, "/"); }
  }
  var ordered = S.sexpr_reverse(stack);
  while sx_kind(ordered) == 3
  {
    buffer_append(out, sx_text(sx_head(ordered)));
    ordered = sx_tail(ordered);
    if sx_kind(ordered) == 3 { buffer_append(out, "/"); }
  }
  if buffer_len(out) == 0 { return "."; }
  return buffer_text(out);
}

fn positive(value: sexpr) -> bool { return tagged(value, "int") && atom(value) != "0"; }

fn decimal(raw: string, bound: i64) -> i64
{
  let n = text_len(raw);
  if n == 0 { return 1; }
  var i = 0;
  if text_byte(raw, 0) == 43 || text_byte(raw, 0) == 45 { i = 1; }
  let start = i;
  var whole = 0;
  while i < n && T.digit(text_byte(raw, i))
  {
    if whole <= bound { whole = whole * 10 + text_byte(raw, i) - 48; }
    i = i + 1;
  }
  let count = i - start;
  var fraction = false;
  if i < n
  {
    if text_byte(raw, i) != 46 || i + 1 == n { return 1; }
    i = i + 1;
    while i < n
    {
      let d = text_byte(raw, i);
      if !T.digit(d) { return 1; }
      if d != 48 { fraction = true; }
      i = i + 1;
    }
  }
  else { if count == 0 { return 1; } }
  if whole > bound || (whole == bound && fraction) { return 2; }
  return 0;
}

fn zone_name(raw: string) -> bool
{
  if raw == "localtime" || raw == "posixrules" || text_len(raw) == 0 { return false; }
  var components = T.split(raw, 47);
  let head = sx_text(sx_head(components));
  if head == "posix" || head == "right" { return false; }
  while sx_kind(components) == 3
  {
    let name = sx_text(sx_head(components));
    if text_len(name) == 0 { return false; }
    for i in 0 .. text_len(name)
    {
      let c = text_byte(name, i);
      if !T.alpha(c) && !T.digit(c) && c != 95 && c != 43 && c != 45 { return false; }
    }
    components = sx_tail(components);
  }
  return true;
}

fn zone_available(raw: string) -> bool
{
  # Fixed host zoneinfo roots; no access to script-referenced files.
  if raw == "leapseconds" { return false; }
  var dirs = T.split("/usr/share/zoneinfo:/usr/lib/zoneinfo:/usr/share/lib/zoneinfo:/etc/zoneinfo", 58);
  while sx_kind(dirs) == 3
  {
    let file = Path.basis_path_join(sx_text(sx_head(dirs)), raw);
    if FS.basis_fs_file_size(file) >= 44 && !FS.basis_fs_is_dir(file) { return true; }
    dirs = sx_tail(dirs);
  }
  return false;
}

fn gregorian(raw: string) -> i64
{
  if raw == "today" { return 0; }
  if text_len(raw) != 10 || text_byte(raw, 4) != 45 || text_byte(raw, 7) != 45 { return 1; }
  var year = 0; var month = 0; var day = 0;
  for i in 0 .. 10
  {
    if i == 4 || i == 7 { continue; }
    let c = text_byte(raw, i);
    if !T.digit(c) { return 1; }
    if i < 4 { year = year * 10 + c - 48; }
    else
    {
      if i < 7 { month = month * 10 + c - 48; }
      else { day = day * 10 + c - 48; }
    }
  }
  if year == 0 || month < 1 || month > 12 || day < 1 { return 2; }
  var limit = 31;
  if month == 4 || month == 6 || month == 9 || month == 11 { limit = 30; }
  if month == 2
  {
    limit = 28;
    if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { limit = 29; }
  }
  if day > limit { return 2; }
  return 0;
}

fn ascii_class(raw: string, want_alpha: bool) -> bool
{
  for i in 0 .. text_len(raw)
  {
    let c = text_byte(raw, i);
    if (want_alpha && !T.alpha(c)) || (!want_alpha && !T.digit(c)) { return false; }
  }
  return true;
}

fn language_tag(raw: string) -> bool
{
  let code = T.ascii_lower(raw);
  if member(" art-lojban cel-gaulish en-gb-oed i-ami i-bnn i-default i-enochian i-hak i-klingon i-lux i-mingo i-navajo i-pwn i-tao i-tay i-tsu no-bok no-nyn sgn-be-fr sgn-be-nl sgn-ch-de zh-guoyu zh-hakka zh-min zh-min-nan zh-xiang ", code)
  { return true; }
  let parts = T.split(code, 45);
  var rest = parts;
  while sx_kind(rest) == 3
  {
    let part = sx_text(sx_head(rest));
    if text_len(part) == 0 || text_len(part) > 8 { return false; }
    for i in 0 .. text_len(part)
    {
      let c = text_byte(part, i);
      if !T.alpha(c) && !T.digit(c) { return false; }
    }
    rest = sx_tail(rest);
  }
  let primary = sx_text(sx_head(parts));
  rest = sx_tail(parts);
  if primary == "x" { return sx_kind(rest) == 3; }
  if text_len(primary) < 2 || !ascii_class(primary, true) { return false; }
  if text_len(primary) <= 3
  {
    for _ in 0 .. 3
    {
      if sx_kind(rest) != 3 { break; }
      let tag = sx_text(sx_head(rest));
      if text_len(tag) != 3 || !ascii_class(tag, true) { break; }
      rest = sx_tail(rest);
    }
  }
  if sx_kind(rest) == 3
  {
    let tag = sx_text(sx_head(rest));
    if text_len(tag) == 4 && ascii_class(tag, true) { rest = sx_tail(rest); }
  }
  if sx_kind(rest) == 3
  {
    let tag = sx_text(sx_head(rest));
    if (text_len(tag) == 2 && ascii_class(tag, true)) || (text_len(tag) == 3 && ascii_class(tag, false))
    { rest = sx_tail(rest); }
  }
  var variants = sx_nil();
  while sx_kind(rest) == 3
  {
    let tag = sx_text(sx_head(rest));
    if !(text_len(tag) >= 5 || (text_len(tag) == 4 && T.digit(text_byte(tag, 0)))) { break; }
    if T.contains(variants, tag) { return false; }
    variants = sx_cons(sx_head(rest), variants);
    rest = sx_tail(rest);
  }
  var extensions = sx_nil();
  while sx_kind(rest) == 3
  {
    let tag = sx_text(sx_head(rest));
    if tag != "t" && tag != "u" { break; }
    if T.contains(extensions, tag) { return false; }
    extensions = sx_cons(sx_head(rest), extensions);
    rest = sx_tail(rest);
    if sx_kind(rest) == 0 || text_len(sx_text(sx_head(rest))) < 2 { return false; }
    while sx_kind(rest) == 3 && text_len(sx_text(sx_head(rest))) >= 2 { rest = sx_tail(rest); }
  }
  return sx_kind(rest) == 0 || (sx_text(sx_head(rest)) == "x" && sx_kind(sx_tail(rest)) == 3);
}

fn reference(raw: string) -> bool
{
  if text_len(raw) == 0 { return false; }
  for i in 0 .. text_len(raw)
  {
    let c = text_byte(raw, i);
    if !T.alpha(c) && c != 95 && !(i > 0 && T.digit(c)) { return false; }
  }
  return true;
}

# Detect duplicates by merging sorted halves, rather than testing every pair.
fn sorted_unique(items: sexpr, size: i64) -> (bool, sexpr)
{
  if size < 2
  {
    if size == 0 { return (true, sx_nil()); }
    return (true, sx_cons(sx_head(items), sx_nil()));
  }
  let half = size / 2;
  var middle = items;
  for _ in 0 .. half { middle = sx_tail(middle); }
  let (left_ok, left) = sorted_unique(items, half);
  if !left_ok { return (false, sx_nil()); }
  let (right_ok, right) = sorted_unique(middle, size - half);
  if !right_ok { return (false, sx_nil()); }
  var a = left; var b = right; var reversed = sx_nil();
  while sx_kind(a) == 3 || sx_kind(b) == 3
  {
    var order = 0;
    if sx_kind(a) == 0 { order = 1; }
    else
    {
      if sx_kind(b) == 0 { order = - 1; }
      else { order = String.compare(sx_text(sx_head(a)), sx_text(sx_head(b))); }
    }
    if order == 0 { return (false, sx_nil()); }
    if order < 0 { reversed = sx_cons(sx_head(a), reversed); a = sx_tail(a); }
    else { reversed = sx_cons(sx_head(b), reversed); b = sx_tail(b); }
  }
  return (true, S.sexpr_reverse(reversed));
}

fn check_array(value: sexpr, where: string, mode: string) -> string
{
  if !tagged(value, "array") || sx_kind(sx_tail(value)) == 0
  { return text_concat(where, " must be a nonempty array"); }
  var items = sx_tail(value);
  var keys = sx_nil();
  var size = 0;
  while sx_kind(items) == 3
  {
    let item = sx_head(items);
    if mode == "source" && (!tagged(item, "text") || !member(" booking agoda ", atom(item)))
    { return text_concat(where, " must contain only booking and/or agoda"); }
    if mode == "text" && !nonempty(item)
    { return text_concat(where, " must be a nonempty string"); }
    if mode == "int" && !positive(item)
    { return text_concat(where, " must be a positive integer"); }
    if mode == "reference" && (!tagged(item, "text") || !reference(atom(item)))
    { return text_concat(where, " must list unique reference names"); }
    keys = sx_cons(sx_string(atom(item)), keys);
    size = size + 1;
    items = sx_tail(items);
  }
  let (unique, _) = sorted_unique(keys, size);
  if !unique { return text_concat(where, " must not contain duplicates"); }
  return "";
}

fn selected(sources: sexpr, source: string) -> bool
{
  var remaining = sx_tail(sources);
  while sx_kind(remaining) == 3
  {
    if atom(sx_head(remaining)) == source { return true; }
    remaining = sx_tail(remaining);
  }
  return false;
}

fn check_credentials(fields: sexpr, sources: sexpr) -> string
{
  if sx_kind(fields) == 0 { return "credentials must contain at least one source block"; }
  var remaining = fields;
  while sx_kind(remaining) == 3
  {
    let entry = sx_head(remaining);
    let source = sx_text(sx_head(entry));
    if !selected(sources, source) { return "credentials can be declared only for a selected source"; }
    let context = text_concat("credentials.", source);
    let declaration = payload(entry);
    let modes = T.split("cookies environment explicit", 32);
    var rest = modes;
    var mode = "";
    while sx_kind(rest) == 3
    {
      let name = sx_text(sx_head(rest));
      if has(declaration, name)
      {
        if mode != "" { return text_concat(context, " must select exactly one credential mode"); }
        mode = name;
      }
      rest = sx_tail(rest);
    }
    if mode == "" { return text_concat(context, " must select exactly one credential mode"); }
    if has(declaration, "dotenv") && mode != "environment"
    { return text_concat(context, " has fields not allowed for this mode"); }
    if mode == "cookies"
    {
      if !local_file(get(declaration, "cookies"))
      { return text_concat(context, ".cookies must be a local file path"); }
    }
    else
    {
      let err = check_array(get(declaration, mode), text_concat(context, text_concat(".", mode)), "reference");
      if err != "" { return err; }
    }
    if has(declaration, "dotenv") && !local_file(get(declaration, "dotenv"))
    { return text_concat(context, ".dotenv must be a local file path"); }
    remaining = sx_tail(remaining);
  }
  return "";
}

# ISO 3166-1 alpha-2 and ISO 4217 alpha-3 assignments, matching the
# CaravanScript contract (iso-codes 4.20.1).
fn countries() -> string
{
  return " AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG UM US UY UZ VA VC VE VG VI VN VU WF WS YE YT ZA ZM ZW ";
}

fn currencies() -> string
{
  return " AED AFN ALL AMD AOA ARS AUD AWG AZN BAM BBD BDT BHD BIF BMD BND BOB BOV BRL BSD BTN BWP BYN BZD CAD CDF CHE CHF CHW CLF CLP CNY COP COU CRC CUP CVE CZK DJF DKK DOP DZD EGP ERN ETB EUR FJD FKP GBP GEL GHS GIP GMD GNF GTQ GYD HKD HNL HTG HUF IDR ILS INR IQD IRR ISK JMD JOD JPY KES KGS KHR KMF KPW KRW KWD KYD KZT LAK LBP LKR LRD LSL LYD MAD MDL MGA MKD MMK MNT MOP MRU MUR MVR MWK MXN MXV MYR MZN NAD NGN NIO NOK NPR NZD OMR PAB PEN PGK PHP PKR PLN PYG QAR RON RSD RUB RWF SAR SBD SCR SDG SEK SGD SHP SLE SOS SRD SSP STN SVC SYP SZL THB TJS TMT TND TOP TRY TTD TWD TZS UAH UGX USD USN UYI UYU UYW UZS VED VES VND VUV WST XAD XAF XAG XAU XBA XBB XBC XBD XCD XCG XDR XOF XPD XPF XPT XSU XTS XUA XXX YER ZAR ZMW ZWG ";
}

fn validate(config: sexpr) -> string
{
  var err = missing(config, "competitors output property refresh search sources", "script");
  if err != "" { return err; }
  let property = get(config, "property");
  let search = get(config, "search");
  let refresh = get(config, "refresh");
  let output = get(config, "output");
  err = missing(property, "currency latitude longitude room_types timezone type", "property");
  if err != "" { return err; }
  err = missing(search, "booker_country guest_configurations horizon_days locale start stay_lengths", "search");
  if err != "" { return err; }
  err = missing(refresh, "max_age_seconds tick_seconds weights", "refresh");
  if err != "" { return err; }
  err = missing(output, "coverage observations", "output");
  if err != "" { return err; }
  if has(config, "name") && !tagged(get(config, "name"), "text") { return "name must be a string"; }
  if !local_file(get(config, "competitors")) { return "competitors must be a local file path"; }
  let sources = get(config, "sources");
  err = check_array(sources, "sources", "source");
  if err != "" { return err; }
  if !nonempty(get(property, "type")) { return "property.type must be a nonempty string"; }
  err = check_array(get(property, "room_types"), "property.room_types", "text");
  if err != "" { return err; }
  let lat = get(property, "latitude");
  let lon = get(property, "longitude");
  if !tagged(lat, "text") || decimal(atom(lat), 90) == 1 { return "property.latitude must be a decimal string"; }
  if decimal(atom(lat), 90) == 2 { return "property.latitude must be between -90 and 90"; }
  if !tagged(lon, "text") || decimal(atom(lon), 180) == 1 { return "property.longitude must be a decimal string"; }
  if decimal(atom(lon), 180) == 2 { return "property.longitude must be between -180 and 180"; }
  let zone = get(property, "timezone");
  if !tagged(zone, "text") || !zone_name(atom(zone)) { return "property.timezone must be an IANA zone name"; }
  if !zone_available(atom(zone)) { return "property.timezone is not available in the host IANA timezone database"; }
  let currency = get(property, "currency");
  if !tagged(currency, "text") || !member(currencies(), atom(currency))
  { return "property.currency must be an ISO 4217 alpha-3 code"; }
  let horizon = get(search, "horizon_days");
  if !positive(horizon) { return "search.horizon_days must be a positive integer"; }
  if !T.bounded_nat(atom(horizon), 365) { return "search.horizon_days must be between 1 and 365"; }
  let start = get(search, "start");
  if !tagged(start, "text") || gregorian(atom(start)) == 1 { return "search.start must be today or a YYYY-MM-DD date"; }
  if gregorian(atom(start)) == 2 { return "search.start must be a valid Gregorian date"; }
  err = check_array(get(search, "guest_configurations"), "search.guest_configurations", "text");
  if err != "" { return err; }
  err = check_array(get(search, "stay_lengths"), "search.stay_lengths", "int");
  if err != "" { return err; }
  let country = get(search, "booker_country");
  if !tagged(country, "text") || !member(countries(), atom(country))
  { return "search.booker_country must be an ISO 3166-1 alpha-2 code"; }
  let locale = get(search, "locale");
  if !tagged(locale, "text") || !language_tag(atom(locale)) { return "search.locale must be a BCP 47 language tag"; }
  if selected(sources, "booking")
  {
    err = missing(refresh, "booking_concurrency booking_requests_per_hour", "refresh");
    if err != "" { return err; }
  }
  if selected(sources, "agoda")
  {
    err = missing(refresh, "agoda_concurrency agoda_requests_per_hour", "refresh");
    if err != "" { return err; }
  }
  if !local_file(get(refresh, "weights")) { return "refresh.weights must be a local file path"; }
  var rest = refresh;
  while sx_kind(rest) == 3
  {
    let pair = sx_head(rest);
    let key = sx_text(sx_head(pair));
    if key != "weights" && !positive(payload(pair))
    { return text_concat("refresh.", text_concat(key, " must be a positive integer")); }
    rest = sx_tail(rest);
  }
  let coverage = get(output, "coverage");
  let observations = get(output, "observations");
  if !local_file(observations) { return "output.observations must be a local file path"; }
  if !local_file(coverage) { return "output.coverage must be a local file path"; }
  if normalize_path(atom(observations)) == normalize_path(atom(coverage))
  { return "output.observations and output.coverage must be distinct paths"; }
  if has(config, "credentials") { return check_credentials(get(config, "credentials"), sources); }
  return "";
}
