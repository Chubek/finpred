import std.Int as Int;

fn byte_at(source: buffer, i: i64) -> i64
{
  return u8_to_i64(buffer_at(source, i));
}

fn alpha(c: i64) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122); }
fn digit(c: i64) -> bool { return c >= 48 && c <= 57; }

# Return the first invalid byte, or length. String conversions below are
# NUL-free, but escaped NULs in JSON literals remain supported.
fn utf8(source: buffer) -> i64
{
  let length = buffer_len(source);
  var i = 0;
  while i < length
  {
    let c = byte_at(source, i);
    if c == 0 { return i; }
    if c < 128 { i = i + 1; continue; }
    var n = 0;
    var low = 128;
    var high = 191;
    if c >= 194 && c <= 223 { n = 1; }
    if c >= 224 && c <= 239 { n = 2; }
    if c >= 240 && c <= 244 { n = 3; }
    if n == 0 || i + n >= length { return i; }
    if c == 224 { low = 160; }
    if c == 237 { high = 159; }
    if c == 240 { low = 144; }
    if c == 244 { high = 143; }
    let first = byte_at(source, i + 1);
    if first < low || first > high { return i; }
    for j in 2 .. n + 1
    {
      let follow = byte_at(source, i + j);
      if follow < 128 || follow > 191 { return i; }
    }
    i = i + n + 1;
  }
  return length;
}

fn diagnostic(source: buffer, offset: i64, reason: string) -> string
{
  var line = 1;
  var column = 1;
  var previous_cr = false;
  for i in 0 .. offset
  {
    let c = byte_at(source, i);
    if c == 13 || (c == 10 && !previous_cr)
    {
      line = line + 1;
      column = 1;
    }
    else
    {
      if c != 10 && (c < 128 || c >= 192) { column = column + 1; }
    }
    previous_cr = c == 13;
  }
  let out = buffer_new();
  buffer_append(out, "line "); buffer_append(out, Int.to_string(line));
  buffer_append(out, ", column "); buffer_append(out, Int.to_string(column));
  buffer_append(out, ": "); buffer_append(out, reason);
  return buffer_text(out);
}

fn hex(c: i64) -> i64
{
  if digit(c) { return c - 48; }
  if c >= 65 && c <= 70 { return c - 55; }
  return c - 87;
}

fn hex4(raw: string, i: i64) -> i64
{
  return hex(text_byte(raw, i)) * 4096 + hex(text_byte(raw, i + 1)) * 256
       + hex(text_byte(raw, i + 2)) * 16 + hex(text_byte(raw, i + 3));
}

fn push_scalar(out: buffer, code: i64)
{
  # 255 cannot occur in valid UTF-8. Use it as a one-byte NUL sentinel
  # for semantic checks only; the emitted JSON retains its original escape.
  if code == 0 { buffer_byte(out, 255); return; }
  if code < 128 { buffer_byte(out, code); return; }
  if code < 2048 { buffer_byte(out, 192 + code / 64); }
  else
  {
    if code < 65536 { buffer_byte(out, 224 + code / 4096); }
    else
    {
      buffer_byte(out, 240 + code / 262144);
      buffer_byte(out, 128 + code / 4096 % 64);
    }
    buffer_byte(out, 128 + code / 64 % 64);
  }
  buffer_byte(out, 128 + code % 64);
}

# Called only on a STRING terminal of the synthesized lexer. It has already
# checked escape syntax; decode for semantic equality and Unicode bounds.
fn decode_string(raw: string) -> (string, bool)
{
  let out = buffer_new();
  let limit = text_len(raw) - 1;
  var i = 1;
  while i < limit
  {
    var c = text_byte(raw, i);
    i = i + 1;
    if c != 92 { buffer_byte(out, c); continue; }
    c = text_byte(raw, i);
    i = i + 1;
    if c == 117
    {
      var code = hex4(raw, i);
      i = i + 4;
      if code >= 55296 && code <= 56319
      {
        if i + 6 > limit || text_byte(raw, i) != 92 || text_byte(raw, i + 1) != 117
        { return ("", false); }
        let low = hex4(raw, i + 2);
        if low < 56320 || low > 57343 { return ("", false); }
        code = 65536 + (code - 55296) * 1024 + low - 56320;
        i = i + 6;
      }
      else { if code >= 56320 && code <= 57343 { return ("", false); } }
      push_scalar(out, code);
    }
    else
    {
      match c with
      {
        98 => { c = 8; }, 102 => { c = 12; }, 110 => { c = 10; },
        114 => { c = 13; }, 116 => { c = 9; }, _ => {}
      };
      buffer_byte(out, c);
    }
  }
  return (buffer_text(out), true);
}

fn quoted_ascii(out: buffer, value: string)
{
  # Only synthesized identifiers/operators and fixed AST labels enter here.
  buffer_append(out, "\""); buffer_append(out, value); buffer_append(out, "\"");
}

fn bounded_nat(raw: string, maximum: i64) -> bool
{
  var n = 0;
  for i in 0 .. text_len(raw)
  {
    let d = text_byte(raw, i) - 48;
    if n > maximum / 10 || (n == maximum / 10 && d > maximum % 10) { return false; }
    n = n * 10 + d;
  }
  return true;
}

fn ascii_lower(raw: string) -> string
{
  let out = buffer_new();
  for i in 0 .. text_len(raw)
  {
    let c = text_byte(raw, i);
    if c >= 65 && c <= 90 { buffer_byte(out, c + 32); }
    else { buffer_byte(out, c); }
  }
  return buffer_text(out);
}

fn split(raw: string, separator: i64) -> sexpr
{
  var parts = sx_nil();
  var end = text_len(raw);
  var i = end;
  while i > 0
  {
    i = i - 1;
    if text_byte(raw, i) == separator
    {
      parts = sx_cons(sx_string(text_slice(raw, i + 1, end)), parts);
      end = i;
    }
  }
  return sx_cons(sx_string(text_slice(raw, 0, end)), parts);
}

fn contains(items: sexpr, key: string) -> bool
{
  var rest = items;
  while sx_kind(rest) == 3
  {
    if sx_text(sx_head(rest)) == key { return true; }
    rest = sx_tail(rest);
  }
  return false;
}
