import std.String as Str;
import std.os.OS_FileSys as FS;
import std.os.OS_Path as Path;
import std.sexpr.sexpr as Sx;
import plugins.caravansary.planning.civil as Civil;
import plugins.caravansary.planning.host as Host;
import plugins.caravansary.planning.inputs as Inputs;
import plugins.caravansary.planning.json as Json;
import plugins.caravansary.market_cli.files as Files;

fn operation_name(op: string) -> bool {
  return op == "discover" || op == "scrape" || op == "collect" || op == "predict";
}

fn identifier(s: string, where: string) -> string {
  if text_len(s) < 1 || text_len(s) > 128 { tool_fail("$where must be an identifier"); }
  for i in 0 .. text_len(s) {
    let b = text_byte(s,i);
    let letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
    if !letter && !Json.digit(b) && b != 45 && b != 95 && b != 46 {
      tool_fail("$where must be an identifier");
    }
  }
  return s;
}

fn fixture_url(provider: string, value: string) -> bool {
  let prefix = "https://$provider.example/";
  let start = text_len(prefix);
  let n = text_len(value);
  if n <= start || n > 512 || !Str.is_prefix(prefix,value) { return false; }
  var segment = 0;
  for i in start .. n {
    let b = text_byte(value,i);
    if b == 47 {
      if segment == 0 { return false; }
      segment = 0;
    } else {
      let letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
      if !letter && !Json.digit(b) && b != 45 && b != 95 && !(b == 46 && segment > 0) { return false; }
      segment = segment + 1;
    }
  }
  return segment > 0;
}

fn load(path: string, roots: sexpr) -> (sexpr,string) {
  let resolved = Files.resolve(path,FS.basis_fs_cwd(),roots,"host grants");
  let registry = Json.parse_at(Files.read_text(resolved,131072,"host grants"),"host grants: ");
  Inputs.object_fields(registry,"kind grants","","host grants");
  if Json.text(Json.field(registry,"kind")) != "caravansary.host-grants@1" {
    tool_fail("host grants must have kind caravansary.host-grants@1");
  }
  let entries = Json.items(Json.field(registry,"grants"));
  if Sx.sexpr_size(entries) > 128 { tool_fail("too many market host grants"); }
  var fields = sx_nil();
  var rest = entries;
  while sx_kind(rest) == 3 {
    let grant = sx_head(rest);
    Inputs.object_fields(grant,"source fixture path sha256 operations provider provider_operation source_url observed_at","","host grant");
    let source = identifier(Json.text(Json.field(grant,"source")),"host grant source");
    ignore(identifier(Json.text(Json.field(grant,"fixture")),"host grant fixture"));
    let fixture_path = Json.text(Json.field(grant,"path"));
    Files.check_path(fixture_path,"host grant fixture");
    if text_byte(fixture_path,0) == 47 { tool_fail("host grant fixture path must be relative to the registry"); }
    if !Files.sha256_hex(Json.text(Json.field(grant,"sha256"))) {
      tool_fail("host grant requires lowercase SHA-256 of exact fixture bytes");
    }
    let provider = Json.text(Json.field(grant,"provider"));
    let provider_op = Json.text(Json.field(grant,"provider_operation"));
    if provider != "booking" && provider != "agoda" { tool_fail("host grant fixture provider is unsupported"); }
    if provider_op != "profile" && provider_op != "candidates" { tool_fail("host grant provider operation is unsupported"); }
    let url = Json.text(Json.field(grant,"source_url"));
    if !fixture_url(provider,url) { tool_fail("host grant URL must identify an offline fixture"); }
    ignore(Civil.timestamp(Json.text(Json.field(grant,"observed_at")),"host grant observed_at"));
    let ops = Json.items(Json.field(grant,"operations"));
    if sx_kind(ops) != 3 { tool_fail("host grant requires at least one market operation"); }
    var seen = sx_nil();
    var items = ops;
    while sx_kind(items) == 3 {
      let op = Json.text(sx_head(items));
      if !operation_name(op) { tool_fail("host grant contains an unsupported market operation"); }
      seen = sx_cons(Json.pair(op,Json.boolean(true)),seen);
      items = sx_tail(items);
    }
    let allowed = Json.object_unique(seen,"host grant repeats operation");
    fields = sx_cons(Json.pair(source,Json.replace(grant,"operations",allowed)),fields);
    rest = sx_tail(rest);
  }
  return (Json.object_unique(fields,"duplicate host grant source"),Path.basis_path_dir(resolved));
}

fn authorize(registry: sexpr, mode: string, source: string, declaration: sexpr, now: i64) -> sexpr {
  let grant = Json.get(registry,source);
  if sx_kind(grant) == 0 || sx_kind(Json.get(Json.get(grant,"operations"),mode)) == 0 {
    tool_fail("no host grant for selected market source and operation: $source ($mode)");
  }
  if Json.text(Json.field(declaration,"kind")) != "fixture" ||
     Json.text(Json.field(declaration,"fixture")) != Json.text(Json.field(grant,"fixture")) {
    tool_fail("host grant does not match the script fixture declaration: $source");
  }
  let op = Json.text(Json.field(grant,"provider_operation"));
  if ((mode == "discover" || mode == "predict") && op != "candidates") ||
      (mode == "scrape" && op != "profile") {
    tool_fail("host grant provider operation is incompatible with $mode: $source");
  }
  if Civil.timestamp(Json.text(Json.field(grant,"observed_at")),"host grant observed_at") > now {
    tool_fail("host grant capture is newer than --as-of: $source");
  }
  return grant;
}

fn capture(grant: sexpr, parent: string, roots: sexpr) -> string {
  let path = Files.resolve(Json.text(Json.field(grant,"path")),parent,roots,"fixture capture");
  let body = Files.read_text(path,65536,"fixture capture");
  if Host.caravansary_sha256(body) != Json.text(Json.field(grant,"sha256")) {
    tool_fail("fixture capture does not match host-approved SHA-256");
  }
  return body;
}
