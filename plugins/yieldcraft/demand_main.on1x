import plugins.yieldcraft.demand as Demand;
import store.artifacts as Store;
import std.environ as Env;
import std.io.TextIO as IO;
import std.os.OS_FileSys as FS;

fn required(key:string) -> string
{
  let (found,value) = Env.getenv(key);
  if !found || value == "" { tool_fail("yieldcraft-demand: missing host argument"); }
  return value;
}

fn source(path:string, limit:i64) -> string
{
  let size = FS.basis_fs_file_size(path);
  if size < 1 || size > limit || FS.basis_fs_is_dir(path)
  { tool_fail("yieldcraft-demand: input missing or outside byte limit"); }
  let raw = IO.basis_text_io_input_all(path);
  if text_len(raw) != size { tool_fail("yieldcraft-demand: incomplete text input"); }
  return raw;
}

fn main() -> i64
{
  let mode = required("YIELDCRAFT_DEMAND_COMMAND");
  let scenario = source(required("YIELDCRAFT_DEMAND_SCENARIO"),Demand.bytes_limit());
  if mode == "scenario-digest" { println(Store.digest(scenario)); return 0; }
  if mode != "estimate" && mode != "evidence" && mode != "replay"
  { tool_fail("yieldcraft-demand: unknown mode"); }
  let raw = source(required("YIELDCRAFT_DEMAND_EXPOSURE"),Demand.bytes_limit());
  let fit = Demand.estimate(scenario,raw);
  let demand = sx_text(fit["demand"]);
  let evidence = sx_text(fit["evidence"]);
  if mode == "estimate" { IO.basis_text_io_print(demand); return 0; }
  if mode == "evidence" { IO.basis_text_io_print(evidence); return 0; }
  let id = required("YIELDCRAFT_DEMAND_EXPECTED_ID");
  if id != text_concat("blake3:",sx_text(fit["id"]))
    || source(required("YIELDCRAFT_DEMAND_FROZEN_SNAPSHOT"),Demand.bytes_limit()) != demand
    || source(required("YIELDCRAFT_DEMAND_FROZEN_EVIDENCE"),32768) != evidence
  { tool_fail("yieldcraft-demand: replay identity or bytes differ"); }
  println("demand_replay_ok=true");
  return 0;
}
