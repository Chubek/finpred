# Bounded, deterministic frozen cube. A cell owns its cutoff and policy.
# No file or network access; host supplies exact input snapshots.
import core.competitor as C;
import core.csv as CSV;
import core.date as Date;
import core.format as F;
import plugins.yieldcraft.competitor_match as Match;
import plugins.yieldcraft.competitor_policy as Policy;
import std.String as Str;
import std.collections.Array as A;
record Query
{ id          : i64
, arrival     : sexpr
, departure   : sexpr
, as_of       : sexpr
, currency    : sexpr
, cancellation: sexpr
, party       : C.Party
, lead        : i64
, max_age     : i64
, minimum     : i64
, budget      : i64
, policy      : i64
, market_key  : sexpr
}

record Market
{ status     : sexpr
, comparables: sexpr
, series     : sexpr
, work       : i64
, matched    : i64
}

fn cells_limit() -> i64
{
  return 32000;
}

fn policy_limit() -> i64
{
  return 8000;
}

fn snapshots_limit() -> i64
{
  return 128000;
}

fn query(row: string) -> Query
{
  CSV.require_width(row, 13);
  let id = C.number(row, 0);
  let arrival = CSV.field(row, 1);
  let departure = CSV.field(row, 2);
  let cutoff = CSV.field(row, 3);
  let lead = Date.lead_days(cutoff, arrival);
  let currency = CSV.field(row, 7);
  let cancellation = CSV.field(row, 8);
  let party = C.party(
    C.number(row, 4),
    CSV.field(row, 5),
    C.number(row, 6),
    Date.nights(arrival, departure),
    cancellation
  );
  let age = C.number(row, 9);
  let minimum = C.number(row, 10);
  let budget = C.number(row, 11);
  let policy = C.number(row, 12);
  if ! C.valid_id(id) || lead < 0 || ! C.currency_supported(currency) || age > 365 || minimum < 1 || minimum > 64 || budget < 1 || budget > 50000 || ! C.valid_id(policy)
  {
    tool_fail("competitor cube: invalid cell identity, cutoff, currency or work bounds");
  }
  let key = buffer_new();
  for i in 1 .. 12
  {
    # Statistical sufficiency is a policy decision, not a matching input.
    if i != 10
    {
      buffer_append(key, CSV.field(row, i));
      buffer_append(key, ",");
    }
  }
  return record<Query>
  { id          : id
  , arrival     : sx_string(arrival)
  , departure   : sx_string(departure)
  , as_of       : sx_string(cutoff)
  , currency    : sx_string(currency)
  , cancellation: sx_string(cancellation)
  , party       : party
  , lead        : lead
  , max_age     : age
  , minimum     : minimum
  , budget      : budget
  , policy      : policy
  , market_key  : sx_string(buffer_text(key))
  };
}

fn policies(raw: string) -> sexpr
{
  if text_len(raw) > policy_limit()
  {
    tool_fail("competitor cube: policy bytes exceed limit");
  }
  let n = CSV.rows(raw);
  if n < 3 || n > 18
  {
    tool_fail("competitor cube: expected 1..16 policies");
  }
  CSV.header(CSV.line(raw, 0), "pricing.competitor-policy@1");
  CSV.header(
    CSV.line(raw, 1),
    "id,curve,near_bps,far_bps,horizon_days,shape,knot_bps,quantile,lower_bps,shortcut_mode,threshold,floor_minor,cap_minor"
  );
  var entries = sx_nil();
  var last = 0;
  for i in 2 .. n
  {
    let row = CSV.line(raw, i);
    let p = Policy.parse(row);
    if p["id"] <= last
    {
      tool_fail("competitor cube: policy IDs must be strictly increasing");
    }
    last = p["id"];
    entries = sx_cons(
      sx_cons(sx_string(F.num(last)), sx_cons(sx_string(row), sx_nil())),
      entries
    );
  }
  return entries;
}

fn lookup(list: sexpr, key: string) -> sexpr
{
  var entries = list;
  while sx_kind(entries) == 3
  {
    let entry = sx_head(entries);
    if sx_text(sx_head(entry)) == key
    {
      return sx_head(sx_tail(entry));
    }
    entries = sx_tail(entries);
  }
  return sx_nil();
}

fn policy_for(entries: sexpr, id: i64) -> Policy.Policy
{
  let row = lookup(entries, F.num(id));
  if sx_kind(row) != 2
  {
    tool_fail("competitor cube: unknown cell policy");
  }
  return Policy.parse(sx_text(row));
}

fn published_as_of(r: C.Release, q: Query) -> bool
{
  return sx_text(r["arrival"]) == sx_text(q["arrival"]) && sx_text(r["departure"]) == sx_text(q["departure"]) && sx_text(r["currency"]) == sx_text(q["currency"]) && Str.compare(
    sx_text(r["ingested"]),
    sx_text(q["as_of"])
  ) <= 0;
}

fn latest(q: Query, releases: sexpr) -> sexpr
{
  var rest = releases;
  var selected = sx_nil();
  while sx_kind(rest) == 3
  {
    let r = C.item(sx_head(rest));
    rest = sx_tail(rest);
    if ! published_as_of(r, q)
    {
      continue;
    }
    let key = F.num(r["property_id"]);
    let old = lookup(selected, key);
    if sx_kind(old) == 0 || Str.compare(
      sx_text(r["observed"]),
      sx_text(sx_head(old))
    ) > 0
    {
      let value = sx_cons(
        r["observed"],
        sx_cons(sx_string(F.num(r["id"])), sx_nil())
      );
      selected = sx_cons(
        sx_cons(sx_string(key), sx_cons(value, sx_nil())),
        selected
      );
    }
  }
  return selected;
}

fn int_field(out: buffer, name: string, value: i64)
{
  buffer_append(out, ",");
  buffer_append(out, F.q(name));
  buffer_append(out, ":");
  buffer_append(out, F.num(value));
}

fn text_field(out: buffer, name: string, value: string)
{
  buffer_append(out, ",");
  buffer_append(out, F.q(name));
  buffer_append(out, ":");
  buffer_append(out, F.q(value));
}

fn comparable(out: buffer, r: C.Release, bundle: Match.Bundle)
{
  buffer_append(out, "{\"property\":");
  buffer_append(out, F.num(r["property_id"]));
  int_field(out, "release", r["id"]);
  text_field(out, "provider", sx_text(r["provider"]));
  text_field(out, "observed_at", sx_text(r["observed"]));
  text_field(out, "received_at", sx_text(r["received"]));
  text_field(out, "ingested_at", sx_text(r["ingested"]));
  int_field(out, "weight", r["weight"]);
  int_field(out, "total_minor", bundle["total"]);
  buffer_append(out, ",\"rooms\":");
  buffer_append(out, sx_text(bundle["rooms"]));
  buffer_append(out, "}");
}

fn market(snapshot: C.Snapshot, q: Query) -> Market
{
  let evidence = buffer_new();
  let series = buffer_new();
  let releases = snapshot["releases"];
  let selected = latest(q, releases);
  let cutoff_day = Date.date_days(text_slice(sx_text(q["as_of"]), 0, 10));
  var rest = releases;
  var work = 0;
  var matched = 0;
  var observed = false;
  var fresh = false;
  buffer_append(evidence, "[");
  while sx_kind(rest) == 3
  {
    let r = C.item(sx_head(rest));
    rest = sx_tail(rest);
    let chosen = lookup(selected, F.num(r["property_id"]));
    if sx_kind(chosen) == 0 || sx_text(sx_head(sx_tail(chosen))) != F.num(r["id"])
    {
      continue;
    }
    observed = true;
    let age = cutoff_day - Date.date_days(text_slice(
      sx_text(r["observed"]),
      0,
      10
    ));
    if age > q["max_age"]
    {
      continue;
    }
    fresh = true;
    let result = Match.solve(
      r,
      snapshot["quotes"],
      q["party"],
      q["budget"] - work
    );
    work = work + result["inspected"];
    if result["total"] == 0 - 2
    {
      return record<Market>
      { status     : sx_string("budget_exhausted")
      , comparables: sx_string("[]")
      , series     : sx_string("")
      , work       : work
      , matched    : 0
      };
    }
    if result["total"] < 0
    {
      continue;
    }
    if matched > 0
    {
      buffer_append(evidence, ",");
    }
    comparable(evidence, r, result);
    buffer_append(series, F.num(result["total"]));
    buffer_append(series, ",");
    buffer_append(series, F.num(r["weight"]));
    buffer_append(series, "\n");
    matched = matched + 1;
  }
  buffer_append(evidence, "]");
  var status = "matched";
  if ! observed
  {
    status = "no_observations";
  }
  else
  {
    if ! fresh
    {
      status = "stale_observations";
    }
    else
    {
      if matched == 0
      {
        status = "no_feasible_bundle";
      }
    }
  }
  return record<Market>
  { status     : sx_string(status)
  , comparables: sx_string(buffer_text(evidence))
  , series     : sx_string(buffer_text(series))
  , work       : work
  , matched    : matched
  };
}

fn cache_value(m: Market) -> sexpr
{
  return sx_cons(
    m["status"],
    sx_cons(
      m["comparables"],
      sx_cons(
        m["series"],
        sx_cons(
          sx_string(F.num(m["work"])),
          sx_cons(sx_string(F.num(m["matched"])), sx_nil())
        )
      )
    )
  );
}

fn cache_read(value: sexpr) -> Market
{
  let parts = sx_tail(value);
  let tail = sx_tail(parts);
  let counts = sx_tail(tail);
  return record<Market>
  { status     : sx_head(value)
  , comparables: sx_head(parts)
  , series     : sx_head(tail)
  , work       : C.nat(sx_text(sx_head(counts)))
  , matched    : C.nat(sx_text(sx_head(sx_tail(counts))))
  };
}

fn decision(out: buffer, p: Policy.Policy, q: Query, m: Market)
{
  let evidence = sx_text(m["status"]);
  let count = m["matched"];
  if evidence != "matched" || count < q["minimum"]
  {
    var status = evidence;
    if status == "matched"
    {
      status = "insufficient_evidence";
    }
    text_field(out, "status", status);
    buffer_append(out, ",\"recommendation_minor\":null");
    return;
  }
  let prices = A.basis_array_array(count, 0);
  let weights = A.basis_array_array(count, 0);
  let series = sx_text(m["series"]);
  for i in 0 .. count
  {
    let row = CSV.line(series, i);
    A.basis_array_update(prices, i, C.number(row, 0));
    A.basis_array_update(weights, i, C.number(row, 1));
  }
  let d = Policy.decide(p, q["lead"], prices, weights, count);
  A.basis_array_destroy(prices);
  A.basis_array_destroy(weights);
  text_field(out, "status", "recommended");
  int_field(out, "recommendation_minor", d["price"]);
  int_field(out, "target_bps", d["target"]);
  int_field(out, "selected_bps", d["selected"]);
  int_field(out, "intended_minor", d["intended"]);
  int_field(out, "lower_minor", d["lower"]);
  int_field(out, "candidate_minor", d["candidate"]);
  text_field(out, "reason", sx_text(d["reason"]));
}

fn cell(out: buffer, q: Query, p: Policy.Policy, m: Market)
{
  let party = q["party"];
  buffer_append(out, "{\"id\":");
  buffer_append(out, F.num(q["id"]));
  text_field(out, "arrival", sx_text(q["arrival"]));
  text_field(out, "departure", sx_text(q["departure"]));
  int_field(out, "nights", party["nights"]);
  text_field(out, "as_of", sx_text(q["as_of"]));
  text_field(out, "currency", sx_text(q["currency"]));
  text_field(out, "cancellation", sx_text(q["cancellation"]));
  int_field(out, "adults", party["adults"]);
  text_field(out, "child_ages", sx_text(party["ages"]));
  int_field(out, "max_rooms", party["rooms"]);
  int_field(out, "min_properties", q["minimum"]);
  int_field(out, "policy", q["policy"]);
  int_field(out, "search_work", m["work"]);
  buffer_append(out, ",\"comparables\":");
  buffer_append(out, sx_text(m["comparables"]));
  decision(out, p, q, m);
  buffer_append(out, "}");
}

fn evaluate(snapshots: string, cells: string, policy_rows: string) -> string
{
  if text_len(cells) > cells_limit()
  {
    tool_fail("competitor cube: cell bytes exceed limit");
  }
  let n = CSV.rows(cells);
  if n < 3 || n > 50
  {
    tool_fail("competitor cube: expected 1..48 cells");
  }
  CSV.header(CSV.line(cells, 0), "pricing.competitor-cells@1");
  CSV.header(
    CSV.line(cells, 1),
    "id,arrival,departure,as_of,adults,child_ages,max_rooms,currency,cancellation,max_age_days,min_properties,search_budget,policy"
  );
  let ps = policies(policy_rows);
  let snapshot = C.parse(snapshots);
  let out = buffer_new();
  buffer_append(
    out,
    "{\"kind\":\"pricing.competitor-cube\",\"version\":1,\"basis\":\"guest_payable_minor_per_party_stay\",\"published\":false,\"cells\":["
  );
  var cache = sx_nil();
  var evaluated = 0;
  var last = 0;
  for i in 2 .. n
  {
    let q = query(CSV.line(cells, i));
    if q["id"] <= last
    {
      tool_fail("competitor cube: cell IDs must be strictly increasing");
    }
    last = q["id"];
    let p = policy_for(ps, q["policy"]);
    let key = sx_text(q["market_key"]);
    let hit = lookup(cache, key);
    var value = hit;
    if sx_kind(hit) == 0
    {
      value = cache_value(market(snapshot, q));
      cache = sx_cons(
        sx_cons(q["market_key"], sx_cons(value, sx_nil())),
        cache
      );
      evaluated = evaluated + 1;
    }
    if i != 2
    {
      buffer_append(out, ",");
    }
    cell(out, q, p, cache_read(value));
  }
  C.destroy(snapshot);
  buffer_append(out, "]");
  int_field(out, "market_evaluations", evaluated);
  buffer_append(out, "}");
  let bytes = buffer_text(out);
  if text_len(bytes) > 2097152
  {
    tool_fail("competitor cube: result exceeds archive byte limit");
  }
  return bytes;
}
