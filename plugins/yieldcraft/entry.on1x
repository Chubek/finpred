# Statically linked strategy boundary. The host supplies snapshot contents.
import core.contracts as C;
import sdk.static_host as Host;
import yieldcraft.matcher as Match;
import yieldcraft.strategy as Strategy;

fn recommend(mode: string, scenario_csv: string, offers_csv: string, valuation_csv: string)
  -> Strategy.Recommendation
{
  if !Host.yieldcraft(mode)
  { tool_fail("yieldcraft: capability denied"); }
  if text_len(scenario_csv) > 2000000 || text_len(valuation_csv) > 2000000
  { tool_fail("yieldcraft: source exceeds byte limit"); }
  let scenario = C.scenario_csv(scenario_csv);
  let valuation = C.valuation_csv(valuation_csv,scenario);
  let pool = Match.ingest(offers_csv,scenario);
  let dist = Match.distribution(pool,scenario);
  Match.destroy(pool);
  let result = Strategy.recommend(scenario,valuation,dist);
  Match.destroy_distribution(dist);
  return result;
}
