# The separate cube archive is a content-addressed manifest, not a pricing run.
import plugins.yieldcraft.competitor_cube as Cube;
import store.artifacts as Store;
import std.io.TextIO as IO;
import std.os.OS_FileSys as FS;

fn source(path:string, limit:i64) -> string
{
  let size = FS.basis_fs_file_size(path);
  if size < 1 || size > limit || FS.basis_fs_is_dir(path)
  { tool_fail("competitor cube: input missing or outside byte profile"); }
  let raw = IO.basis_text_io_input_all(path);
  if text_len(raw) != size { tool_fail("competitor cube: incomplete text input"); }
  return raw;
}
fn heading() -> string { return "finpred-competitor-cube@1\n"; }
fn manifest(snapshots:string, cells:string, policy:string, result:string) -> string
{
  let header = heading();
  return "$header$snapshots\n$cells\n$policy\n$result\n";
}
fn render(id:string, result:string)
{
  IO.basis_text_io_print("{\"cube_id\":\"$id\",\"cube\":$result}\n");
}
fn evaluate(home:string, snapshot_path:string, cells_path:string, policy_path:string) -> i64
{
  let snapshots = source(snapshot_path,Cube.snapshots_limit());
  let cells = source(cells_path,Cube.cells_limit());
  let policy = source(policy_path,Cube.policy_limit());
  let result = Cube.evaluate(snapshots,cells,policy);
  let sd = Store.digest(snapshots);
  let cd = Store.digest(cells);
  let pd = Store.digest(policy);
  let rd = Store.digest(result);
  Store.ensure(home);
  if Store.put(home,snapshots) != sd || Store.put(home,cells) != cd
    || Store.put(home,policy) != pd || Store.put(home,result) != rd
  { tool_fail("competitor cube: content address divergence"); }
  let id = Store.put(home,manifest(sd,cd,pd,rd));
  render(id,result);
  return 0;
}
fn pointer(bytes:string, index:i64) -> string
{
  let start = text_len(heading()) + index*65;
  let hash = text_slice(bytes,start,start+64);
  if !Store.valid_hash(hash) || text_byte(bytes,start+64) != 10
  { tool_fail("competitor cube: malformed archive identity"); }
  return hash;
}
fn replay(home:string, id:string) -> i64
{
  let bytes = Store.fetch(home,id);
  let header = heading();
  if text_len(bytes) != text_len(header)+260 || text_slice(bytes,0,text_len(header)) != header
  { tool_fail("competitor cube: malformed or unsupported archive"); }
  let sd = pointer(bytes,0);
  let cd = pointer(bytes,1);
  let pd = pointer(bytes,2);
  let rd = pointer(bytes,3);
  let result = Cube.evaluate(Store.fetch(home,sd),Store.fetch(home,cd),Store.fetch(home,pd));
  if result != Store.fetch(home,rd) { tool_fail("competitor cube: replay divergence"); }
  render(id,result);
  return 0;
}
