# Graph-path adapters only. The wire payloads below are internal to the new
# graph contracts; neither legacy pricing archives nor CSV inputs are changed.
import core.contracts as C;
import core.csv as CSV;
import core.format as F;
import plugins.yieldcraft.matcher as Match;
import plugins.yieldcraft.strategy as Strategy;
import automat.runner as Legacy;
import sdk.callable as SDK;
import std.collections.Array as A;
fn number(out: buffer, n: i64)
{
  buffer_append(out, ",");
  buffer_append(out, F.num(n));
}

fn nth(row: string, position: i64) -> i64
{
  return CSV.nat(CSV.field(row, position));
}

# Normalize to just the eligible inventory required by the matcher. The
# original frozen bytes, including rejected rows, remain an artifact parent.
fn normalize(s: C.Scenario, offers: string) -> string
{
  let pool = Match.ingest(offers, s);
  let out = buffer_new();
  buffer_append(out, "inventory@1");
  number(out, pool["count"]);
  number(out, pool["rejected"]);
  buffer_append(out, "\n");
  for i in 0 .. pool["count"]
  {
    buffer_append(out, F.num(A.basis_array_sub(pool["properties"], i)));
    number(out, A.basis_array_sub(pool["rooms"], i));
    number(out, A.basis_array_sub(pool["adults"], i));
    number(out, A.basis_array_sub(pool["children"], i));
    number(out, A.basis_array_sub(pool["capacity"], i));
    number(out, A.basis_array_sub(pool["gross"], i));
    buffer_append(out, "\n");
  }
  Match.destroy(pool);
  return buffer_text(out);
}

fn inventory(bytes: string) -> Match.Pool
{
  if text_len(bytes) > 65536
  {
    tool_fail("graph inventory: payload too large");
  }
  let size = CSV.rows(bytes);
  if size < 1 || size > 513
  {
    tool_fail("graph inventory: invalid row count");
  }
  let header = CSV.line(bytes, 0);
  CSV.require_width(header, 3);
  let count = nth(header, 1);
  let rejected = nth(header, 2);
  if CSV.field(
    header,
    0
  ) != "inventory@1" || count != size - 1 || rejected > 512 - count || count + rejected < 1
  {
    tool_fail("graph inventory: invalid header");
  }
  let properties = A.basis_array_array(count, 0);
  let rooms = A.basis_array_array(count, 0);
  let adults = A.basis_array_array(count, 0);
  let children = A.basis_array_array(count, 0);
  let capacity = A.basis_array_array(count, 0);
  let gross = A.basis_array_array(count, 0);
  for i in 0 .. count
  {
    let row = CSV.line(bytes, i + 1);
    CSV.require_width(row, 6);
    let p = nth(row, 0);
    let r = nth(row, 1);
    let a = nth(row, 2);
    let c = nth(row, 3);
    let t = nth(row, 4);
    let g = nth(row, 5);
    if p < 1 || r < 1 || a < 1 || a > 8 || c > 8 || t < 1 || t > 16 || g > 1000000000000
    {
      tool_fail("graph inventory: invalid room");
    }
    for j in 0 .. i
    {
      if A.basis_array_sub(properties, j) == p && A.basis_array_sub(
        rooms,
        j
      ) == r
      {
        tool_fail("graph inventory: duplicate room");
      }
    }
    A.basis_array_update(properties, i, p);
    A.basis_array_update(rooms, i, r);
    A.basis_array_update(adults, i, a);
    A.basis_array_update(children, i, c);
    A.basis_array_update(capacity, i, t);
    A.basis_array_update(gross, i, g);
  }
  return record<Match.Pool>
  { properties       : properties
  , rooms            : rooms
  , adults           : adults
  , children         : children
  , capacity         : capacity
  , gross            : gross
  , count            : count
  , rejected         : rejected
  , evidence         : false
  , source_rows      : 0
  , source_properties: 0
  };
}

fn comparables(s: C.Scenario, normalized: string) -> string
{
  let pool = inventory(normalized);
  let dist = Match.distribution(pool, s);
  Match.destroy(pool);
  let out = buffer_new();
  buffer_append(out, "distribution@1");
  number(out, dist["count"]);
  number(out, dist["rejected"]);
  number(out, dist["infeasible"]);
  number(out, dist["examined"]);
  buffer_append(out, "\n");
  for i in 0 .. dist["count"]
  {
    buffer_append(out, F.num(A.basis_array_sub(dist["prices"], i)));
    buffer_append(out, "\n");
  }
  Match.destroy_distribution(dist);
  return buffer_text(out);
}

# The caller owns and destroys the temporary handle.
fn distribution(bytes: string) -> Match.Distribution
{
  if text_len(bytes) > 8192
  {
    tool_fail("graph distribution: payload too large");
  }
  let size = CSV.rows(bytes);
  if size < 1 || size > 513
  {
    tool_fail("graph distribution: invalid row count");
  }
  let header = CSV.line(bytes, 0);
  CSV.require_width(header, 5);
  let count = nth(header, 1);
  let rejected = nth(header, 2);
  let infeasible = nth(header, 3);
  let examined = nth(header, 4);
  if CSV.field(
    header,
    0
  ) != "distribution@1" || count != size - 1 || rejected > 512 - count || infeasible > 512 - count - rejected || examined > 1000000 || examined < count + infeasible
  {
    tool_fail("graph distribution: invalid header");
  }
  let prices = A.basis_array_array(count, 0);
  for i in 0 .. count
  {
    let price = CSV.nat(CSV.line(bytes, i + 1));
    if price > 4000000000000
    {
      tool_fail("graph distribution: invalid price");
    }
    A.basis_array_update(prices, i, price);
  }
  return record<Match.Distribution>
  { prices    : prices
  , count     : count
  , rejected  : rejected
  , infeasible: infeasible
  , examined  : examined
  };
}

fn decide(
  s: C.Scenario,
  v: C.Valuation,
  bytes: string,
  sample: string,
  profile: string
) -> C.Recommendation
{
  let dist = distribution(bytes);
  let minimum = s["min_properties"];
  let count = dist["count"];
  if count < minimum
  {
    Match.destroy_distribution(dist);
    tool_fail("insufficient_evidence: too few independent, bookable properties");
  }
  if CSV.rows(sample) != 1
  {
    tool_fail("graph sample: malformed diagnostic");
  }
  let row = CSV.line(sample, 0);
  CSV.require_width(row, 5);
  if CSV.field(row, 0) != "sample@1" || nth(row, 1) != count || nth(
    row,
    2
  ) != minimum || nth(row, 3) != 1 || nth(row, 4) > 4000000000000
  {
    Match.destroy_distribution(dist);
    tool_fail("graph sample: inconsistent diagnostic");
  }
  let result = Strategy.recommend_profile(s, v, dist, profile);
  Match.destroy_distribution(dist);
  return result;
}

fn recommendation_bytes(r: C.Recommendation) -> string
{
  let out = buffer_new();
  buffer_append(out, "recommendation@1");
  number(out, r["intended_bps"]);
  number(out, r["selected_bps"]);
  number(out, r["intended_cents"]);
  number(out, r["lower_cents"]);
  number(out, r["candidate_cents"]);
  number(out, r["recommended_cents"]);
  number(out, r["property_count"]);
  number(out, r["rejected"]);
  number(out, r["infeasible"]);
  number(out, r["search_nodes"]);
  buffer_append(out, ",");
  buffer_append(out, sx_text(r["reason"]));
  buffer_append(out, "\n");
  return buffer_text(out);
}

fn recommendation(bytes: string) -> C.Recommendation
{
  if text_len(bytes) > 512 || CSV.rows(bytes) != 1
  {
    tool_fail("graph recommendation: invalid payload");
  }
  let row = CSV.line(bytes, 0);
  CSV.require_width(row, 12);
  let reason = CSV.field(row, 11);
  if CSV.field(
    row,
    0
  ) != "recommendation@1" || (reason != "target_percentile" && reason != "lower_percentile_shortcut" && reason != "guardrail_adjustment")
  {
    tool_fail("graph recommendation: invalid header or reason");
  }
  let r = record<C.Recommendation>
  { intended_bps     : nth(row, 1)
  , selected_bps     : nth(row, 2)
  , intended_cents   : nth(row, 3)
  , lower_cents      : nth(row, 4)
  , candidate_cents  : nth(row, 5)
  , recommended_cents: nth(row, 6)
  , property_count   : nth(row, 7)
  , rejected         : nth(row, 8)
  , infeasible       : nth(row, 9)
  , search_nodes     : nth(row, 10)
  , reason           : sx_string(reason)
  };
  if recommendation_bytes(r) != bytes
  {
    tool_fail("graph recommendation: noncanonical payload");
  }
  return r;
}

fn guardrails(s: C.Scenario, v: C.Valuation, candidate: string) -> bool
{
  return Legacy.within_limits(recommendation(candidate), s, v);
}

# These pure, positional callbacks implement no lookup or admission policy.
# The trusted SDK host supplies their metadata and calls them only after the
# protocol has checked arity, state, and byte bounds.
fn request_bytes(req: SDK.Request, position: i64) -> string
{
  return sx_text(SDK.value_bytes(SDK.port_at(req["inputs"], position)));
}

fn at_cutoff(req: SDK.Request, scenario: C.Scenario) -> bool
{
  return SDK.same(req["cutoff"], scenario["decision_at"]);
}

fn normalize_call(req: SDK.Request) -> SDK.Outcome
{
  let scenario = C.scenario_csv(request_bytes(req, 0));
  if ! at_cutoff(req, scenario)
  {
    return SDK.failure(5);
  }
  return SDK.success(1, normalize(scenario, request_bytes(req, 1)));
}

fn comparables_call(req: SDK.Request) -> SDK.Outcome
{
  let scenario = C.scenario_csv(request_bytes(req, 0));
  if ! at_cutoff(req, scenario)
  {
    return SDK.failure(5);
  }
  if req["work"] < scenario["search_budget"]
  {
    return SDK.failure(4);
  }
  return SDK.success(1, comparables(scenario, request_bytes(req, 1)));
}

fn decide_call(req: SDK.Request) -> SDK.Outcome
{
  let scenario = C.scenario_csv(request_bytes(req, 0));
  if ! at_cutoff(req, scenario)
  {
    return SDK.failure(5);
  }
  let v = C.valuation_csv(request_bytes(req, 1), scenario);
  let distribution = request_bytes(req, 2);
  let sample = request_bytes(req, 3);
  # The sample callback has computed sufficiency independently. Unlike the
  # legacy direct entry point, the graph can return a typed failure here.
  if CSV.rows(sample) == 1
  {
    let row = CSV.line(sample, 0);
    if CSV.columns(row) == 5 && CSV.field(row, 0) == "sample@1" && CSV.field(
      row,
      3
    ) == "0"
    {
      return SDK.failure(5);
    }
  }
  return SDK.success(
    1,
    recommendation_bytes(decide(scenario, v, distribution, sample, "scenario"))
  );
}

fn guardrails_call(req: SDK.Request) -> SDK.Outcome
{
  let scenario = C.scenario_csv(request_bytes(req, 0));
  if ! at_cutoff(req, scenario)
  {
    return SDK.failure(5);
  }
  let v = C.valuation_csv(request_bytes(req, 1), scenario);
  let candidate = request_bytes(req, 2);
  if ! guardrails(scenario, v, candidate)
  {
    return SDK.failure(5);
  }
  return SDK.success(1, candidate);
}
