{
  "$id": "https://example.invalid/finpred/plugins/dragnet/contracts/dragnet.crossref-evidence@1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragnet frozen Crossref evidence",
  "description": "Plugin-local offline evidence, not a FinPRED pricing contract. Shape validation does not establish chronology, source authenticity, policy authorization, or a match between digest references and frozen bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "mode", "provider", "search_scope", "request_url", "doi",
    "as_of", "search_times", "work_times", "terms_ref", "retention_ref",
    "evidence", "fields"
  ],
  "properties": {
    "format": { "const": "dragnet.crossref-evidence@1" },
    "mode": { "const": "offline" },
    "provider": { "const": "crossref" },
    "search_scope": { "const": "single_frozen_page" },
    "request_url": {
      "$comment": "The query is 1–128 decoded printable ASCII bytes, excluding backslash and not all spaces. Unreserved bytes are literal; other bytes use uppercase percent escapes.",
      "type": "string",
      "pattern": "^https://api\\.crossref\\.org/works\\?query=(?!(?:%20){1,128}&)(?:[A-Za-z0-9._~-]|%(?:2[0-9A-CF]|3[A-F]|40|5[BDE]|60|7[B-D])){1,128}&rows=16&select=title,URL(?![\\s\\S])"
    },
    "doi": {
      "type": "string",
      "minLength": 9,
      "maxLength": 255,
      "pattern": "^10\\.[0-9]{4,9}/[a-z0-9._()/;-]+(?![\\s\\S])"
    },
    "as_of": { "$ref": "#/$defs/timestamp" },
    "search_times": { "$ref": "#/$defs/times" },
    "work_times": { "$ref": "#/$defs/times" },
    "terms_ref": { "$ref": "#/$defs/policy_ref" },
    "retention_ref": { "$ref": "#/$defs/policy_ref" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "search", "work", "search_decode", "work_decode"],
      "properties": {
        "request": { "$ref": "#/$defs/blake3_ref" },
        "search": { "$ref": "#/$defs/blake3_ref" },
        "work": { "$ref": "#/$defs/blake3_ref" },
        "search_decode": { "$ref": "#/$defs/blake3_ref" },
        "work_decode": { "$ref": "#/$defs/blake3_ref" }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 3,
      "properties": {
        "title": { "$ref": "#/$defs/work_field" },
        "publisher": { "$ref": "#/$defs/work_field" },
        "type": { "$ref": "#/$defs/work_field" }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "$comment": "Exact UTC seconds and Gregorian dates in the importer's 1970–2399 range, even if format is only an annotation.",
      "type": "string",
      "pattern": "^(?:19[7-9][0-9]|2[0-3][0-9]{2})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])",
      "not": { "pattern": "^[0-9]{4}-(?:(?:0[469]|11)-31|02-3[01])T" },
      "if": { "pattern": "^[0-9]{4}-02-29T" },
      "then": { "pattern": "^(?:19(?:7[26]|8[048]|9[26])|2000|2[0-3](?:0[48]|[2468][048]|[13579][26]))-" },
      "format": "date-time"
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "ingested_at"],
      "properties": {
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "ingested_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "blake3_ref": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}(?![\\s\\S])"
    },
    "work_field": {
      "$comment": "JSON Schema counts code points; the importer separately caps decoded UTF-8 at 1024 bytes.",
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+(?![\\s\\S])"
    }
  }
}
