{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finpred:dragnet:config:1",
  "title": "Trusted operator Dragnet configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "keywords", "extraction", "as_of", "max_results", "interval_seconds", "transport"],
  "properties": {
    "version": {"const": 1},
    "provider": {"enum": ["google", "bing"]},
    "keywords": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*[^ \\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"}
    },
    "extraction": {"enum": ["basic", "offer-csv-v1", "gpt"]},
    "as_of": {"oneOf": [
      {"const": "now"},
      {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
    ]},
    "max_results": {"type": "integer", "minimum": 1, "maximum": 10},
    "interval_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "transport": {"enum": ["offline", "https"]},
    "fixtures": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "llm_fixtures": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "llm_task": {"type": "string", "minLength": 1, "maxLength": 2048},
    "env_file": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "OPENAI_API_KEY": {"type": "string"},
        "OPENAI_ACCESS_TOKEN": {"type": "string"},
        "OPENAI_BASE_URL": {"type": "string"},
        "OPENAI_MODEL": {"type": "string"},
        "OPENAI_ORG_ID": {"type": "string"},
        "OPENAI_PROJECT_ID": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"transport": {"const": "offline"}}},
      "then": {"required": ["fixtures"], "properties": {"as_of": {"not": {"const": "now"}}}},
      "else": {"not": {"anyOf": [{"required": ["fixtures"]}, {"required": ["llm_fixtures"]}]}}
    },
    {
      "if": {"properties": {"extraction": {"const": "gpt"}}},
      "then": {
        "if": {"properties": {"transport": {"const": "offline"}}},
        "then": {"required": ["llm_fixtures"]}
      },
      "else": {"not": {"anyOf": [
        {"required": ["env_file"]}, {"required": ["environment"]}, {"required": ["llm_fixtures"]},
        {"required": ["llm_task"]}
      ]}}
    }
  ]
}
