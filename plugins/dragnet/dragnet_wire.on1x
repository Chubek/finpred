# Shared framing for canonical Dragnet capture cycles.
import core.format as F;
fn limit() -> i64
{
  return 2000000;
}

fn max_pages() -> i64
{
  return 80;
}

fn header(
  provider: string,
  extraction: string,
  handler: string,
  transport: string,
  cutoff: string
) -> string
{
  let p = F.q(provider);
  let x = F.q(extraction);
  let h = F.q(handler);
  let t = F.q(transport);
  let a = F.q(cutoff);
  return "{\"format\":\"dragnet.batch@1\",\"provider\":$p,\"extraction\":$x,\"handler\":$h,\"transport\":$t,\"requested_as_of\":$a}\n";
}

fn trailer(pages: i64, digest: string) -> string
{
  let n = F.num(pages);
  let d = F.q(digest);
  return "{\"format\":\"dragnet.batch-end@1\",\"pages\":$n,\"batch_digest\":$d}\n";
}
