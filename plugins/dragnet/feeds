#!/bin/sh
# Explicit foreground host; no init integration or FinPRED store selection.
set -eu
umask 077
export LC_ALL=C
pkg=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tools=${DRAGNET_FEEDS_BIN:-"$pkg/../../target/dragnet-feeds"}
stage=
child=

die() { echo "dragnet feeds: $*" >&2; exit 2; }
stop_child() {
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null || :
    wait "$child" 2>/dev/null || :
    child=
  fi
}
cleanup() {
  stop_child
  if [ -n "$stage" ]; then
    chmod u+w -- "$stage" 2>/dev/null || :
    rm -f -- "$stage/capture.csv" "$stage/body" "$stage/as-of.txt" \
      "$stage/decode" "$stage/observation.json" "$stage/fetch-status" "$stage/checkpoint"
    rmdir -- "$stage"
    stage=
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

safe_ref() {
  case $1 in ''|*[!a-zA-Z0-9_.-]*) return 1;; esac
  [ "${#1}" -le 64 ]
}

copy_bounded() {
  [ -f "$1" ] || return 1
  head -c "$(($3 + 1))" -- "$1" > "$2" || return 1
  [ "$(wc -c < "$2")" -le "$3" ]
}

recompute() {
  provider=$(sed -n '2s/,.*//p' "$stage/capture.csv")
  case $provider in ecb|eurostat) ;; *) return 1;; esac
  timeout --kill-after=2s 10s "$tools/dragnet-feed-decode" "$provider" \
    < "$stage/body" > "$stage/decode" || return 1
  normalize
}

normalize() {
  timeout --kill-after=2s 10s "$tools/dragnet-feed-normalize" \
    3<"$stage/capture.csv" 4<"$stage/body" 5<"$stage/decode" 6<"$stage/as-of.txt" \
    > "$stage/observation.json"
}

write_capture() {
  printf 'dragnet.feed-capture@1\n%s,%s,%s,%s,%s,%s\n' \
    "$provider" "$mode" "$receipt" "$ingest" "$terms" "$retention" > "$stage/capture.csv" &&
    printf '%s\n' "$ingest" > "$stage/as-of.txt"
}

case "${1:-}" in
  import)
    [ "$#" -eq 4 ] || die "usage: feeds import CAPTURE_CSV RAW_BODY AS_OF_UTC"
    [ "${#4}" -eq 20 ] || die "expected UTC cutoff"
    stage=$(mktemp -d "${TMPDIR:-/tmp}/dragnet-import.XXXXXXXX")
    copy_bounded "$2" "$stage/capture.csv" 512 &&
      copy_bounded "$3" "$stage/body" 65536 || die "invalid frozen inputs"
    printf '%s\n' "$4" > "$stage/as-of.txt"
    recompute || die "snapshot rejected"
    cat -- "$stage/observation.json"
    exit
    ;;
  verify)
    [ "$#" -eq 2 ] || die "usage: feeds verify CAPTURE_DIRECTORY"
    stage=$(mktemp -d "${TMPDIR:-/tmp}/dragnet-verify.XXXXXXXX")
    copy_bounded "$2/capture.csv" "$stage/capture.csv" 512 &&
      copy_bounded "$2/body" "$stage/body" 65536 &&
      copy_bounded "$2/as-of.txt" "$stage/as-of.txt" 21 &&
      [ -f "$2/observation.json" ] || die "invalid evidence bundle"
    recompute && head -c 8193 -- "$2/observation.json" | cmp -s "$stage/observation.json" - ||
      die "stored evidence mismatch"
    echo dragnet_feed_replay_ok=true
    exit
    ;;
  poll)
    [ "$#" -eq 6 ] && [ "$2" = --accept-public-terms ] ||
      die "usage: feeds poll --accept-public-terms PRIVATE_SPOOL TERMS_REF RETENTION_REF ROUNDS"
    mode=public_https
    fetch=$tools/dragnet-feed-fetch
    case $6 in [1-9]|1[0-9]|2[0-4]) ;; *) die "rounds must be 1..24";; esac
    rounds=$6
    ;;
  poll-fixture)
    [ "$#" -eq 5 ] || die "usage: feeds poll-fixture PORT PRIVATE_SPOOL TERMS_REF RETENTION_REF"
    mode=loopback_fixture
    fetch=$tools/dragnet-feed-fetch-loopback-fixture
    case $2 in ''|*[!0-9]*) die "invalid loopback port";; esac
    [ "${#2}" -le 5 ] || die "invalid loopback port"
    rounds=1
    ;;
  *) die "expected import, verify, poll or poll-fixture";;
esac

[ -x "$fetch" ] && [ -x "$tools/dragnet-feed-decode" ] && [ -x "$tools/dragnet-feed-normalize" ] ||
  die "build the standalone feed tools first"
safe_ref "$4" && safe_ref "$5" || die "invalid terms or retention policy reference"
spool=$(realpath -e -- "$3") || die "spool must already exist"
[ -d "$spool" ] && [ "$(stat -c '%u:%a' -- "$spool")" = "$(id -u):700" ] ||
  die "use a trusted, separate 0700 spool owned by the operator"
# The spool is a trusted, cooperating-operator archive, not a sandbox or the
# FinPRED store. The lock and rate checkpoints are not immutable evidence.
exec 9>>"$spool/.dragnet-feed-lock"
flock -n 9 || die "spool is already in use"

event() {
  printf '{"format":"dragnet.feed-poll@1","provider":"%s","status":"%s","detail":"%s"}\n' \
    "$provider" "$1" "$2"
}

acquire() {
  provider=$1
  shift
  rate="$spool/.dragnet-$mode-$provider-next"
  now=$(date -u +%s) || return 2
  next=0
  if [ -e "$rate" ]; then
    next=$(head -c 13 -- "$rate") || return 2
    case $next in ''|*[!0-9]*) event failed invalid_checkpoint; return 2;; esac
    # Canonical positive Unix timestamp, no shell octal or unbounded integer.
    case $next in 0*) event failed invalid_checkpoint; return 2;; esac
    [ "${#next}" -le 12 ] || { event failed invalid_checkpoint; return 2; }
  fi
  if [ "$now" -lt "$next" ]; then event deferred rate_limited; return 2; fi
  stage=$(mktemp -d "$spool/.incoming.XXXXXXXX") || return 2
  # Record the attempt *before* contacting the provider; an interrupted
  # acquisition does not authorize an immediate retry. No retry within round.
  if ! printf '%s\n' "$((now + 3601))" > "$stage/checkpoint" ||
     ! mv -T -- "$stage/checkpoint" "$rate"; then
    event failed checkpoint_write; cleanup; return 2
  fi
  # Clean transport environment: no ambient proxy, CA override, .netrc,
  # SSL key log, or credentials. No user-provided URL.
  env -i PATH=/usr/bin:/bin timeout --kill-after=2s 15s "$fetch" "$provider" "$@" \
    > "$stage/body" 2> "$stage/fetch-status" &
  child=$!
  while kill -0 "$child" 2>/dev/null; do sleep 0.2; done
  if wait "$child"; then
    child=
  else
    child=
    detail=$(head -c 64 -- "$stage/fetch-status")
    case $detail in transport_setup|content_encoding|provider_backoff|http_status|timeout|\
                    transfer_limit|incomplete_transfer|content_type|local_clock|output_error) ;;
      *) detail=worker_failed;;
    esac
    event failed "$detail"; cleanup; return 2
  fi
  receipt=$(head -c 22 -- "$stage/fetch-status")
  if ! timeout --kill-after=2s 10s "$tools/dragnet-feed-decode" "$provider" \
    < "$stage/body" > "$stage/decode"; then
    event failed invalid_snapshot; cleanup; return 2
  fi
  # Preflight never leaves staging. Timestamp ingestion only after the
  # decoder and On1x validation have accepted the entire body.
  ingest=$receipt
  if ! write_capture || ! normalize ||
     ! ingest=$(date -u -d '+1 second' '+%Y-%m-%dT%H:%M:%SZ') ||
     ! write_capture || ! normalize; then
    event failed invalid_capture; cleanup; return 2
  fi
  state=complete
  if grep -Fq '"status":"partial"' "$stage/observation.json"; then state=partial; fi
  name="$mode-$provider-${stage##*.}"
  if ! rm -- "$stage/decode" "$stage/fetch-status" ||
     ! chmod 400 -- "$stage/capture.csv" "$stage/body" "$stage/as-of.txt" "$stage/observation.json" ||
     ! chmod 500 -- "$stage" ||
     ! mv -T --no-clobber -- "$stage" "$spool/$name" || [ -e "$stage" ]; then
    event failed archive_install; cleanup; return 2
  fi
  stage=
  event "$state" "$name"
  [ "$state" = complete ]
}

terms=$4
retention=$5
if [ "$mode" = loopback_fixture ]; then set -- "$2"; else set --; fi
round=1
outcome=0
while [ "$round" -le "$rounds" ]; do
  failed=0
  acquire ecb "$@" || failed=$((failed + 1))
  acquire eurostat "$@" || failed=$((failed + 1))
  if [ "$failed" -ne 0 ]; then outcome=1; fi
  round=$((round + 1))
  if [ "$round" -le "$rounds" ]; then
    sleep 3601 &
    child=$!
    wait "$child"
    child=
  fi
done
exit "$outcome"
