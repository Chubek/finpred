# The offline operator selects five unchanged regular files. No response can
# choose paths; the importer never calls the standalone decoder itself.
import dragnet.frozen_crossref as Dragnet;
import std.os.OS_FileSys as FS;
import std.io.TextIO as IO;
fn snapshot(slot: string, limit: i64) -> string
{
  let size = FS.basis_fs_file_size(slot);
  if FS.basis_fs_is_dir(slot) || size < 1 || size > limit
  {
    tool_fail("crossref host: supply bounded frozen inputs on fd 3 through 7");
  }
  let data = IO.basis_text_io_input_all(slot);
  if text_len(data) != size
  {
    tool_fail("crossref host: incomplete or changed input");
  }
  return data;
}

fn main() -> i64
{
  let observation = Dragnet.evidence_as_of(
    snapshot("/proc/self/fd/3", 1024),
    snapshot("/proc/self/fd/4", 262144),
    snapshot("/proc/self/fd/5", 262144),
    snapshot("/proc/self/fd/6", 16384),
    snapshot("/proc/self/fd/7", 16384)
  );
  IO.basis_text_io_print(observation);
  return 0;
}
