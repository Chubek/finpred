# Offline On1x host: only inherited snapshots; no admission or store changes.
import dragnet.public_feeds as Feeds;
import core.csv as CSV;
import std.os.OS_FileSys as FS;
import std.io.TextIO as IO;

fn snapshot(slot: string, limit: i64) -> string
{
  let n = FS.basis_fs_file_size(slot);
  if FS.basis_fs_is_dir(slot) || n < 1 || n > limit
  { tool_fail("feed host: expected bounded regular snapshots on fd 3–6"); }
  let bytes = IO.basis_text_io_input_all(slot);
  if text_len(bytes) != n { tool_fail("feed host: changed or incomplete snapshot"); }
  return bytes;
}

fn main() -> i64
{
  let cutoff = snapshot("/proc/self/fd/6",21);
  if text_len(cutoff) != 21 || text_byte(cutoff,20) != 10
  { tool_fail("feed host: invalid cutoff framing"); }
  let result = Feeds.normalize(snapshot("/proc/self/fd/3",512),snapshot("/proc/self/fd/4",65536),
    snapshot("/proc/self/fd/5",4096),CSV.line(cutoff,0));
  IO.basis_text_io_print(result);
  return 0;
}
