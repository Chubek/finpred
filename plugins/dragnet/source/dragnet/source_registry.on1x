# Trusted static Source bindings for sdk.callable. No registry mutation,
# filesystem, environment, clock, network, or capture/transport authority.
import core.contracts as Contracts;
import core.date as Date;
import core.format as F;
import dragnet.frozen_csv as FrozenCSV;
import dragnet.frozen_crossref as Crossref;
import dragnet.public_feeds as Feeds;
import dragnet.source_identity as Identity;
import sdk.registry as Legacy;
import sdk.callable as SDK;
import std.crypto.crypto as Crypto;

fn frozen_key() -> string { return "dragnet.frozen_csv@1"; }
fn crossref_key() -> string { return "dragnet.crossref@1"; }
fn ecb_key() -> string { return "dragnet.public-feed.ecb@1"; }
fn eurostat_key() -> string { return "dragnet.public-feed.eurostat@1"; }
fn public_key() -> string { return "dragnet.public-feed@1"; }
fn frozen_gate() -> string { return "dragnet.frozen_csv.offers_as_of"; }

fn port(name:string, kind:string, unit:string, currency:string, states:i64, limit:i64) -> SDK.Port
{
  return record<SDK.Port>{name:sx_string(name),kind:sx_string(kind),major:1,unit:sx_string(unit),
    currency:sx_string(currency),states:states,max_bytes:limit};
}
fn input(name:string, kind:string, currency:string, limit:i64, rest:sexpr) -> sexpr
{
  return sx_cons(SDK.port_entry(port(name,kind,"none",currency,1,limit)),rest);
}
fn capture_port() -> SDK.Port { return port("capture","dragnet.feed-capture","none","none",1,512); }
fn feed_inputs(raw_kind:string, decode_kind:string) -> sexpr
{
  return sx_cons(SDK.port_entry(capture_port()),
    input("raw",raw_kind,"none",65536,input("decode",decode_kind,"none",4096,sx_nil())));
}
fn frame(out:buffer, value:string)
{
  buffer_append(out,F.num(text_len(value))); buffer_append(out,":"); buffer_append(out,value);
}
fn frame_port(out:buffer, p:SDK.Port)
{
  frame(out,sx_text(p["name"])); frame(out,sx_text(p["kind"])); frame(out,F.num(p["major"]));
  frame(out,sx_text(p["unit"])); frame(out,sx_text(p["currency"]));
  frame(out,F.num(p["states"])); frame(out,F.num(p["max_bytes"]));
}
fn binding(package_name:string, key:string, clock_policy:string, inputs:sexpr, output:SDK.Port) -> SDK.Descriptor
{
  let policy = buffer_new();
  frame(policy,"dragnet.static-source-policy@1"); frame(policy,key);
  frame(policy,"Source"); frame(policy,"analysis"); frame(policy,"pure");
  frame(policy,"no-grants"); frame(policy,clock_policy); frame(policy,"1");
  frame_port(policy,output);
  var rest = inputs;
  while sx_kind(rest) == 3 {
    frame_port(policy,SDK.decode_port(sx_head(rest))); rest = sx_tail(rest);
  }
  let (status,hash) = Crypto.basis_crypto_blake3(buffer_text(policy));
  if status != 0 || text_len(hash) != 64 { return SDK.unavailable(); }
  let pin = record<SDK.Pin>{package_name:sx_string(package_name),package_version:sx_string("1.0.0"),
    handler_name:sx_string(key),handler_version:sx_string("1"),abi:1,
    code_digest:sx_string(Identity.code_digest()),policy_digest:sx_string("blake3:$hash")};
  return record<SDK.Descriptor>{enabled:true,pin:pin,role:sx_string("Source"),mode:sx_string("analysis"),
    effect:sx_string("pure"),inputs:inputs,output:output,max_work:1};
}
fn lookup(key:string) -> SDK.Descriptor
{
  let nil = sx_nil();
  if key == frozen_key() {
    # Keep the original dependency/admission check on the same binding.
    if !Legacy.admits(frozen_gate(),"analysis") { return SDK.unavailable(); }
    let ports = input("scenario","hospitality.scenario","EUR",2000000,
      input("offers","finpred.offers.csv","none",2000000,nil));
    return binding("dragnet.frozen_csv",key,"scenario.decision_at=SDK.cutoff;legacy-frozen-csv-admission",
      ports,port("offers","hospitality.offer","minor_per_stay","EUR",5,2000000));
  }
  if key == crossref_key() {
    let ports = input("request","dragnet.crossref-request","none",1024,
      input("search_raw","dragnet.crossref-search-json","none",262144,
      input("work_raw","dragnet.crossref-work-json","none",262144,
      input("search_decode","dragnet.crossref-search-decode","none",16384,
      input("work_decode","dragnet.crossref-work-decode","none",16384,nil)))));
    return binding("dragnet.crossref",key,"request.as_of=SDK.cutoff",
      ports,port("evidence","dragnet.crossref-evidence","none","none",1,65536));
  }
  if key == ecb_key() {
    let ports = feed_inputs("dragnet.ecb-xml","dragnet.ecb-decode");
    return binding("dragnet.public-feed",key,"SDK.cutoff;capture.provider=ecb",
      ports,port("snapshot","dragnet.ecb-fx-reference","quote_currency_per_EUR","EUR",1,8192));
  }
  if key == eurostat_key() {
    let ports = feed_inputs("dragnet.eurostat-jsonstat","dragnet.eurostat-decode");
    return binding("dragnet.public-feed",key,"SDK.cutoff;capture.provider=eurostat",
      ports,port("snapshot","dragnet.eurostat-accommodation-nights","guest_nights","none",3,4096));
  }
  return SDK.unavailable();
}
fn payload(req:SDK.Request, index:i64) -> string
{
  return sx_text(SDK.value_bytes(SDK.port_at(req["inputs"],index)));
}

# Trusted invocation callback, supplied together with lookup to SDK.invoke.
# Legacy parsers fail closed with their existing terminal diagnostics.
fn call(pin:SDK.Pin, req:SDK.Request) -> SDK.Outcome
{
  let key = sx_text(pin["handler_name"]);
  let cutoff = sx_text(req["cutoff"]);
  if key == frozen_key() {
    let scenario = Contracts.scenario_csv(payload(req,0));
    if sx_text(scenario["decision_at"]) != cutoff { return SDK.failure(5); }
    let bytes = FrozenCSV.offers_as_of(payload(req,1),scenario);
    if text_len(bytes) == 0 { return SDK.success(4,bytes); }
    return SDK.success(1,bytes);
  }
  if key == crossref_key() {
    let request = payload(req,0);
    if Crossref.request_as_of(request) != cutoff { return SDK.failure(5); }
    return SDK.success(1,Crossref.evidence_as_of(request,payload(req,1),payload(req,2),
      payload(req,3),payload(req,4)));
  }
  var provider = "";
  if key == ecb_key() { provider = "ecb"; }
  if key == eurostat_key() { provider = "eurostat"; }
  if provider == "" { return SDK.failure(1); }
  let (bytes,state) = Feeds.normalize_profile(payload(req,0),payload(req,1),payload(req,2),cutoff,provider);
  return SDK.success(state,bytes);
}

# Compatibility shim for the existing P0b fd protocol and On1x callers.
# It adapts the same trusted SDK descriptors; the public-feed selector is
# only a framing mux, not a separate callable binding or authority.
record SourceDescriptor {
  name:sexpr, version:sexpr, mode:sexpr, effect:sexpr,
  output_kind:sexpr, output_format:sexpr, max_input_bytes:i64, enabled:bool
}
record SourceOutcome { source:sexpr, contract:sexpr, format:sexpr, bytes:sexpr }

fn legacy_binding(name:string, mode:string) -> SDK.Descriptor
{
  if name == frozen_key() || name == crossref_key() { return SDK.resolve(name,mode,lookup); }
  return SDK.unavailable();
}
fn feed_binding(capture:string, mode:string) -> SDK.Descriptor
{
  if !admitted(public_key(),mode) { return SDK.unavailable(); }
  if !SDK.valid_value(capture_port(),1,sx_string(capture))
  { tool_fail("dragnet source: invalid public feed inputs"); }
  let provider = Feeds.capture_provider(capture);
  if provider == "ecb" { return SDK.resolve(ecb_key(),mode,lookup); }
  if provider == "eurostat" { return SDK.resolve(eurostat_key(),mode,lookup); }
  tool_fail("feed: unknown source");
  return SDK.unavailable();
}
fn feed_admission(mode:string) -> SDK.Descriptor
{
  # Metadata/admission only; this is never the mux's invocation profile.
  let ecb = SDK.resolve(ecb_key(),mode,lookup);
  if ecb["enabled"] { return ecb; }
  return SDK.resolve(eurostat_key(),mode,lookup);
}
fn compatibility_binding(name:string, mode:string) -> SDK.Descriptor
{
  if name == public_key() { return feed_admission(mode); }
  return legacy_binding(name,mode);
}
fn admitted(name:string, mode:string) -> bool
{
  let d = compatibility_binding(name,mode);
  return d["enabled"];
}
fn describe(name:string, d:SDK.Descriptor) -> SourceDescriptor
{
  if !d["enabled"] {
    let empty = sx_string("");
    return record<SourceDescriptor>{name:empty,version:empty,mode:empty,effect:empty,
      output_kind:empty,output_format:empty,max_input_bytes:0,enabled:false};
  }
  let pin = d["pin"];
  let output = d["output"];
  let kind = sx_text(output["kind"]);
  var output_kind = "$kind@1";
  var format = "json";
  if name == frozen_key() { format = "ndjson"; }
  if name == public_key() { output_kind = public_key(); }
  var limit = 0;
  var inputs = d["inputs"];
  while sx_kind(inputs) == 3 {
    let port = SDK.decode_port(sx_head(inputs));
    if port["max_bytes"] > limit { limit = port["max_bytes"]; }
    inputs = sx_tail(inputs);
  }
  return record<SourceDescriptor>{name:sx_string(name),version:pin["package_version"],
    mode:d["mode"],effect:d["effect"],output_kind:sx_string(output_kind),output_format:sx_string(format),
    max_input_bytes:limit,enabled:true};
}
fn descriptor(name:string) -> SourceDescriptor
{
  return describe(name,compatibility_binding(name,"analysis"));
}
fn input_limit(name:string, index:i64) -> i64
{
  let d = compatibility_binding(name,"analysis");
  let p = SDK.decode_port(SDK.port_at(d["inputs"],index));
  return p["max_bytes"];
}
fn value(bytes:string, rest:sexpr) -> sexpr { return sx_cons(SDK.value_entry(1,bytes),rest); }
fn invoke_values(name:string, mode:string, values:sexpr, as_of:string) -> SourceOutcome
{
  if !admitted(name,mode) { tool_fail("dragnet source: denied or unknown source"); }
  var d = legacy_binding(name,mode);
  var cutoff = as_of;
  if name == public_key() {
    let capture = SDK.port_at(values,0);
    if text_len(as_of) != 20 || !SDK.valid_inputs(
      sx_cons(SDK.port_entry(capture_port()),sx_nil()),sx_cons(capture,sx_nil()))
    { tool_fail("dragnet source: invalid public feed inputs"); }
    if !Date.utc_timestamp(as_of) { tool_fail("feed: expected second-precision UTC clock"); }
    d = feed_binding(sx_text(SDK.value_bytes(capture)),mode);
  }
  if !d["enabled"] { tool_fail("dragnet source: denied or unknown source"); }
  if !SDK.valid_inputs(d["inputs"],values) {
    if name == frozen_key() { tool_fail("dragnet source: invalid frozen CSV inputs"); }
    if name == crossref_key() { tool_fail("dragnet source: invalid Crossref inputs"); }
    tool_fail("dragnet source: invalid public feed inputs");
  }
  let first = sx_text(SDK.value_bytes(SDK.port_at(values,0)));
  if name == frozen_key() {
    let scenario = Contracts.scenario_csv(first);
    cutoff = sx_text(scenario["decision_at"]);
  }
  if name == crossref_key() { cutoff = Crossref.request_as_of(first); }
  let request = record<SDK.Request>{inputs:values,cutoff:sx_string(cutoff),work:1};
  let outcome = SDK.invoke(d["pin"],mode,request,lookup,call);
  if outcome["status"] != 0 { tool_fail("dragnet source: SDK invocation failed"); }
  let compat = describe(name,d);
  return record<SourceOutcome>{source:compat["name"],contract:compat["output_kind"],
    format:compat["output_format"],bytes:outcome["bytes"]};
}
fn invoke(name:string, mode:string, first:string, second:string,
  third:string, fourth:string, fifth:string) -> SourceOutcome
{
  if !admitted(name,mode) { tool_fail("dragnet source: denied or unknown source"); }
  let nil = sx_nil();
  if name == frozen_key() {
    if third != "" || fourth != "" || fifth != ""
    { tool_fail("dragnet source: invalid frozen CSV inputs"); }
    return invoke_values(name,mode,value(first,value(second,nil)),"");
  }
  if name == crossref_key() {
    return invoke_values(name,mode,value(first,value(second,value(third,value(fourth,value(fifth,nil))))),"");
  }
  if fifth != "" { tool_fail("dragnet source: invalid public feed inputs"); }
  return invoke_values(name,mode,value(first,value(second,value(third,nil))),fourth);
}
