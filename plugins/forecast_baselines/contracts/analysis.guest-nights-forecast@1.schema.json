{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis-only guest-night forecast, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "version", "unit", "currency", "pricing_input", "model",
    "code_digest", "policy_digest", "training", "issued_at", "training_cutoff",
    "target_month", "horizon_months", "state", "reason", "estimate", "uncertainty"
  ],
  "properties": {
    "kind": {"const": "analysis.guest-nights-forecast"},
    "version": {"const": 1},
    "unit": {"const": "guest_nights"},
    "currency": {"type": "null"},
    "pricing_input": {"const": false},
    "model": {"enum": ["forecast.moving-average-3@1", "forecast.seasonal-naive-12@1"]},
    "code_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "training": {"$ref": "#/$defs/digest"},
    "issued_at": {"$ref": "#/$defs/utc"},
    "training_cutoff": {"$ref": "#/$defs/utc"},
    "target_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "horizon_months": {"const": 1},
    "state": {"enum": ["available", "unknown"]},
    "reason": {"enum": [null, "insufficient_evidence"]},
    "estimate": {"type": ["null", "object"]},
    "uncertainty": {"const": "unavailable"}
  },
  "oneOf": [
    {
      "properties": {
        "state": {"const": "available"},
        "reason": {"type": "null"},
        "estimate": {"$ref": "#/$defs/rational"}
      }
    },
    {
      "properties": {
        "state": {"const": "unknown"},
        "reason": {"const": "insufficient_evidence"},
        "estimate": {"type": "null"}
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0, "maximum": 2999999999997},
        "denominator": {"enum": [1, 3]}
      }
    }
  }
}
