{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpred.dev/contracts/analysis.guest-nights-vintage-request@1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "issued_at", "target_month", "horizon_months"],
  "properties": {
    "kind": {"const": "analysis.guest-nights-vintage-request"},
    "version": {"const": 1},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "target_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "horizon_months": {"type": "integer", "minimum": 1, "maximum": 11}
  }
}
