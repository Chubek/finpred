{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpred.dev/contracts/analysis.guest-nights-vintage-forecast@1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "unit", "currency", "pricing_input", "model", "model_code_digest", "model_policy_digest", "vintage_policy_digest", "request", "issued_at", "training_cutoff", "target_month", "horizon_months", "training", "state", "reason", "estimate", "uncertainty"],
  "properties": {
    "kind": {"const": "analysis.guest-nights-vintage-forecast"},
    "version": {"const": 1},
    "unit": {"const": "guest_nights"},
    "currency": {"const": null},
    "pricing_input": {"const": false},
    "model": {"$ref": "#/$defs/model"},
    "model_code_digest": {"$ref": "#/$defs/digest"},
    "model_policy_digest": {"$ref": "#/$defs/digest"},
    "vintage_policy_digest": {"$ref": "#/$defs/digest"},
    "request": {"$ref": "#/$defs/digest"},
    "issued_at": {"$ref": "#/$defs/utc"},
    "training_cutoff": {"$ref": "#/$defs/utc"},
    "target_month": {"$ref": "#/$defs/month"},
    "horizon_months": {"type": "integer", "minimum": 1, "maximum": 11},
    "training": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/row"}},
    "state": {"enum": ["available", "unknown"]},
    "reason": {"enum": [null, "insufficient_evidence"]},
    "estimate": {},
    "uncertainty": {"const": "unavailable"}
  },
  "allOf": [
    {
      "if": {"properties": {"model": {"const": "forecast.vintage-moving-average-3@1"}}},
      "then": {"properties": {"training": {"minItems": 3}}},
      "else": {"properties": {"training": {"maxItems": 1}}}
    },
    {
      "if": {"properties": {"state": {"const": "available"}}},
      "then": {"properties": {"reason": {"const": null}, "estimate": {"$ref": "#/$defs/rational", "properties": {"numerator": {"minimum": 0}}}, "training": {"items": {"properties": {"state": {"const": "available"}}}}}},
      "else": {"properties": {"reason": {"const": "insufficient_evidence"}, "estimate": {"const": null}, "training": {"contains": {"properties": {"state": {"enum": ["unknown", "absent"]}}}}}}
    }
  ],
  "$defs": {
    "model": {"enum": ["forecast.vintage-moving-average-3@1", "forecast.vintage-seasonal-naive-12@1", "forecast.vintage-last-complete-month@1"]},
    "digest": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": -2999999999997, "maximum": 2999999999997},
        "denominator": {"enum": [1, 3]}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["period", "state", "nights", "provider_flag", "provider_updated_at", "source_as_of", "snapshot"],
      "properties": {
        "period": {"$ref": "#/$defs/month"},
        "state": {"enum": ["available", "unknown", "absent"]},
        "nights": {},
        "provider_flag": {"type": ["string", "null"], "pattern": "^[a-z ]{1,16}$"},
        "provider_updated_at": {},
        "source_as_of": {},
        "snapshot": {}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "available"}}},
          "then": {"properties": {"nights": {"type": "integer", "minimum": 0, "maximum": 999999999999}}},
          "else": {"properties": {"nights": {"const": null}}}
        },
        {
          "if": {"properties": {"state": {"const": "absent"}}},
          "then": {"properties": {"provider_flag": {"const": null}, "provider_updated_at": {"const": null}, "source_as_of": {"const": null}, "snapshot": {"const": null}}},
          "else": {
            "properties": {
              "provider_updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$"},
              "source_as_of": {"$ref": "#/$defs/utc"},
              "snapshot": {"$ref": "#/$defs/digest"}
            }
          }
        }
      ]
    }
  }
}
