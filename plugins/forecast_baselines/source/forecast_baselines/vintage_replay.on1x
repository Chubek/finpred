# Separate analysis archive family; does not reinterpret v1 point artifacts.
import core.date as Date;
import core.format as F;
import plugins.dragnet.guest_nights as Guest;
import forecast_baselines.model as Model;
import forecast_baselines.vintage as Vintage;
import sdk.callable as SDK;
import std.String as Str;
record Spec
{
  issued: sexpr, target: sexpr, month: i64, horizon: i64
}

record Linked
{
  model_code: sexpr, scoring_code: sexpr
}

record Selection
{
  model: sexpr, model_code: sexpr, scoring_code: sexpr, training_cutoff: sexpr, scoring_cutoff: sexpr
}

record Catalog
{
  id: sexpr, count: i64
}

record Artifact
{
  status: i64, id: sexpr, bytes: sexpr
}

record Archive
{
  forecast_id: sexpr, forecast: sexpr, evaluation_id: sexpr, evaluation: sexpr
}

record Issued
{
  artifact: Artifact, thirds: i64
}

fn moving() -> string
{
  return "forecast.vintage-moving-average-3@1";
}

fn seasonal() -> string
{
  return "forecast.vintage-seasonal-naive-12@1";
}

fn persistence() -> string
{
  return "forecast.vintage-last-complete-month@1";
}

fn model_policy(name: string) -> string
{
  let common = "guest-nights-vintage-forecast@1;utc-calendar;horizons-1-to-11;guest-nights-vintage@1;no-imputation;no-uncertainty;";
  if name == moving()
  {
    return text_concat(common,
      "mean-of-three-complete-months-before-issuance");
  }
  if name == seasonal()
  {
    return text_concat(common, "target-month-minus-twelve");
  }
  if name == persistence()
  {
    return text_concat(common, "last-complete-month-before-issuance");
  }
  return "";
}

fn scoring_policy() -> string
{
  return "guest-nights-vintage-evaluation@1;replay-forecast;guest-nights-vintage@1;independent-catalog;score-at-or-after-target-month-end;signed-estimate-minus-actual;missing-actual-before-insufficient-evidence";
}

fn reject(status: i64) -> Artifact
{
  return record < Artifact >
  {
    status: status, id: sx_nil(), bytes: sx_nil()
  };
}

fn artifact(bytes: string) -> Artifact
{
  let id = Model.digest(bytes);
  if ! Guest.digest(id)
  {
    return reject(1);
  }
  return record < Artifact >
  {
    status: 0, id: sx_string(id), bytes: sx_string(bytes)
  };
}

fn spec(bytes: string, cutoff: string) -> Spec
{
  let bad = record < Spec >
  {
    issued: sx_nil(), target: sx_nil(), month: - 1, horizon: 0
  };
  let prefix = "{\"kind\":\"analysis.guest-nights-vintage-request\",\"version\":1,\"issued_at\":\"";
  let(a, issued) = Guest.quoted(bytes, 0, prefix, 20);
  let(b, target) = Guest.quoted(bytes, a, ",\"target_month\":\"", 7);
  let(c,
    steps) = Guest.token(bytes,
    Guest.after(bytes,
    b,
    ",\"horizon_months\":"),
    125,
    2);
  let h = Guest.nat(steps, 2);
  if Guest.after(bytes,
    c,
    "}\n") != text_len(bytes) || h < 1 || h > 11 || ! Date.utc_timestamp(issued) || ! Date.utc_timestamp(cutoff) || Str.compare(cutoff,
    issued) > 0
  {
    return bad;
  }
  let m = Model.month(target);
  if m < 0 || Model.month(text_slice(issued, 0, 7)) + h != m
  {
    return bad;
  }
  return record < Spec >
  {
    issued: sx_string(issued), target: sx_string(target), month: m, horizon: h
  };
}

# Internally all values are in thirds of guest-nights. On the wire they are
# reduced exact rationals. The largest intermediate is 3 * 999999999999.
fn rational(thirds: i64) -> string
{
  var n = thirds;
  var d = "3";
  if thirds % 3 == 0
  {
    n = thirds / 3;
    d = "1";
  }
  let value = F.num(n);
  return "{\"numerator\":$value,\"denominator\":$d}";
}

fn rejected_issue(status: i64) -> Issued
{
  return record < Issued >
  {
    artifact: reject(status), thirds: - 1
  };
}

# Status for both operations: 1 invalid request/pins/time; 2 catalog/evidence;
# 3 ambiguous latest revision; 4 incorrect archived forecast; 5 bad evaluation.
fn issue_exact(linked: Linked,
  selection: Selection,
  training: Catalog,
  request: sexpr,
  training_at: fn(i64) -> Vintage.Entry) -> Issued
{
  if ! SDK.valid_digest(selection["model_code"]) || ! SDK.same(selection["model_code"],
    linked["model_code"]) || ! SDK.atom(request,
    160)
  {
    return rejected_issue(1);
  }
  let model = sx_text(selection["model"]);
  let policy = model_policy(model);
  let cutoff = sx_text(selection["training_cutoff"]);
  let req = spec(sx_text(request), cutoff);
  if policy == "" || req["month"] < 0
  {
    return rejected_issue(1);
  }
  let issued = sx_text(req["issued"]);
  let target = sx_text(req["target"]);
  let horizon = F.num(req["horizon"]);
  let issue_month = req["month"] - req["horizon"];
  var first = issue_month - 1;
  var second = - 1;
  var third = - 1;
  if model == seasonal()
  {
    first = req["month"] - 12;
  }
  if model == moving()
  {
    first = issue_month - 3;
    second = issue_month - 2;
    third = issue_month - 1;
  }
  let needed = record < Vintage.Window >
  {
    first: first, second: second, third: third
  };
  let resolved = Vintage.resolve(cutoff,
    needed,
    sx_text(training["id"]),
    training["count"],
    training_at);
  if resolved["status"] != 0
  {
    return rejected_issue(resolved["status"]);
  }
  let one = resolved["first"]["value"];
  let two = resolved["second"]["value"];
  let three = resolved["third"]["value"];
  var thirds = - 1;
  if model == moving()
  {
    if one >= 0 && two >= 0 && three >= 0
    {
      thirds = one + two + three;
    }
  }
  else
  {
    if one >= 0
    {
      thirds = one * 3;
    }
  }
  let code = sx_text(selection["model_code"]);
  let pin = Model.digest(policy);
  let vintage_policy = Model.digest(Vintage.policy());
  let request_id = Model.digest(sx_text(request));
  if ! Guest.digest(pin) || ! Guest.digest(vintage_policy) || ! Guest.digest(request_id)
  {
    return rejected_issue(1);
  }
  let out = buffer_new();
  buffer_append(out,
    "{\"kind\":\"analysis.guest-nights-vintage-forecast\",\"version\":1,\"unit\":\"guest_nights\",\"currency\":null,\"pricing_input\":false");
  buffer_append(out,
    ",\"model\":\"$model\",\"model_code_digest\":\"$code\",\"model_policy_digest\":\"$pin\",\"vintage_policy_digest\":\"$vintage_policy\",\"request\":\"$request_id\"");
  buffer_append(out,
    ",\"issued_at\":\"$issued\",\"training_cutoff\":\"$cutoff\",\"target_month\":\"$target\",\"horizon_months\":$horizon,\"training\":[");
  buffer_append(out, Vintage.row_json(resolved["first"]));
  if model == moving()
  {
    buffer_append(out, ",");
    buffer_append(out, Vintage.row_json(resolved["second"]));
    buffer_append(out, ",");
    buffer_append(out, Vintage.row_json(resolved["third"]));
  }
  buffer_append(out, "]");
  if thirds < 0
  {
    buffer_append(out,
      ",\"state\":\"unknown\",\"reason\":\"insufficient_evidence\",\"estimate\":null,\"uncertainty\":\"unavailable\"}\n");
  }
  else
  {
    let estimate = rational(thirds);
    buffer_append(out,
      ",\"state\":\"available\",\"reason\":null,\"estimate\":$estimate,\"uncertainty\":\"unavailable\"}\n");
  }
  return record < Issued >
  {
    artifact: artifact(buffer_text(out)), thirds: thirds
  };
}

fn issue(linked: Linked,
  selection: Selection,
  training: Catalog,
  request: sexpr,
  training_at: fn(i64) -> Vintage.Entry) -> Artifact
{
  let result = issue_exact(linked, selection, training, request, training_at);
  return result["artifact"];
}

fn evaluate(linked: Linked,
  selection: Selection,
  training: Catalog,
  actuals: Catalog,
  request: sexpr,
  archive: Archive,
  training_at: fn(i64) -> Vintage.Entry,
  actuals_at: fn(i64) -> Vintage.Entry) -> Artifact
{
  let score_at = sx_text(selection["scoring_cutoff"]);
  let cutoff = sx_text(selection["training_cutoff"]);
  if ! SDK.atom(request,
    160) || ! SDK.valid_digest(selection["scoring_code"]) || ! SDK.same(selection["scoring_code"],
    linked["scoring_code"]) || ! Date.utc_timestamp(score_at)
  {
    return reject(1);
  }
  let req = spec(sx_text(request), cutoff);
  if req["month"] < 0
  {
    return reject(1);
  }
  let issued = sx_text(req["issued"]);
  let target = sx_text(req["target"]);
  let successor = Guest.next_month(target);
  let target_end = "$successor-01T00:00:00Z";
  if ! Date.utc_timestamp(target_end) || Str.compare(score_at,
    issued) <= 0 || Str.compare(score_at,
    target_end) < 0
  {
    return reject(1);
  }
  let result = issue_exact(linked, selection, training, request, training_at);
  let forecast = result["artifact"];
  if forecast["status"] != 0
  {
    return forecast;
  }
  if ! SDK.same(forecast["id"],
    archive["forecast_id"]) || ! SDK.same(forecast["bytes"],
    archive["forecast"])
  {
    return reject(4);
  }
  let window = record < Vintage.Window >
  {
    first: req["month"], second: - 1, third: - 1
  };
  let resolved = Vintage.resolve(score_at,
    window,
    sx_text(actuals["id"]),
    actuals["count"],
    actuals_at);
  if resolved["status"] != 0
  {
    return reject(resolved["status"]);
  }
  let observation = Vintage.row_json(resolved["first"]);
  let actual = resolved["first"]["value"];
  let thirds = result["thirds"];
  let horizon = F.num(req["horizon"]);
  let model = sx_text(selection["model"]);
  let model_code = sx_text(selection["model_code"]);
  let model_pin = Model.digest(model_policy(model));
  let vintage_pin = Model.digest(Vintage.policy());
  let code = sx_text(selection["scoring_code"]);
  let pin = Model.digest(scoring_policy());
  let forecast_id = sx_text(forecast["id"]);
  let training_catalog = sx_text(training["id"]);
  let actuals_catalog = sx_text(actuals["id"]);
  if ! Guest.digest(model_pin) || ! Guest.digest(vintage_pin) || ! Guest.digest(pin)
  {
    return reject(1);
  }
  let out = buffer_new();
  buffer_append(out,
    "{\"kind\":\"analysis.guest-nights-vintage-evaluation\",\"version\":1,\"unit\":\"guest_nights\",\"currency\":null,\"pricing_input\":false");
  buffer_append(out,
    ",\"model\":\"$model\",\"model_code_digest\":\"$model_code\",\"model_policy_digest\":\"$model_pin\",\"vintage_policy_digest\":\"$vintage_pin\",\"scoring_code_digest\":\"$code\",\"scoring_policy_digest\":\"$pin\"");
  buffer_append(out,
    ",\"issued_at\":\"$issued\",\"training_cutoff\":\"$cutoff\",\"scoring_cutoff\":\"$score_at\",\"target_month\":\"$target\",\"horizon_months\":$horizon");
  buffer_append(out,
    ",\"forecast\":\"$forecast_id\",\"training_catalog\":\"$training_catalog\",\"actuals_catalog\":\"$actuals_catalog\",\"actual\":$observation");
  if thirds < 0 || actual < 0
  {
    var reason = "insufficient_evidence";
    if actual < 0
    {
      reason = "missing_actual";
    }
    buffer_append(out,
      ",\"state\":\"unknown\",\"reason\":\"$reason\",\"error\":null,\"absolute_error\":null}\n");
  }
  else
  {
    let signed = thirds - actual * 3;
    var magnitude = signed;
    if magnitude < 0
    {
      magnitude = 0 - magnitude;
    }
    let error = rational(signed);
    let absolute = rational(magnitude);
    buffer_append(out,
      ",\"state\":\"scored\",\"reason\":null,\"error\":$error,\"absolute_error\":$absolute}\n");
  }
  return artifact(buffer_text(out));
}

# Both archive IDs are supplied from trusted lookup, not recomputed from the
# untrusted candidate. The catalogs and pins are separate trusted inputs.
fn replay(linked: Linked,
  selection: Selection,
  training: Catalog,
  actuals: Catalog,
  request: sexpr,
  archive: Archive,
  training_at: fn(i64) -> Vintage.Entry,
  actuals_at: fn(i64) -> Vintage.Entry) -> Artifact
{
  let computed = evaluate(linked,
    selection,
    training,
    actuals,
    request,
    archive,
    training_at,
    actuals_at);
  if computed["status"] != 0
  {
    return computed;
  }
  if ! SDK.same(computed["id"],
    archive["evaluation_id"]) || ! SDK.same(computed["bytes"],
    archive["evaluation"])
  {
    return reject(5);
  }
  return computed;
}
