# Point-in-time resolver for a bounded, independently pinned Dragnet catalog.
import core.date as Date;
import core.format as F;
import plugins.dragnet.guest_nights as Guest;
import forecast_baselines.model as Model;
import sdk.callable as SDK;
import std.String as Str;

record Entry { parent:sexpr, snapshot:sexpr }
record Window { first:i64, second:i64, third:i64 }
record Row {
  month:i64, published:i64, value:i64, flag:sexpr, updated:sexpr,
  visible:sexpr, parent:sexpr, conflict:bool
}
record Resolved { status:i64, first:Row, second:Row, third:Row }

fn max_catalog() -> i64 { return 64; }
fn policy() -> string {
  return "guest-nights-vintage@1;verified-snapshot-catalog;source-as-of-lte-cutoff;latest-provider-instant-per-month;explicit-null-supersedes;absence-does-not;conflicting-latest-revisions-reject;equivalent-captures-earliest-source-as-of-then-digest";
}

fn empty(month:i64) -> Row {
  return record<Row>{month:month,published:-1,value:-1,flag:sx_nil(),updated:sx_nil(),
    visible:sx_nil(),parent:sx_nil(),conflict:false};
}
fn failure(status:i64) -> Resolved {
  return record<Resolved>{status:status,first:empty(-1),second:empty(-1),third:empty(-1)};
}
fn period(month:i64) -> string {
  let y = F.num(month / 12);
  var m = F.num(month % 12 + 1);
  if text_len(m) == 1 { m = "0$m"; }
  return "$y-$m";
}
fn row_json(row:Row) -> string {
  let month = period(row["month"]);
  if row["published"] < 0 {
    return "{\"period\":\"$month\",\"state\":\"absent\",\"nights\":null,\"provider_flag\":null,\"provider_updated_at\":null,\"source_as_of\":null,\"snapshot\":null}";
  }
  let updated = sx_text(row["updated"]);
  let visible = sx_text(row["visible"]);
  let snapshot = sx_text(row["parent"]);
  let flag = sx_text(row["flag"]);
  var state = "unknown";
  var value = "null";
  if row["value"] >= 0 { state = "available"; value = F.num(row["value"]); }
  return "{\"period\":\"$month\",\"state\":\"$state\",\"nights\":$value,\"provider_flag\":$flag,\"provider_updated_at\":\"$updated\",\"source_as_of\":\"$visible\",\"snapshot\":\"$snapshot\"}";
}

fn choose(old:Row, incoming:Row) -> Row {
  if old["month"] != incoming["month"] || old["published"] > incoming["published"] { return old; }
  if old["published"] < incoming["published"] { return incoming; }
  # Compare normalized provider time, not its spelling. If representations of
  # the same release disagree, neither capture's arrival order can settle it.
  let conflict = old["conflict"] || old["value"] != incoming["value"]
    || !SDK.same(old["flag"],incoming["flag"]);
  var selected = old;
  # Iteration is strictly by ascending digest; equal visibility keeps old.
  if Str.compare(sx_text(incoming["visible"]),sx_text(old["visible"])) < 0 { selected = incoming; }
  return record<Row>{month:selected["month"],published:selected["published"],value:selected["value"],
    flag:selected["flag"],updated:selected["updated"],visible:selected["visible"],
    parent:selected["parent"],conflict:conflict};
}

# Every entry is verified, including entries not yet visible at cutoff. The
# catalog commits to all members in strictly ascending digest order. The empty
# catalog is valid; its identity must also come from the host.
# Status: 1 invalid input/cutoff, 2 invalid evidence or catalog, 3 ambiguity.
fn resolve(cutoff:string, window:Window, expected:string, count:i64, entry_at:fn(i64) -> Entry) -> Resolved {
  if !Date.utc_timestamp(cutoff) || count < 0 || count > max_catalog() || !Guest.digest(expected)
  { return failure(1); }
  let catalog = buffer_new();
  buffer_append(catalog,"{\"kind\":\"analysis.guest-nights-vintage-catalog\",\"version\":1,\"snapshots\":[");
  var prev = "";
  var first = empty(window["first"]);
  var second = empty(window["second"]);
  var third = empty(window["third"]);
  for i in 0 .. count {
    let entry = entry_at(i);
    let parent = sx_text(entry["parent"]);
    if !SDK.atom(entry["snapshot"],Guest.max_bytes()) || !Guest.digest(parent)
      || Str.compare(prev,parent) >= 0 { return failure(2); }
    prev = parent;
    if i > 0 { buffer_append(catalog,","); }
    buffer_append(catalog,"\"$parent\"");
    # Validate at the clock's ceiling to distinguish invalid future entries
    # from valid future entries. That ceiling is never a visibility cutoff.
    let projection = Guest.project(sx_text(entry["snapshot"]),parent,"2399-12-31T23:59:59Z");
    if projection["status"] != 0 { return failure(2); }
    let bytes = sx_text(projection["bytes"]);
    # These fields are read only from the freshly returned canonical projection.
    let prefix = "{\"kind\":\"analysis.guest-nights-monthly\",\"version\":1,\"unit\":\"guest_nights\",\"currency\":null,\"pricing_input\":false,\"source_kind\":\"dragnet.eurostat-accommodation-nights@1\",\"source_series\":\"tour_occ_nim\",\"geography\":\"EU27_2020\",\"activity\":\"I551-I553\",\"residence\":\"TOTAL\"";
    let (a,state) = Guest.quoted(bytes,text_len(prefix),",\"state\":\"",9);
    let (b,raw_parent) = Guest.quoted(bytes,a,",\"parent\":\"",71);
    let (c,updated) = Guest.quoted(bytes,b,",\"provider_updated_at\":\"",24);
    let (d,observed) = Guest.quoted(bytes,c,",\"observed_at\":\"",20);
    let (e,received) = Guest.quoted(bytes,d,",\"received_at\":\"",20);
    let (f,ingested) = Guest.quoted(bytes,e,",\"ingested_at\":\"",20);
    let (g,visible) = Guest.quoted(bytes,f,",\"source_as_of\":\"",20);
    let (h,ceiling) = Guest.quoted(bytes,g,",\"cutoff\":\"",20);
    var at = Guest.after(bytes,h,",\"observations\":[");
    let published = Guest.provider_clock(updated);
    if Guest.after(bytes,0,prefix) < 0 || at < 0 || published < 0 || raw_parent != parent
    { return failure(2); }
    if Str.compare(visible,cutoff) <= 0 {
      var ended = false;
      for j in 0 .. 3 {
        let (k,month_name) = Guest.quoted(bytes,at,"{\"period\":\"",7);
        let (l,presence) = Guest.quoted(bytes,k,",\"state\":\"",9);
        let (m,value) = Guest.token(bytes,Guest.after(bytes,l,",\"nights\":"),44,12);
        let flag_at = Guest.after(bytes,m,",\"provider_flag\":");
        var n = Guest.after(bytes,flag_at,"null");
        if n < 0 {
          let (flag_end,flag) = Guest.quoted(bytes,flag_at,"\"",16);
          n = flag_end;
        }
        let month = Model.month(month_name);
        at = Guest.after(bytes,n,"}");
        if at < 0 || month < 0 { return failure(2); }
        let flag = text_slice(bytes,flag_at,n);
        let row = record<Row>{month:month,published:published,value:Guest.nat(value,12),
          flag:sx_string(flag),updated:sx_string(updated),visible:sx_string(visible),
          parent:entry["parent"],conflict:false};
        first = choose(first,row);
        second = choose(second,row);
        third = choose(third,row);
        if Guest.after(bytes,at,"]}\n") == text_len(bytes) { ended = true; break; }
        at = Guest.after(bytes,at,",");
      }
      if !ended { return failure(2); }
    }
  }
  buffer_append(catalog,"]}\n");
  if Model.digest(buffer_text(catalog)) != expected { return failure(2); }
  if first["conflict"] || second["conflict"] || third["conflict"] { return failure(3); }
  return record<Resolved>{status:0,first:first,second:second,third:third};
}
